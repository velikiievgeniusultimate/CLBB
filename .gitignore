# Public source allowlist. Personal game/account state is never tracked.
/*
!/.gitignore
!/.gitmodules
!/.cargo/
!/.github/
!/README.md
!/README.en.md
!/LICENSE
!/LICENSE_POLICY.md
!/LICENSES/
!/THIRD_PARTY_NOTICES.txt
!/CONTRIBUTING.md
!/sources.json
!/env.sh
!/run-mlbb.sh
!/install.sh
!/diagnose.sh
!/uninstall.sh
!/build-runtime.sh
!/build-arm-zlib.sh
!/prepare-runtime.py
!/prepare-native-plugins.py
!/prepare-system-fonts.py
!/fetch-packages.py
!/VERSION
!/distribution/
!/launcher/
!/mapper/
!/dns-adapter/
!/webkit-launch-adapter/
!/execution-core/
!/translator-rust/
!/tools/
!/legal/
!/vendor/
!/smoke/
!/patches/
!/src/
/src/*
!/src/atl
!/src/nb-qemu
!/src/art_standalone
!/src/bionic_translation
!/src/libglvnd
!/src/libopensles-standalone
!/src/wolfssl
!/src/zlib
**/target/
**/__pycache__/
**/*.pyc
**/build/
**/builddir/
**/node_modules/
**/*.so
**/*.so.*
**/*.jar
**/*.apk
**/*.class
/mapper/ui/preview/
/smoke/*artifacts/
/smoke/*output/
/smoke/classes/
/smoke/return-width/
/smoke/check-gl-capabilities
/smoke/check-rcu-loader
/smoke/check-proxy-resolver
/smoke/live-f11
/smoke/webkit-empty-post
/smoke/webkit-h5-fixture
/smoke/webkit-h5-fixture-xrw
/smoke/webkit-https
/smoke/webkit-local
/smoke/*captured*.json
/smoke/*result*.json
/smoke/*.gdb
/smoke/.*-send-once.guard
# Process-local captures and development output must stay private.
**/capture.jsonl
**/*.log
**/.env
**/.env.*

!/legal/**

# Private login-webpage experiments include downloaded proprietary H5 assets.
/smoke/*h5*

# Cargo vendor build/ directories contain required source files.
!/vendor/**

# Android font compatibility links generated in a development checkout.
/vendor/etc/
