diff --git a/libc/bionic/standalone_system_properties.c b/libc/bionic/standalone_system_properties.c
new file mode 100644
index 0000000..1c2dcad
--- /dev/null
+++ b/libc/bionic/standalone_system_properties.c
@@ -0,0 +1,23 @@
+/* Standalone native-bridge libc has no Android property area/service.
+ * Preserve the existing absent-property ABI, previously misplaced in liblog.
+ * This source is selected only by the standalone Makefile, not Android.bp. */
+#include <sys/system_properties.h>
+#include <stdio.h>
+
+int __system_property_get(const char* name, char* value) {
+    (void)name;
+    value[0] = '\0';
+    return 0;
+}
+
+const prop_info* __system_property_find(const char* name) {
+    fprintf(stderr, "[libnb-qemu property absent]: %s\n", name ? name : "");
+    return NULL;
+}
+
+int __system_property_read(const prop_info* info, char* name, char* value) {
+    (void)info;
+    if (name) name[0] = '\0';
+    if (value) value[0] = '\0';
+    return 0;
+}
diff --git a/libc/dns/net/clbb_dns.c b/libc/dns/net/clbb_dns.c
new file mode 100644
index 0000000..20b74cd
--- /dev/null
+++ b/libc/dns/net/clbb_dns.c
@@ -0,0 +1,178 @@
+/* Rootless standalone native bridge DNS. No Android daemon or guest/host
+ * allocator sharing. Wire ABI is mirrored from dns-adapter/include/clbb_dns.h. */
+#include "private/clbb_dns.h"
+#include "private/clbb_dns_wire.h"
+#include "resolv_netid.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if !defined(CLBB_NATIVE_BRIDGE_DNS) || !defined(__aarch64__)
+#error clbb_dns.c is only for the standalone AArch64 native bridge
+#endif
+
+_Static_assert(sizeof(clbb_dns_hints_v1) == 20, "DNS hints ABI");
+_Static_assert(sizeof(clbb_dns_record_v1) == 40, "DNS record ABI");
+_Static_assert(sizeof(clbb_dns_response_v1) == 3600, "DNS response ABI");
+
+int __clbb_dns_default_context(const struct android_net_context* context) {
+    return context->app_netid == NETID_UNSET && context->app_mark == MARK_UNSET &&
+        context->dns_netid == NETID_UNSET && context->dns_mark == MARK_UNSET &&
+        context->uid == NET_CONTEXT_INVALID_UID && context->flags == 0 &&
+        context->qhook == NULL;
+}
+
+static int resolve(const char* node, const char* service,
+                   const clbb_dns_hints_v1* hints, clbb_dns_response_v1* response) {
+    memset(response, 0, sizeof(*response));
+    register uintptr_t x0 __asm__("x0") = (uintptr_t)node;
+    register uintptr_t x1 __asm__("x1") = (uintptr_t)service;
+    register uintptr_t x2 __asm__("x2") = (uintptr_t)hints;
+    register uintptr_t x3 __asm__("x3") = (uintptr_t)response;
+    __asm__ volatile("svc #0x2800" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3) : "memory", "cc");
+    int result = (int)x0;
+    if (result != 0) {
+        if (result == EAI_SYSTEM) errno = response->system_errno;
+        return result > 0 && result < EAI_MAX ? result : EAI_FAIL;
+    }
+    if (response->version != CLBB_DNS_VERSION || response->count == 0 ||
+        response->count > CLBB_DNS_MAX_RECORDS ||
+        response->canonical_len >= CLBB_DNS_CANON_CAPACITY ||
+        response->canonical[response->canonical_len] != '\0') return EAI_FAIL;
+    for (uint32_t i = 0; i < response->count; ++i) {
+        const clbb_dns_record_v1* r = &response->records[i];
+        if ((r->family != 4 && r->family != 6) ||
+            (r->socktype != SOCK_STREAM && r->socktype != SOCK_DGRAM) ||
+            (r->protocol != IPPROTO_TCP && r->protocol != IPPROTO_UDP)) return EAI_FAIL;
+    }
+    return 0;
+}
+
+int __clbb_dns_getaddrinfo(const char* node, const char* service,
+                          const struct addrinfo* hints, struct addrinfo** result) {
+    *result = NULL;
+    clbb_dns_hints_v1 wire = { .version = CLBB_DNS_VERSION };
+    if (hints) {
+        switch (hints->ai_family) {
+            case AF_UNSPEC: break;
+            case AF_INET: wire.family = 4; break;
+            case AF_INET6: wire.family = 6; break;
+            default: return EAI_FAMILY;
+        }
+        wire.socktype = hints->ai_socktype;
+        wire.protocol = hints->ai_protocol;
+        if (hints->ai_flags & AI_PASSIVE) wire.flags |= CLBB_DNS_PASSIVE;
+        if (hints->ai_flags & AI_CANONNAME) wire.flags |= CLBB_DNS_CANONNAME;
+        if (hints->ai_flags & AI_NUMERICHOST) wire.flags |= CLBB_DNS_NUMERICHOST;
+        if (hints->ai_flags & AI_NUMERICSERV) wire.flags |= CLBB_DNS_NUMERICSERV;
+        if (hints->ai_flags & AI_ADDRCONFIG) wire.flags |= CLBB_DNS_ADDRCONFIG;
+        if (hints->ai_flags & AI_V4MAPPED) wire.flags |= CLBB_DNS_V4MAPPED;
+        if (hints->ai_flags & AI_ALL) wire.flags |= CLBB_DNS_ALL;
+    }
+    clbb_dns_response_v1 response;
+    int error = resolve(node, service, &wire, &response);
+    if (error) return error;
+    struct addrinfo** tail = result;
+    for (uint32_t i = 0; i < response.count; ++i) {
+        const clbb_dns_record_v1* record = &response.records[i];
+        struct addrinfo* ai = calloc(1, sizeof(*ai) + sizeof(struct sockaddr_storage));
+        if (!ai) { error = EAI_MEMORY; goto fail; }
+        *tail = ai;
+        tail = &ai->ai_next;
+        ai->ai_flags = hints ? hints->ai_flags : 0;
+        ai->ai_family = record->family == 4 ? AF_INET : AF_INET6;
+        ai->ai_socktype = record->socktype;
+        ai->ai_protocol = record->protocol;
+        ai->ai_addr = (struct sockaddr*)(ai + 1);
+        if (record->family == 4) {
+            struct sockaddr_in* sa = (struct sockaddr_in*)ai->ai_addr;
+            ai->ai_addrlen = sizeof(*sa);
+            sa->sin_family = AF_INET;
+            sa->sin_port = htons(record->port);
+            memcpy(&sa->sin_addr, record->address, 4);
+        } else {
+            struct sockaddr_in6* sa = (struct sockaddr_in6*)ai->ai_addr;
+            ai->ai_addrlen = sizeof(*sa);
+            sa->sin6_family = AF_INET6;
+            sa->sin6_port = htons(record->port);
+            sa->sin6_flowinfo = htonl(record->flowinfo);
+            sa->sin6_scope_id = record->scope_id;
+            memcpy(&sa->sin6_addr, record->address, 16);
+        }
+        if (i == 0 && response.canonical_len) {
+            ai->ai_canonname = malloc(response.canonical_len + 1);
+            if (!ai->ai_canonname) { error = EAI_MEMORY; goto fail; }
+            memcpy(ai->ai_canonname, response.canonical, response.canonical_len + 1);
+        }
+    }
+    return 0;
+fail:
+    freeaddrinfo(*result);
+    *result = NULL;
+    return error;
+}
+
+struct hostent* __clbb_dns_gethostbyname(const char* name, int af,
+    struct hostent* host, char* buffer, size_t size, int* host_error) {
+    memset(host, 0, sizeof(*host));
+    if (af != AF_INET && af != AF_INET6) {
+        errno = EAFNOSUPPORT; *host_error = NO_RECOVERY; return NULL;
+    }
+    clbb_dns_hints_v1 hints = {
+        CLBB_DNS_VERSION, CLBB_DNS_CANONNAME, af == AF_INET ? 4 : 6,
+        SOCK_STREAM, IPPROTO_TCP
+    };
+    clbb_dns_response_v1 response;
+    int error = name ? resolve(name, NULL, &hints, &response) : EAI_NONAME;
+    if (error) {
+        switch (error) {
+            case EAI_AGAIN: *host_error = TRY_AGAIN; break;
+            case EAI_NONAME: *host_error = HOST_NOT_FOUND; break;
+            case EAI_NODATA: *host_error = NO_DATA; break;
+            case EAI_MEMORY: errno = ENOMEM; *host_error = NETDB_INTERNAL; break;
+            case EAI_SYSTEM: *host_error = NETDB_INTERNAL; break;
+            default: *host_error = NO_RECOVERY; break;
+        }
+        return NULL;
+    }
+    const size_t addr_size = af == AF_INET ? 4 : 16;
+    for (uint32_t i = 0; i < response.count; ++i) {
+        if (response.records[i].family != hints.family) {
+            *host_error = NO_RECOVERY; return NULL;
+        }
+    }
+    const char* canonical = response.canonical_len ? (char*)response.canonical : name;
+    size_t name_size = strlen(canonical) + 1;
+    /* Pointer arrays and addresses start aligned even for an unaligned _r buffer.
+     * Bounds are checked before any buffer write; no partial hostent escapes. */
+    size_t padding = (-(uintptr_t)buffer) & (sizeof(char*) - 1);
+    size_t pointers_size = (response.count + 2) * sizeof(char*);
+    size_t addresses_size = response.count * addr_size;
+    if (padding > size || pointers_size > size - padding ||
+        addresses_size > size - padding - pointers_size ||
+        name_size > size - padding - pointers_size - addresses_size) {
+        errno = ENOSPC; /* Existing h_errno_to_result converts this to ERANGE. */
+        *host_error = NETDB_INTERNAL;
+        return NULL;
+    }
+    char** aliases = (char**)(buffer + padding);
+    char** addresses = aliases + 1;
+    char* data = (char*)addresses + (response.count + 1) * sizeof(char*);
+    aliases[0] = NULL;
+    for (uint32_t i = 0; i < response.count; ++i) {
+        addresses[i] = data;
+        memcpy(data, response.records[i].address, addr_size);
+        data += addr_size;
+    }
+    addresses[response.count] = NULL;
+    memcpy(data, canonical, name_size);
+    host->h_name = data;
+    host->h_aliases = aliases;
+    host->h_addrtype = af;
+    host->h_length = addr_size;
+    host->h_addr_list = addresses;
+    *host_error = NETDB_SUCCESS;
+    return host;
+}
