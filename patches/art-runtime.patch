+// A resource-only split remains in the class/resource path, but cannot produce
+// compiled code. HasOriginalDexFiles() also returns false on ZIP errors, so it
+// cannot distinguish this case. Use the existing ZIP reader conservatively:
+// only a successfully opened, fully iterated archive can skip dex2oat. Any root
+// classes*.dex (including malformed/non-sequential multidex) keeps the normal
+// compiler/error path. Do not cache by pathname: an APK can be replaced.
+static bool IsResourceOnlyArchive(const char* filename, int zip_fd) {
+  ZipArchiveHandle archive = nullptr;
+  int32_t result = zip_fd >= 0
+      ? OpenArchiveFd(zip_fd, filename, &archive, /*assume_ownership=*/ false)
+      : OpenArchive(filename, &archive);
+  if (result != 0) {
+    CloseArchive(archive);
+    return false;
+  }
+  void* cookie = nullptr;
+  result = StartIteration(archive, &cookie);
+  if (result != 0) {
+    CloseArchive(archive);
+    return false;
+  }
+  ZipEntry64 entry;
+  std::string_view name;
+  bool resource_only = true;
+  while ((result = Next(cookie, &entry, &name)) == 0) {
+    if (name.find('/') == std::string_view::npos &&
+        name.substr(0, 7) == "classes" &&
+        name.size() >= 11 && name.substr(name.size() - 4) == ".dex") {
+      resource_only = false;
+      break;
+    }
+  }
+  // Next returns -1 only at the normal end of iteration. All other errors
+  // preserve the existing compiler diagnostics instead of claiming "no dex".
+  resource_only = resource_only && result == -1;
+  EndIteration(cookie);
+  CloseArchive(archive);
+  return resource_only;
+}
