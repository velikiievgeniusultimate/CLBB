diff --git a/art/runtime/clbb_boot_park_trace.h b/art/runtime/clbb_boot_park_trace.h
new file mode 100644
index 00000000..49396312
--- /dev/null
+++ b/art/runtime/clbb_boot_park_trace.h
@@ -0,0 +1,37 @@
+#ifndef ART_RUNTIME_CLBB_BOOT_PARK_TRACE_H_
+#define ART_RUNTIME_CLBB_BOOT_PARK_TRACE_H_
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+namespace art {
+namespace clbb_boot_park_trace {
+// Diagnostic policy only; no ART objects, JNI calls, locks or wait operations.
+inline bool Enabled(const char* value) {
+  return value != nullptr && std::strcmp(value, "1") == 0;
+}
+inline bool LongRequest(bool is_absolute, int64_t time, int64_t realtime_ms) {
+  if (!is_absolute) {
+    return time == 0 || time >= INT64_C(1000000000);
+  }
+  // Absolute park time uses epoch milliseconds, not relative nanoseconds.
+  return realtime_ms >= 0 && time > realtime_ms && time - realtime_ms >= 1000;
+}
+inline bool TargetThread(const char* name) {
+  return name != nullptr && std::strcmp(name, "UnityMain") == 0;
+}
+inline uint32_t Reserve(std::atomic<uint32_t>& count) {
+  uint32_t current = count.load(std::memory_order_relaxed);
+  while (current < 8) {
+    if (count.compare_exchange_weak(current, current + 1,
+                                   std::memory_order_relaxed,
+                                   std::memory_order_relaxed)) {
+      return current + 1;
+    }
+  }
+  return 0;
+}
+}  // namespace clbb_boot_park_trace
+}  // namespace art
+#endif  // ART_RUNTIME_CLBB_BOOT_PARK_TRACE_H_
