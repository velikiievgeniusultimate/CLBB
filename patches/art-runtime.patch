+static uint64_t ClbbBootParkMonotonicNs() {
+  timespec now;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return 0;
+  }
+  return static_cast<uint64_t>(now.tv_sec) * UINT64_C(1000000000) + now.tv_nsec;
+}
+
+static uint32_t ClbbBootParkTraceStart(Thread* self, bool is_absolute, int64_t time)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  // Cached once, strict opt-in. Default OFF avoids clock/name/stack work.
+  static const bool enabled = clbb_boot_park_trace::Enabled(getenv("CLBB_BOOT_PARK_TRACE"));
+  if (!enabled) {
+    return 0;
+  }
+  const int saved_errno = errno;
+  int64_t realtime_ms = -1;
+  if (is_absolute) {
+    timespec now;
+    if (clock_gettime(CLOCK_REALTIME, &now) == 0) {
+      realtime_ms = static_cast<int64_t>(now.tv_sec) * 1000 + now.tv_nsec / 1000000;
+    }
+  }
+  if (!clbb_boot_park_trace::LongRequest(is_absolute, time, realtime_ms)) {
+    errno = saved_errno;
+    return 0;
+  }
+  // Use the same OS thread name as GDB. A Unity pthread may have changed its
+  // native name after JNI attachment without changing ART's managed name.
+  char name[16] = {};
+#if defined(__linux__)
+  if (pthread_getname_np(pthread_self(), name, sizeof(name)) != 0 ||
+      !clbb_boot_park_trace::TargetThread(name)) {
+#else
+  std::string managed_name;
+  self->GetThreadName(managed_name);
+  if (!clbb_boot_park_trace::TargetThread(managed_name.c_str())) {
+#endif
+    errno = saved_errno;
+    return 0;
+  }
+  static std::atomic<uint32_t> count{0};
+  const uint32_t sequence = clbb_boot_park_trace::Reserve(count);
+  if (sequence != 0) {
+    // Current thread is still Runnable with the shared mutator lock here.
+    // Existing DumpJavaStack saves/restores a pending Java exception. Disabling
+    // lock dumping avoids verifier/object rendering and prints method names,
+    // source locations only; no argument values or object contents are read.
+    std::ostringstream stack;
+    self->DumpJavaStack(stack, /* check_suspended= */ false, /* dump_locks= */ false);
+    LOG(INFO) << "[CLBB BOOT PARK] phase=enter sequence=" << sequence
+              << " tid=" << self->GetTid()
+              << " requested_time=" << time
+              << " is_absolute=" << is_absolute
+              << " time_unit=" << (is_absolute ? "epoch_ms" : "relative_ns")
+              << " monotonic_ns=" << ClbbBootParkMonotonicNs()
+              << "\n" << stack.str();
+  }
+  errno = saved_errno;
+  return sequence;
+}
+
+static void ClbbBootParkTraceFinish(Thread* self,
+                                    uint32_t sequence,
+                                    uint64_t start_ns,
+                                    bool timed_out) {
+  if (sequence == 0) {
+    return;
+  }
+  const int saved_errno = errno;
+  const uint64_t finish_ns = ClbbBootParkMonotonicNs();
+  LOG(INFO) << "[CLBB BOOT PARK] phase=exit sequence=" << sequence
+            << " tid=" << self->GetTid()
+            << " monotonic_ns=" << finish_ns
+            << " park_duration_ns=" << (finish_ns >= start_ns ? finish_ns - start_ns : 0)
+            << " timed_out=" << timed_out;
+  errno = saved_errno;
+}
