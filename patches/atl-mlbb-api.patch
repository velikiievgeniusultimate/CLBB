+gboolean atl_chat_begin(GtkWindow *owner, const ClbbChatTarget *target)
+{
+	GtkWidget *overlay = gtk_window_get_child(owner);
+	if (!GTK_IS_OVERLAY(overlay) || inline_chat(owner))
