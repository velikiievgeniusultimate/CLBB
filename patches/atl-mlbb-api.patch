+/* Crop the original game texture on the GPU. No screen capture, image
+ * matching, CPU texture download, second window, or retained game artwork. */
+void clbb_portrait_overlay_host(GtkWidget *widget, GtkSnapshot *snapshot) {
+    GtkRoot *root=gtk_widget_get_root(widget);
+    if(!root || !GTK_IS_WINDOW(root))return;
+    ClbbHost *h=g_object_get_data(G_OBJECT(root),"clbb-mapper-attached");
+    if(!h || h->closing || clbb_settings_is_visible(h->settings) || game_surface(GTK_WIDGET(root))!=widget)return;
+    SurfaceViewWidget *surface=SURFACE_VIEW_WIDGET(widget);
+    if(!surface->texture)return;
+    portrait_cache_update(h,GTK_NATIVE(root),surface);
+    const char *rows=h->read(h->runtime,"portrait.overlay");
+    double width=gtk_widget_get_width(widget),height=gtk_widget_get_height(widget);
+    for(int i=0;rows && *rows && i<5;i++) {
+        double sx,sy,sw,sh,dx,dy,dw,dh;int selected;
+        double *fields[]={&sx,&sy,&sw,&sh,&dx,&dy,&dw,&dh};
+        char *guid_end=NULL;guint64 guid=g_ascii_strtoull(rows,&guid_end,10);
+        const char *scan=guid_end;gboolean parsed=guid!=0 && guid_end!=rows;
+        for(unsigned int n=0;n<8;n++){
+            char *end=NULL;*fields[n]=g_ascii_strtod(scan,&end);
+            if(end==scan){parsed=FALSE;break;}scan=end;
+        }
+        if(!parsed || sscanf(scan,"%d",&selected)!=1)break;
+        GdkTexture *cached=NULL;
+        for(unsigned k=0;k<5;k++)if(h->portraits[k].guid==guid){cached=h->portraits[k].image;break;}
+        gboolean dest_valid=TRUE,source_valid=TRUE;
