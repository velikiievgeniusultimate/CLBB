diff --git a/src/api-impl/android/webkit/SslErrorHandler.java b/src/api-impl/android/webkit/SslErrorHandler.java
new file mode 100644
index 0000000..34e5aaa
--- /dev/null
+++ b/src/api-impl/android/webkit/SslErrorHandler.java
@@ -0,0 +1,31 @@
+package android.webkit;
+
+import android.os.Handler;
+import android.os.Looper;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** SSL error callback handle. TLS exceptions are not supported by this runtime. */
+public class SslErrorHandler extends Handler {
+	private final Runnable cancelAction;
+	private final AtomicBoolean resolved = new AtomicBoolean();
+
+	public SslErrorHandler() {
+		this(null);
+	}
+
+	/** Runtime hook for cancelling the underlying failed request. */
+	public SslErrorHandler(Runnable cancelAction) {
+		super(Looper.getMainLooper());
+		this.cancelAction = cancelAction;
+	}
+
+	/** Fail closed: this implementation never authorizes an invalid certificate. */
+	public void proceed() {
+		cancel();
+	}
+
+	public void cancel() {
+		if (resolved.compareAndSet(false, true) && cancelAction != null)
+			cancelAction.run();
+	}
+}
diff --git a/src/api-impl/android/widget/VideoView.java b/src/api-impl/android/widget/VideoView.java
new file mode 100644
index 0000000..36e61bd
--- /dev/null
+++ b/src/api-impl/android/widget/VideoView.java
@@ -0,0 +1,128 @@
+package android.widget;
+
+import android.content.Context;
+import android.media.MediaPlayer;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.AttributeSet;
+import android.view.SurfaceView;
+import java.util.Map;
+
+/**
+ * VideoView API compatibility while ATL has no VideoView playback backend.
+ * A source reports unsupported media asynchronously; it never reports a
+ * successful preparation, playback, or completion.
+ */
+public class VideoView extends SurfaceView implements MediaController.MediaPlayerControl {
+	private final Handler mainHandler = new Handler(Looper.getMainLooper());
+	private final Object requestLock = new Object();
+	private long sourceGeneration;
+	private Runnable pendingError;
+	private MediaPlayer.OnErrorListener errorListener;
+	private MediaPlayer.OnPreparedListener preparedListener;
+	private MediaPlayer.OnCompletionListener completionListener;
+	private MediaPlayer.OnInfoListener infoListener;
+
+	public VideoView(Context context) {
+		super(context);
+	}
+
+	public VideoView(Context context, AttributeSet attrs) {
+		super(context, attrs);
+	}
+
+	public VideoView(Context context, AttributeSet attrs, int defStyleAttr) {
+		super(context, attrs, defStyleAttr);
+	}
+
+	public VideoView(Context context, AttributeSet attrs, int defStyleAttr, int defStyleRes) {
+		super(context, attrs, defStyleAttr, defStyleRes);
+	}
+
+	public void setVideoPath(String path) {
+		setVideoURI(path == null ? null : Uri.parse(path));
+	}
+
+	public void setVideoURI(Uri uri) {
+		setVideoURI(uri, null);
+	}
+
+	public void setVideoURI(Uri uri, Map<String, String> headers) {
+		synchronized (requestLock) {
+			cancelPendingErrorLocked();
+			if (uri == null)
+				return;
+			final long generation = sourceGeneration;
+			pendingError = new Runnable() {
+				@Override
+				public void run() {
+					MediaPlayer.OnErrorListener listener;
+					synchronized (requestLock) {
+						if (generation != sourceGeneration || pendingError != this)
+							return;
+						pendingError = null;
+						listener = errorListener;
+					}
+					if (listener != null)
+						listener.onError(new MediaPlayer(), MediaPlayer.MEDIA_ERROR_UNKNOWN,
+						                 MediaPlayer.MEDIA_ERROR_UNSUPPORTED);
+				}
+			};
+			if (!mainHandler.post(pendingError))
+				pendingError = null;
+		}
+	}
+
+	private void cancelPendingErrorLocked() {
+		++sourceGeneration;
+		if (pendingError != null) {
+			mainHandler.removeCallbacks(pendingError);
+			pendingError = null;
+		}
+	}
+
+	public void setOnErrorListener(MediaPlayer.OnErrorListener listener) {
+		synchronized (requestLock) {
+			errorListener = listener;
+		}
+	}
+
+	public void setOnPreparedListener(MediaPlayer.OnPreparedListener listener) {
+		preparedListener = listener;
+	}
+
+	public void setOnCompletionListener(MediaPlayer.OnCompletionListener listener) {
+		completionListener = listener;
+	}
+
+	public void setOnInfoListener(MediaPlayer.OnInfoListener listener) {
+		infoListener = listener;
+	}
+
+	public void setMediaController(MediaController controller) {}
+
+	public void start() {}
+	public void pause() {}
+	public void seekTo(int milliseconds) {}
+	public boolean isPlaying() { return false; }
+	public int getDuration() { return -1; }
+	public int getCurrentPosition() { return 0; }
+	public int getBufferPercentage() { return 0; }
+	public boolean canPause() { return false; }
+	public boolean canSeekBackward() { return false; }
+	public boolean canSeekForward() { return false; }
+	public int getAudioSessionId() { return 0; }
+
+	public void stopPlayback() {
+		synchronized (requestLock) {
+			cancelPendingErrorLocked();
+		}
+	}
+
+	@Override
+	protected void onDetachedFromWindow() {
