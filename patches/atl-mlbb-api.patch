+static void boot_capture_texture(GdkTexture *texture, const char *directory, const char *name)
+{
+	char *path = g_build_filename(directory, name, NULL);
+	gboolean saved = gdk_texture_save_to_png(texture, path);
+	fprintf(stderr, "[ATL capture] texture=%p size=%dx%d saved=%d path=%s\n", texture,
+	        gdk_texture_get_width(texture), gdk_texture_get_height(texture), saved, path);
+	g_free(path);
+}
+
+static void boot_capture_paintable(GdkPaintable *paintable, int width, int height, GskRenderer *renderer,
+                                   const char *directory, const char *name)
+{
+	if (!paintable)
+		return;
+	if (GDK_IS_TEXTURE(paintable)) {
+		boot_capture_texture(GDK_TEXTURE(paintable), directory, name);
+		return;
+	}
+	if (!renderer || width <= 0 || height <= 0)
+		return;
+	GtkSnapshot *snapshot = gtk_snapshot_new();
+	gdk_paintable_snapshot(paintable, GDK_SNAPSHOT(snapshot), width, height);
+	GskRenderNode *node = gtk_snapshot_free_to_node(snapshot);
+	if (!node) {
+		fprintf(stderr, "[ATL capture] empty paintable=%s path=%s\n", G_OBJECT_TYPE_NAME(paintable), name);
+		return;
+	}
+	graphene_rect_t bounds = GRAPHENE_RECT_INIT(0, 0, width, height);
+	GdkTexture *texture = gsk_renderer_render_texture(renderer, node, &bounds);
+	if (texture) {
+		boot_capture_texture(texture, directory, name);
+		g_object_unref(texture);
+	}
+	gsk_render_node_unref(node);
+}
+
+static void boot_capture_child_node(GtkWidget *widget, GskRenderer *renderer, const char *directory, const char *name)
+{
+	GtkWidget *parent = gtk_widget_get_parent(widget);
+	if (!parent || GTK_IS_NATIVE(widget))
+		return;
+	GtkSnapshot *snapshot = gtk_snapshot_new();
+	/* Unlike WidgetPaintable, this preserves nodes of zero-size containers. */
+	gtk_widget_snapshot_child(parent, widget, snapshot);
+	GskRenderNode *node = gtk_snapshot_free_to_node(snapshot);
+	if (!node) {
+		fprintf(stderr, "[ATL capture node] name=%s widget=%p type=%s node=empty\n", name, widget, G_OBJECT_TYPE_NAME(widget));
+		return;
+	}
+	graphene_rect_t bounds;
+	gsk_render_node_get_bounds(node, &bounds);
+	fprintf(stderr, "[ATL capture node] name=%s widget=%p type=%s node-type=%d bounds=%g,%g %gx%g\n",
+	        name, widget, G_OBJECT_TYPE_NAME(widget), gsk_render_node_get_node_type(node),
+	        bounds.origin.x, bounds.origin.y, bounds.size.width, bounds.size.height);
+	char *filename = g_strdup_printf("%s.node", name);
+	char *path = g_build_filename(directory, filename, NULL);
+	GError *error = NULL;
+	if (!gsk_render_node_write_to_file(node, path, &error)) {
+		fprintf(stderr, "[ATL capture node] save failed path=%s error=%s\n", path, error ? error->message : "unknown");
+		g_clear_error(&error);
+	}
+	g_free(path);
+	g_free(filename);
+	if (renderer && bounds.size.width > 0 && bounds.size.height > 0) {
+		GdkTexture *texture = gsk_renderer_render_texture(renderer, node, &bounds);
+		if (texture) {
+			filename = g_strdup_printf("%s.png", name);
+			boot_capture_texture(texture, directory, filename);
+			g_free(filename);
+			g_object_unref(texture);
+		}
+	}
+	gsk_render_node_unref(node);
+}
+
+static void boot_capture_pictures(GtkWidget *widget, GskRenderer *renderer, const char *directory, unsigned int *index)
+{
+	if (GTK_IS_PICTURE(widget)) {
+		unsigned int number = (*index)++;
+		GdkPaintable *paintable = gtk_picture_get_paintable(GTK_PICTURE(widget));
+		GtkWidget *parent = gtk_widget_get_parent(widget);
+		fprintf(stderr, "[ATL capture picture] index=%u widget=%p paintable=%s intrinsic=%dx%d size=%dx%d opacity=%g parent-opacity=%g visible=%d child-visible=%d mapped=%d\n",
+		        number, widget, paintable ? G_OBJECT_TYPE_NAME(paintable) : "none",
+		        paintable ? gdk_paintable_get_intrinsic_width(paintable) : 0,
+		        paintable ? gdk_paintable_get_intrinsic_height(paintable) : 0,
+		        gtk_widget_get_width(widget), gtk_widget_get_height(widget), gtk_widget_get_opacity(widget),
+		        parent ? gtk_widget_get_opacity(parent) : 1.0, gtk_widget_get_visible(widget),
+		        gtk_widget_get_child_visible(widget), gtk_widget_get_mapped(widget));
+		char *name = g_strdup_printf("atl-picture-%u.png", number);
+		boot_capture_paintable(paintable, gtk_widget_get_width(widget), gtk_widget_get_height(widget), renderer, directory, name);
+		g_free(name);
+		/* A picture with no paintable can still have an opaque CSS background. */
+		name = g_strdup_printf("atl-picture-%u-widget", number);
+		boot_capture_child_node(widget, renderer, directory, name);
+		g_free(name);
+	}
+	for (GtkWidget *child = gtk_widget_get_first_child(widget); child; child = gtk_widget_get_next_sibling(child))
+		boot_capture_pictures(child, renderer, directory, index);
+}
+
+static void boot_capture_widgets(GtkWidget *surface, const char *directory)
+{
+	GtkNative *native = gtk_widget_get_native(surface);
+	GtkRoot *root = gtk_widget_get_root(surface);
+	if (!native || !root)
+		return;
+	GskRenderer *renderer = gtk_native_get_renderer(native);
+	unsigned int ancestor_index = 0;
+	for (GtkWidget *widget = surface; widget; widget = gtk_widget_get_parent(widget)) {
+		graphene_point_t origin = GRAPHENE_POINT_INIT(0, 0), position = GRAPHENE_POINT_INIT(0, 0);
+		gboolean positioned = gtk_widget_compute_point(widget, GTK_WIDGET(root), &origin, &position);
+		fprintf(stderr, "[ATL capture geometry] widget=%p type=%s name=%s root-position=%g,%g valid=%d size=%dx%d overflow=%d stack-transition=%d\n",
+		        widget, G_OBJECT_TYPE_NAME(widget), gtk_widget_get_name(widget), position.x, position.y, positioned,
+		        gtk_widget_get_width(widget), gtk_widget_get_height(widget), gtk_widget_get_overflow(widget),
+		        GTK_IS_STACK(widget) ? gtk_stack_get_transition_running(GTK_STACK(widget)) : 0);
+		char *name = g_strdup_printf("atl-ancestor-%02u-%s", ancestor_index++, G_OBJECT_TYPE_NAME(widget));
+		boot_capture_child_node(widget, renderer, directory, name);
+		g_free(name);
+	}
+	unsigned int picture_index = 0;
+	boot_capture_pictures(GTK_WIDGET(root), renderer, directory, &picture_index);
+	/* Widget paintables expose the most recently completed GTK frame. */
+	GdkPaintable *paintable = gtk_widget_paintable_new(surface);
+	boot_capture_paintable(paintable, gtk_widget_get_width(surface), gtk_widget_get_height(surface), renderer, directory, "atl-surface-widget.png");
+	g_object_unref(paintable);
+	paintable = gtk_widget_paintable_new(GTK_WIDGET(root));
+	boot_capture_paintable(paintable, gtk_widget_get_width(GTK_WIDGET(root)), gtk_widget_get_height(GTK_WIDGET(root)), renderer, directory, "atl-root-widget.png");
+	g_object_unref(paintable);
 }
 
