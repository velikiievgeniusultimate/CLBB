+/* Hot reload is GTK-thread serialized. Retired libraries stay mapped: render,
+ * audio and TLS callbacks may still be returning through the previous image.
+ * Only opaque Runtime pointers cross this ABI; no Rust allocation is migrated. */
+#define CLBB_LIVE_ABI UINT64_C(0x434c424200010040)
+struct ClbbLiveModule {
+    ClbbHost *host;
+    void *library,*runtime;
+    void *(*create)(int (*)(void *,int,int,double,double),void *);
+    void (*destroy)(void *);void (*poll)(void *,double,double);
+    int (*event)(void *,int,int,int,int,double,double);
+    const char *(*read)(void *,const char *);
+    int (*write)(void *,const char *,const char *);
+    void (*suspend)(void *,int);int (*configure_pacing)(unsigned int,int);
+    int (*state)(const void *,ClbbReloadState *);
+    gboolean active,touch_attempted;
+    char *path,*sha;
+};
+static int live_touch(void *user,int edge,int finger,double x,double y) {
+    ClbbLiveModule *m=user;
+    if(!m->active){m->touch_attempted=TRUE;return 0;}
+    return touch(m->host,edge,finger,x,y);
+}
+static gboolean live_state(ClbbHost *h,ClbbReloadState *state) {
+    memset(state,0,sizeof(*state));
+    return h->reload_state && h->reload_state(h->runtime,state)==1 && state->abi==1 && state->size==64;
+}
+static gboolean live_quiet(ClbbHost *h,ClbbReloadState *state) {
+    return !h->closing && !h->dispatching && !h->raw_tap && !h->raw_timer &&
+        h->agent_until<=g_get_monotonic_time() && !g_hash_table_size(h->keys) && !g_hash_table_size(h->claimed) &&
+        !clbb_settings_is_capturing(h->settings) && !clbb_view_has_active_contacts() &&
+        live_state(h,state) && state->idle && !state->recording && (!state->hero || state->fresh);
+}
+static void live_route_callbacks(void *library) {
+#define ROUTE(field,type,symbol) atomic_store_explicit(&field,(type)dlsym(library,symbol),memory_order_release)
+    ROUTE(master_gain,ClbbGain,"clbb_audio_gain");ROUTE(game_gain,ClbbGain,"clbb_audio_game_gain");ROUTE(voice_gain,ClbbGain,"clbb_audio_voice_gain");
+    ROUTE(frame_wait,ClbbFrameWait,"clbb_frame_pacer_wait");ROUTE(frame_configuration,ClbbFrameConfiguration,"clbb_frame_pacer_configuration");
+    ROUTE(render_event,ClbbRenderEvent,"clbb_render_frame_event");
+    ROUTE(debug_enabled,ClbbDebugEnabled,"clbb_debug_recording");ROUTE(debug_motion,ClbbDebugMotion,"clbb_debug_motion");
+    ROUTE(debug_host_event,ClbbDebugHostEvent,"clbb_debug_host_event");ROUTE(debug_transport,ClbbDebugTransport,"clbb_debug_transport_status");
+#undef ROUTE
+}
+static void live_reject(ClbbHost *h,const char *reason) {
+    g_free(h->reload_status);h->reload_status=g_strdup(reason);
+    ClbbLiveModule *m=h->pending_module;h->pending_module=NULL;
+    if(m){if(m->runtime)m->destroy(m->runtime);m->runtime=NULL;g_ptr_array_add(h->retired_modules,m);}
+    fprintf(stderr,"[CLBB live mapper] rejected: %s\n",reason);
+}
+static gboolean live_same_match(const ClbbReloadState *a,const ClbbReloadState *b) {
+    if(!a->hero)return !b->hero;
+    return a->fresh && b->fresh && a->hero==b->hero && !memcmp(a->owners,b->owners,sizeof(a->owners));
+}
+static char *live_request(ClbbHost *h,const char *path,const char *expected_sha) {
+    ClbbReloadState before;
+    if(h->pending_module)return g_strdup("REJECTED reload already pending");
+    if(!live_quiet(h,&before))return g_strdup("REJECTED reload busy, recording, unsupported ABI or stale source");
+    if(!g_path_is_absolute(path)||strlen(expected_sha)!=64)return g_strdup("REJECTED reload path/hash");
+    for(unsigned n=0;n<64;n++)if(!g_ascii_isxdigit(expected_sha[n])||g_ascii_isupper(expected_sha[n]))return g_strdup("REJECTED reload hash");
+    struct stat st;
+    if(lstat(path,&st)||!S_ISREG(st.st_mode)||st.st_uid!=getuid()||(st.st_mode&022)||st.st_size<64||st.st_size>67108864)
+        return g_strdup("REJECTED reload file ownership/type/size");
+    gchar *bytes=NULL;gsize length=0;
+    if(!g_file_get_contents(path,&bytes,&length,NULL))return g_strdup("REJECTED reload unreadable");
+    char *actual=g_compute_checksum_for_data(G_CHECKSUM_SHA256,(guchar*)bytes,length);g_free(bytes);
+    if(strcmp(actual,expected_sha)){g_free(actual);return g_strdup("REJECTED reload checksum mismatch");}
+    if(h->live_sha && !strcmp(actual,h->live_sha)){g_free(actual);return g_strdup("OK reload unchanged");}
+    void *library=dlopen(path,RTLD_NOW|RTLD_LOCAL|RTLD_DEEPBIND|RTLD_NODELETE);
+    if(!library){g_free(actual);return g_strdup("REJECTED reload invalid library");}
+    uint64_t (*abi)(void)=dlsym(library,"clbb_mapper_abi");
+    if(!abi||abi()!=CLBB_LIVE_ABI){g_free(actual);return g_strdup("REJECTED reload incompatible ABI");}
+    ClbbLiveModule *m=g_new0(ClbbLiveModule,1);m->host=h;m->library=library;m->path=g_strdup(path);m->sha=actual;
+#define LIVE_LOAD(field,symbol) do{*(void**)(&m->field)=dlsym(library,symbol);if(!m->field)goto missing;}while(0)
+    LIVE_LOAD(create,"clbb_mapper_create");LIVE_LOAD(destroy,"clbb_mapper_destroy");LIVE_LOAD(poll,"clbb_mapper_poll");
+    LIVE_LOAD(event,"clbb_mapper_event");LIVE_LOAD(read,"clbb_mapper_read");LIVE_LOAD(write,"clbb_mapper_write");
+    LIVE_LOAD(suspend,"clbb_mapper_suspend");LIVE_LOAD(configure_pacing,"clbb_frame_pacer_configure");LIVE_LOAD(state,"clbb_mapper_reload_state");
+#undef LIVE_LOAD
+    const char *callbacks[]={"clbb_audio_gain","clbb_audio_game_gain","clbb_audio_voice_gain","clbb_frame_pacer_wait","clbb_frame_pacer_configuration","clbb_render_frame_event","clbb_debug_recording","clbb_debug_motion","clbb_debug_host_event","clbb_debug_transport_status",NULL};
+    for(unsigned n=0;callbacks[n];n++)if(!dlsym(library,callbacks[n]))goto missing;
+    if(library!=h->boot_library){
+        int (*install)(const ClbbAudioServices*)=dlsym(library,"clbb_mapper_install_audio_services");
+        if(!install||!install(&h->audio_services))goto missing;
+    }
+    m->runtime=m->create(live_touch,m);if(!m->runtime)goto missing;
+    m->suspend(m->runtime,1);
+    h->pending_module=m;h->reload_expected=before;h->reload_deadline=g_get_monotonic_time()+5000000;
+    g_free(h->reload_status);h->reload_status=g_strdup("staging");
+    return g_strdup("OK reload staged");
+missing:
+    if(m->runtime)m->destroy(m->runtime);
+    m->runtime=NULL;g_ptr_array_add(h->retired_modules,m);
+    return g_strdup("REJECTED reload missing/incompatible exports");
+}
+static void live_tick(ClbbHost *h) {
+    ClbbLiveModule *m=h->pending_module;if(!m)return;
+    ClbbReloadState old,current={0};
+    if(!live_quiet(h,&old)||!live_same_match(&h->reload_expected,&old)){live_reject(h,"input or match changed during staging");return;}
+    GtkWidget *surface=game_surface(GTK_WIDGET(h->window));
+    m->poll(m->runtime,surface?gtk_widget_get_width(surface):0,surface?gtk_widget_get_height(surface):0);
+    if(m->touch_attempted){live_reject(h,"candidate attempted input during staging");return;}
+    if(!m->state(m->runtime,&current)||current.abi!=1||current.size!=64||!current.idle||current.recording){live_reject(h,"candidate not quiescent");return;}
+    if(!live_same_match(&old,&current)){
+        if(g_get_monotonic_time()>h->reload_deadline)live_reject(h,"candidate did not establish the same current match");
+        return;
+    }
+    void *old_runtime=h->runtime;void(*old_destroy)(void*)=h->destroy;
+    h->suspend(old_runtime,1);
+    ClbbLiveModule *previous=h->active_module;if(previous)previous->active=FALSE;
+    g_free(h->previous_path);g_free(h->previous_sha);h->previous_path=h->live_path;h->previous_sha=h->live_sha;
+    h->live_path=g_strdup(m->path);h->live_sha=g_strdup(m->sha);h->library=m->library;h->runtime=m->runtime;
+    h->create=m->create;h->destroy=m->destroy;h->poll=m->poll;h->event=m->event;h->read=m->read;h->write=m->write;
+    h->suspend=m->suspend;h->configure_pacing=m->configure_pacing;h->reload_state=m->state;
+    h->active_module=m;h->pending_module=NULL;m->active=TRUE;
+    live_route_callbacks(m->library);apply_frame_pacing(h);
+    h->suspend(h->runtime,0);
+    h->event(h->runtime,0,0,0,0,h->x,h->y);
+    h->suspend(h->runtime, !gtk_window_is_active(h->window) || clbb_settings_is_visible(h->settings) ||
+               atl_text_input_active(h->window));
+    old_destroy(old_runtime);
+    if(previous){previous->runtime=NULL;g_ptr_array_add(h->retired_modules,previous);}
+    h->reload_generation++;g_free(h->reload_status);h->reload_status=g_strdup("committed");
+    clbb_settings_refresh(h->settings);
+    fprintf(stderr,"[CLBB live mapper] generation=%u sha256=%s committed\n",h->reload_generation,h->live_sha);
+}
+static char *live_diagnostics(ClbbHost *h) {
+    /* Paths/status are not interpolated: fixed statuses and hashes make the
+     * private response valid JSON even when a developer's home has quotes. */
+    return g_strdup_printf("{\"schema\":1,\"supported\":%s,\"generation\":%u,\"pending\":%s,\"status\":\"%s\",\"committed\":%s,\"sha256\":\"%s\",\"previous_sha256\":\"%s\",\"retained_modules\":%u}",
+        h->reload_state?"true":"false",h->reload_generation,h->pending_module?"true":"false",h->reload_status?h->reload_status:"unsupported",
+        h->reload_status&&!strcmp(h->reload_status,"committed")?"true":"false",h->live_sha?h->live_sha:"",h->previous_sha?h->previous_sha:"",h->retired_modules?h->retired_modules->len:0);
+}
+
+static gboolean tick(gpointer data) {
+    ClbbHost *h = data;
+    if (h->closing)
+        return G_SOURCE_REMOVE;
+    if (h->dispatching)
+        return G_SOURCE_CONTINUE;
+    live_tick(h);
+    gint64 now=g_get_monotonic_time();
+    tick_quick_chat(h, now);
+    sync_chat_limit(h, now);
+    tick_chat_batch(h, now);
+    if (now >= h->account_refresh_at) {
+        h->account_refresh_at = now + 100000;
+        clbb_account_gate_refresh(h->account_gate);
+    }
+    if (now>=h->fps_refresh_at) {
+        h->fps_refresh_at=now+250000;
+        const char *enabled=h->read(h->runtime,"display.show_fps");
+        gboolean show=!strcmp(enabled,"true") || !strcmp(enabled,"1");
+        gboolean redraw=show || h->show_fps;
+        h->show_fps=show;
+        if(show)g_snprintf(h->fps_text,sizeof(h->fps_text),"FPS %s",h->read(h->runtime,"diagnostics.fps"));
+        if(redraw)gtk_widget_queue_draw(h->cursor_layer);
+    }
+    GtkWidget *surface = game_surface(GTK_WIDGET(h->window));
+    gboolean editing = refresh_text_input(h);
+    gboolean active = !editing && (gtk_window_is_active(h->window) ||
+                       h->agent_until > g_get_monotonic_time()) &&
+                      !clbb_settings_is_visible(h->settings);
+    if (h->agent_until && h->agent_until <= g_get_monotonic_time()) {
+        h->agent_until = 0;
+        gtk_widget_queue_draw(h->cursor_layer);
+    }
+    if (editing || !gtk_window_is_active(h->window) || clbb_settings_is_visible(h->settings))
+        unlock(h);
+    else if (h->locked)
+        refresh_confine(h);
+    h->dispatching = TRUE;
+    h->suspend(h->runtime, !active);
+    h->poll(h->runtime, surface ? gtk_widget_get_width(surface) : 0,
+            surface ? gtk_widget_get_height(surface) : 0);
+    h->dispatching = FALSE;
+    gboolean portrait_visible=!strcmp(h->read(h->runtime,"portrait.visible"),"true");
+    if(surface && (portrait_visible || h->portrait_visible))gtk_widget_queue_draw(surface);
+    h->portrait_visible=portrait_visible;
+    if (++h->ticks % 500 == 0 && gtk_widget_get_visible(clbb_settings_panel(h->settings)))
+        clbb_settings_refresh(h->settings);
+    return G_SOURCE_CONTINUE;
+}
+static void focus_changed(GObject *object, GParamSpec *spec, gpointer data) {
+    (void)spec;
+    ClbbHost *h = data;
+    record_host_event(0,gtk_window_is_active(GTK_WINDOW(object)),0,0);
+    if (!gtk_window_is_active(GTK_WINDOW(object))) {
+        atl_chat_cancel_batch(h->window);
+        unlock(h);
+        h->chat_open_edge = h->chat_send_edge = 0;
+        g_hash_table_remove_all(h->chat_keys);
+        g_hash_table_remove_all(h->keys);
+        g_hash_table_remove_all(h->claimed);
+        if (!h->dispatching && h->agent_until <= g_get_monotonic_time()) {
+            h->dispatching = TRUE;
+            h->suspend(h->runtime, 1);
+            if (!h->raw_tap) clbb_view_cancel_mouse(game_surface(GTK_WIDGET(h->window)),0);
+            h->dispatching = FALSE;
+        }
+    }
+}
+void clbb_mapper_unlink_control(GtkWindow *window) {
+    ClbbHost *h = g_object_get_data(G_OBJECT(window), "clbb-mapper-attached");
+    if (h && h->socket_path)
+        unlink(h->socket_path);
+}
