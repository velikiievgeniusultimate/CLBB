+static gboolean javascript_dialog(WebKitWebView *view, WebKitScriptDialog *dialog, WrapperWidget *wrapper)
+{
+	static const char prefix[] = "__ATL_JAVASCRIPT__";
+	const char *message = webkit_script_dialog_get_message(dialog);
+	if (webkit_script_dialog_get_dialog_type(dialog) != WEBKIT_SCRIPT_DIALOG_PROMPT ||
+	    !message || !g_str_has_prefix(message, prefix))
+		return FALSE;
+	webkit_script_dialog_ref(dialog);
+	g_object_ref(view);
+	JNIEnv *env = get_jni_env();
+	jstring response = NULL;
+	if (strlen(message) <= 1024 * 1024 && !(*env)->IsSameObject(env, wrapper->jobj, NULL)) {
+		jstring payload = java_string_from_utf8(env, message + sizeof(prefix) - 1);
+		if (payload) response = J__WebView__internalJavascriptCall(env, wrapper->jobj, payload);
+		(*env)->DeleteLocalRef(env, payload);
+	}
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionClear(env);
+	gchar *json = java_string_to_utf8(env, response);
+	webkit_script_dialog_prompt_set_text(dialog, json ? json : "{\"ok\":false}");
+	/* Synchronous completion: WebKit closes on its final unref after this
+	 * signal returns. Closing here clears currentScriptDialog while WebKit
+	 * still needs it for its post-signal unref (WebKitGTK 2.54). */
+	webkit_script_dialog_unref(dialog);
+	g_object_unref(view);
+	g_free(json);
+	(*env)->DeleteLocalRef(env, response);
+	return TRUE;
+}
