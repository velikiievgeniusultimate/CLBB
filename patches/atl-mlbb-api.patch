diff --git a/src/api-impl-jni/widgets/webview_session.c b/src/api-impl-jni/widgets/webview_session.c
new file mode 100644
index 0000000..a6156dd
--- /dev/null
+++ b/src/api-impl-jni/widgets/webview_session.c
@@ -0,0 +1,46 @@
+/* Linux/GTK adapter: keep website data inside the runtime's Android app storage. */
+#include "webview_session.h"
+#include <errno.h>
+#include <glib/gstdio.h>
+
+static GHashTable *sessions;
+
+static gboolean private_directory(const char *path, GError **error)
+{
+    if (g_mkdir_with_parents(path, 0700) || g_chmod(path, 0700)) {
+        g_set_error_literal(error, G_IO_ERROR, g_io_error_from_errno(errno),
+                            "Could not create private WebView storage");
+        return FALSE;
+    }
+    return TRUE;
+}
+
+WebKitNetworkSession *atl_webview_session_for_app(const char *app_directory, GError **error)
+{
+    if (!app_directory || !g_path_is_absolute(app_directory)) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                            "WebView requires an absolute Android app data directory");
+        return NULL;
+    }
+    char *canonical = g_canonicalize_filename(app_directory, NULL);
+    if (!sessions) sessions = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_object_unref);
+    WebKitNetworkSession *session = g_hash_table_lookup(sessions, canonical);
+    if (session) { g_free(canonical); return session; }
+
+    char *base = g_build_filename(canonical, "app_webview", NULL);
+    char *data = g_build_filename(base, "data", NULL);
+    char *cache = g_build_filename(base, "cache", NULL);
+    if (!private_directory(base, error) || !private_directory(data, error) ||
+        !private_directory(cache, error)) {
+        g_free(canonical); g_free(base); g_free(data); g_free(cache);
+        return NULL;
+    }
+    session = webkit_network_session_new(data, cache);
+    /* Use only this app's own engine-created cookies, never another browser's jar. */
+    char *cookies = g_build_filename(data, "cookies.sqlite", NULL);
+    webkit_cookie_manager_set_persistent_storage(webkit_network_session_get_cookie_manager(session),
+        cookies, WEBKIT_COOKIE_PERSISTENT_STORAGE_SQLITE);
+    g_hash_table_insert(sessions, canonical, session);
+    g_free(cookies); g_free(base); g_free(data); g_free(cache);
+    return session;
+}
