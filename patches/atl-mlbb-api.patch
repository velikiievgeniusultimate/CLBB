+
+/* Physical window coordinates after the logical Android viewport transform. */
+static gboolean fence_geometry(ClbbHost *h, GdkRectangle *rect,
+                                Window *xid, Display **display) {
+    GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(h->window));
+    if (!GDK_IS_X11_SURFACE(surface))
+        return FALSE;
+    if (!clbb_viewport_get_surface_content_rect(h->viewport,rect))
+        return FALSE;
+    if (rect->width < 32 || rect->height < 32)
+        return FALSE;
+    *xid = gdk_x11_surface_get_xid(surface);
+    *display = gdk_x11_display_get_xdisplay(gdk_surface_get_display(surface));
+    return TRUE;
+}
+static void unlock(ClbbHost *h) {
+    gboolean changed = h->locked || h->fence;
+    if(changed)record_host_event(3,0,0,0);
+    if (h->display) clbb_pointer_fence_clear(h->display, &h->pointer_fence);
+    if (h->locked) {
+        XUngrabPointer(h->display, CurrentTime);
+        h->locked = FALSE;
+    }
+    if (h->fence) {
+        XDestroyWindow(h->display, h->fence);
+        h->fence = 0;
+    }
+    h->fence_parent = 0;
+    h->fence_rect = (GdkRectangle){0};
+    if (changed)
+        XFlush(h->display);
+}
+static void refresh_confine(ClbbHost *h) {
+    if (!h->locked)
+        return;
+    GdkRectangle rect;
+    Window xid;
+    Display *display;
+    if (!h->fence || !fence_geometry(h, &rect, &xid, &display) ||
+        xid != h->fence_parent || display != h->display) {
+        unlock(h);
+        return;
+    }
+    /* GTK may replace/release its pointer grab after a mouse click. Root
+     * barriers keep the game bounds independent of that grab lifecycle. */
+    gint64 now=g_get_monotonic_time();
+    if(now>=h->fence_refresh_at || !gdk_rectangle_equal(&rect,&h->fence_rect)) {
+        clbb_pointer_fence_update(display,xid,rect.x,rect.y,rect.width,rect.height,&h->pointer_fence);
+        h->fence_refresh_at=now+20000;
+    }
+    if (!gdk_rectangle_equal(&rect, &h->fence_rect)) {
+        XMoveResizeWindow(display, h->fence, rect.x, rect.y,
+                           rect.width, rect.height);
+        h->fence_rect = rect;
+        XFlush(display);
+    }
+}
+static void confine(ClbbHost *h) {
+    if (!gtk_window_is_active(h->window) || clbb_settings_is_visible(h->settings)) return;
+    if (h->locked) {
+        unlock(h);
+        return;
+    }
+    GdkRectangle rect;
+    Window xid;
+    Display *display;
+    if (!fence_geometry(h, &rect, &xid, &display))
+        return;
+    Window root, child;
+    int rx, ry, px, py;
+    unsigned mask;
+    GdkSurface *surface=gtk_native_get_surface(GTK_NATIVE(h->window));
+    int scale=gdk_surface_get_scale_factor(surface);
+    if (!XQueryPointer(display, xid, &root, &child, &rx, &ry, &px, &py, &mask) ||
+        px < 0 || py < 0 || px >= gdk_surface_get_width(surface)*scale ||
+        py >= gdk_surface_get_height(surface)*scale)
+        return;
+    // Explicit F12 in a letterbox/header still activates confinement. X11
+    // brings the pointer into the game rectangle as part of this grab.
+    h->display = display;
+    h->fence_parent = xid;
+    h->fence_rect = rect;
+    XSetWindowAttributes attrs = {.override_redirect = True, .event_mask = 0};
+    h->fence =
+        XCreateWindow(display, xid, rect.x, rect.y, rect.width, rect.height,
+                      0, 0, InputOnly, CopyFromParent,
+                      CWOverrideRedirect | CWEventMask, &attrs);
+    XMapWindow(display, h->fence);
+    int result =
+        XGrabPointer(display, xid, True,
+                     ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
+                     GrabModeAsync, GrabModeAsync, h->fence, None, CurrentTime);
+    if (result == GrabSuccess) {
+        h->locked = TRUE;
+        clbb_pointer_fence_update(display,xid,rect.x,rect.y,rect.width,rect.height,&h->pointer_fence);
+        record_host_event(3,1,0,0);
+    } else {
+        unlock(h);
+    }
+    XFlush(display);
+}
+static void visibility(void *user, gboolean visible) {
+    record_host_event(1,visible,0,0);
+    ClbbHost *h = user;
+    unlock(h);
+    if (!h->dispatching) {
+        h->dispatching = TRUE;
+        h->suspend(h->runtime, visible || !gtk_window_is_active(h->window));
+        if (visible && !h->raw_tap) clbb_view_cancel_mouse(game_surface(GTK_WIDGET(h->window)),0);
+        h->dispatching = FALSE;
+    }
+}
+static gboolean shortcut(ClbbHost *h, int key, gboolean down, gboolean repeat) {
+    int settings = setting_int(h, "hotkeys.settings"),
+        lock = setting_int(h, "hotkeys.confine"),
+        full = setting_int(h, "hotkeys.fullscreen");
+    int editor = setting_int(h,"hotkeys.editor");
+    if (!key || (key != settings && key != lock && key != full && key != editor))
+        return FALSE;
+    if (down && !repeat) {
+        if (key == editor)
+            clbb_settings_show_editor(h->settings);
+        else if (key == settings)
+            clbb_settings_show(h->settings);
+        else if (key == lock)
+            confine(h);
+        else {
+            unlock(h);
+            gboolean full_screen = !gtk_window_is_fullscreen(h->window);
+            g_object_set_data(G_OBJECT(h->window), "atl-user-fullscreen-choice",
+                              GINT_TO_POINTER(full_screen ? 2 : 1));
+            if (full_screen) {
+                h->windowed_width = gtk_widget_get_width(GTK_WIDGET(h->window));
+                h->windowed_height = gtk_widget_get_height(GTK_WIDGET(h->window));
+                gtk_window_fullscreen(h->window);
+            } else {
+                gtk_window_unfullscreen(h->window);
+                if (h->windowed_width > 0 && h->windowed_height > 0)
+                    gtk_window_set_default_size(h->window, h->windowed_width,
+                                                h->windowed_height);
+            }
+        }
+    }
+    return TRUE;
+}
+static gboolean refresh_text_input(ClbbHost *h) {
+    gboolean active = atl_text_input_active(h->window);
+    if (active != h->text_input) {
+        h->text_input = active;
+        if (active && atl_chat_active(h->window)) {
+            GHashTableIter iter;
+            gpointer key;
+            g_hash_table_iter_init(&iter, h->keys);
+            while (g_hash_table_iter_next(&iter, &key, NULL))
+                g_hash_table_insert(h->chat_keys, key, GINT_TO_POINTER(1));
+        }
+        g_hash_table_remove_all(h->keys);
+        g_hash_table_remove_all(h->claimed);
+        if (active) {
+            unlock(h);
+            h->agent_until = 0;
+            h->dispatching = TRUE;
+            h->suspend(h->runtime, 1);
+            h->dispatching = FALSE;
+        }
+    }
+    return active;
+}
+
+static gboolean tap_game_control(void *data, double x, double y);
+
+static gboolean read_chat_target(ClbbHost *h, ClbbChatTarget *target) {
+    const char *s = h->read(h->runtime, "chat.target");
+    target->limit = CLBB_CHAT_DEFAULT_LIMIT; /* Compatibility with older reloadable mappers. */
+    target->ready = 0;
+    return s && sscanf(s, "%" G_GUINT64_FORMAT " %u %d %u %u %u %d %u",
+            &target->owner, &target->site, &target->channel, &target->editing,
+            &target->x, &target->y, &target->limit, &target->ready) >= 6 &&
+        target->limit > 0 && target->limit <= 4096 &&
+        target->owner && (target->site == 1 || target->site == 2) &&
+        target->editing <= 1 && target->x > 0 && target->x < 1000000 &&
+        target->y > 0 && target->y < 1000000;
+}
+
+gboolean clbb_chat_site(GtkWindow *window, ClbbChatTarget *target, gboolean live) {
+    ClbbHost *h = g_object_get_data(G_OBJECT(window), "clbb-mapper-attached");
+    if (!h || h->closing || h->dispatching || clbb_settings_is_visible(h->settings))
+        return FALSE;
+    if (!live && h->chat_deadline && h->chat_field_clicked && atl_chat_waiting(window)) {
+        *target = h->quick_chat;
+        return TRUE;
+    }
+    return read_chat_target(h, target) && target->editing;
+}
+
+static gboolean click_chat_target(ClbbHost *h, const ClbbChatTarget *target) {
+    return tap_game_control(h, target->x / 1000000., target->y / 1000000.);
+}
+
+static void open_chat_field(ClbbHost *h, const ClbbChatTarget *target) {
+    h->quick_chat = *target;
+    h->chat_deadline = g_get_monotonic_time() + 1600000;
+    h->chat_check_at = 0;
+    h->chat_field_clicked = target->editing;
+    refresh_text_input(h);
+    if (!click_chat_target(h, target)) {
+        atl_chat_abort_pending(h->window);
+        h->chat_deadline = 0;
+    }
+}
+
+static void tick_quick_chat(ClbbHost *h, gint64 now) {
+    if (!h->chat_deadline || now < h->chat_check_at)
+        return;
+    h->chat_check_at = now + 12000;
+    if (!atl_chat_waiting(h->window)) {
+        h->chat_deadline = 0;
+        return;
+    }
+    if (now >= h->chat_deadline) {
+        atl_chat_abort_pending(h->window);
+        h->chat_deadline = 0;
+        return;
+    }
+    if (h->chat_field_clicked || h->raw_tap)
+        return;
+    ClbbChatTarget target;
+    if (read_chat_target(h, &target) && target.editing &&
+        target.owner == h->quick_chat.owner && target.site == h->quick_chat.site) {
+        h->quick_chat = target;
+        h->chat_field_clicked = TRUE;
+        if (!click_chat_target(h, &target))
+            h->chat_field_clicked = FALSE;
+    }
+}
+
+static void sync_chat_limit(ClbbHost *h, gint64 now) {
+    if (now < h->chat_limit_check_at || !atl_chat_active(h->window) || atl_chat_waiting(h->window))
+        return;
+    h->chat_limit_check_at = now + 65000;
+    ClbbChatTarget target;
+    if (read_chat_target(h, &target) && target.editing)
+        atl_chat_sync_limit(h->window, &target);
+}
+
+static void tick_chat_batch(ClbbHost *h, gint64 now) {
+    if (!atl_chat_batch_pending(h->window))
+        return;
+    if (!gtk_window_is_active(h->window) || clbb_settings_is_visible(h->settings)) {
+        atl_chat_cancel_batch(h->window);
+        return;
+    }
+    if (atl_chat_active(h->window) || now < h->chat_batch_check_at)
+        return;
+    h->chat_batch_check_at = now + 50000;
+    ClbbChatTarget target;
+    gboolean available = !h->raw_tap && !atl_text_input_active(h->window) &&
+                         read_chat_target(h, &target);
+    if (atl_chat_begin_followup(h->window, available ? &target : NULL, now))
+        open_chat_field(h, &target);
+}
+
+static gboolean matches_chat_key(int binding, int code) {
+    if (binding == 0)
+        return FALSE;
+    if ((binding == 0x01000004 || binding == 0x01000005) &&
+        (code == 0x01000004 || code == 0x01000005))
+        return TRUE;
+    return binding == code;
+}
+
+static gboolean quick_chat_key(ClbbHost *h, GdkEvent *event, gboolean editing) {
+    GdkEventType type = gdk_event_get_event_type(event);
+    gboolean keyboard = type == GDK_KEY_PRESS || type == GDK_KEY_RELEASE;
+    if (!keyboard && type != GDK_BUTTON_PRESS && type != GDK_BUTTON_RELEASE)
+        return FALSE;
+    guint edge = keyboard ? gdk_key_event_get_keycode(event)
+                          : gdk_button_event_get_button(event) | 0x80000000u;
+    gboolean down = type == GDK_KEY_PRESS || type == GDK_BUTTON_PRESS;
+    if (!editing && down && keyboard && gdk_key_event_get_keyval(event) == GDK_KEY_Escape)
+        atl_chat_cancel_batch(h->window);
+    if (edge == h->chat_open_edge) {
+        if (!down) h->chat_open_edge = 0;
+        return TRUE;
+    }
+    if (edge == h->chat_send_edge && !editing) {
+        if (!down) {
+            h->chat_send_edge = 0;
+            g_hash_table_remove(h->chat_keys, GUINT_TO_POINTER(edge));
+        }
+        return TRUE;
+    }
+    if (keyboard) {
+        gpointer hardware = GUINT_TO_POINTER(edge);
+        int pressed = GPOINTER_TO_INT(g_hash_table_lookup(h->chat_keys, hardware));
+        if (!down)
+            g_hash_table_remove(h->chat_keys, hardware);
+        if (pressed == 1 || (pressed && !editing))
+            return TRUE;
+        if (editing && down && atl_chat_active(h->window))
+            g_hash_table_insert(h->chat_keys, hardware, GINT_TO_POINTER(2));
+    }
+    if (editing) {
+        if (keyboard && atl_chat_active(h->window)) {
+            guint key = gdk_key_event_get_keyval(event);
+            if (key == GDK_KEY_Return || key == GDK_KEY_KP_Enter) {
+                if (down && h->chat_send_edge == edge)
+                    return TRUE;
+                h->chat_send_edge = down ? edge : 0;
+            }
+        }
+        return FALSE;
+    }
+    if (!down || clbb_settings_is_visible(h->settings) || h->raw_tap)
+        return FALSE;
+    GdkModifierType modifiers = gdk_event_get_modifier_state(event);
+    if (modifiers & (GDK_CONTROL_MASK | GDK_ALT_MASK | GDK_SUPER_MASK | GDK_META_MASK))
+        return FALSE;
+    int code = keyboard ? clbb_settings_event_keycode(gdk_event_get_display(event),
+                   gdk_key_event_get_keyval(event), edge)
+                        : clbb_settings_mousecode(gdk_button_event_get_button(event));
+    if (!matches_chat_key(setting_int(h, "hotkeys.chat"), code))
+        return FALSE;
+    /* A key already owned by gameplay retains that ownership until release. */
+    if (keyboard && g_hash_table_contains(h->keys, GUINT_TO_POINTER(edge)))
+        return FALSE;
+    ClbbChatTarget target;
+    if (!read_chat_target(h, &target) || !atl_chat_begin(h->window, &target))
+        return FALSE;
+    h->chat_open_edge = edge;
+    open_chat_field(h, &target);
+    return TRUE;
+}
+
+static gboolean on_event(GtkEventControllerLegacy *controller, GdkEvent *event,
+                         gpointer data) {
+    (void)controller;
+    ClbbHost *h = data;
+    if (h->dispatching || h->closing)
+        return FALSE;
+    if (clbb_settings_editor_menu_visible(h->settings)) return FALSE;
+    gboolean editing = refresh_text_input(h);
+    if (!clbb_settings_is_visible(h->settings) && quick_chat_key(h, event, editing)) return TRUE;
+    if (editing) return FALSE;
+    GdkEventType type = gdk_event_get_event_type(event);
+    if(type==GDK_FOCUS_CHANGE && !gdk_focus_event_get_in(event)) unlock(h);
+    if(type==GDK_KEY_PRESS) {
+        guint value=gdk_key_event_get_keyval(event);
+        GdkModifierType state=gdk_event_get_modifier_state(event);
+        if(value==GDK_KEY_Super_L || value==GDK_KEY_Super_R ||
+           value==GDK_KEY_Meta_L || value==GDK_KEY_Meta_R ||
+           ((value==GDK_KEY_Tab || value==GDK_KEY_ISO_Left_Tab) && (state&GDK_ALT_MASK)))
+            unlock(h);
+    }
+    gboolean panel_visible = clbb_settings_is_visible(h->settings);
+    gboolean editor_visible = clbb_settings_editor_visible(h->settings);
+    if (panel_visible && !editor_visible && (clbb_settings_is_capturing(h->settings) ||
+        (type != GDK_KEY_PRESS && type != GDK_KEY_RELEASE)))
+        return FALSE;
+    if (type == GDK_MOTION_NOTIFY && h->agent_until > g_get_monotonic_time())
+        return FALSE;
+    if (h->raw_tap && (type == GDK_BUTTON_PRESS || type == GDK_KEY_PRESS)) {
+        if (h->raw_timer) g_source_remove(h->raw_timer);
+        h->raw_timer = 0;
+        h->raw_steps = 0;
+        clbb_view_touch(game_surface(GTK_WIDGET(h->window)), 2, -1, h->raw_x,
+                        h->raw_y);
+        h->raw_tap = FALSE;
+    }
+    if (h->agent_until && (type == GDK_BUTTON_PRESS || type == GDK_KEY_PRESS)) {
+        h->agent_until = 0;
+        h->suspend(h->runtime, 1);
+        h->suspend(h->runtime, 0);
+    }
+    int kind = -1, code = 0;
+    gboolean down = FALSE, repeat = FALSE, claimed = FALSE;
+    guint hardware = 0;
+    if (type == GDK_KEY_PRESS || type == GDK_KEY_RELEASE) {
+        kind = 1;
+        down = type == GDK_KEY_PRESS;
+        hardware = gdk_key_event_get_keycode(event);
+        gpointer previous =
+            g_hash_table_lookup(h->keys, GUINT_TO_POINTER(hardware));
+        repeat = down && previous;
+        code = previous ? GPOINTER_TO_INT(previous) : 0;
+        if (!code) {
+            code = clbb_settings_event_keycode(gdk_event_get_display(event),
+                gdk_key_event_get_keyval(event),hardware);
+            GdkModifierType mods = gdk_event_get_modifier_state(event);
+            int chord = clbb_settings_chord(code,mods);
+            if (!editor_visible && code && debug_recording(h) &&
+                chord == setting_int(h, "debug.mark_shortcut")) code = chord;
+        }
+        claimed = g_hash_table_contains(h->claimed, GUINT_TO_POINTER(hardware));
+        if (down)
+            g_hash_table_insert(h->keys, GUINT_TO_POINTER(hardware),
+                                GINT_TO_POINTER(code));
+        else {
+            g_hash_table_remove(h->keys, GUINT_TO_POINTER(hardware));
+            g_hash_table_remove(h->claimed, GUINT_TO_POINTER(hardware));
+        }
+    } else if (type == GDK_BUTTON_PRESS || type == GDK_BUTTON_RELEASE ||
+               type == GDK_MOTION_NOTIFY) {
+        kind = type == GDK_MOTION_NOTIFY ? 0 : 2;
+        down = type == GDK_BUTTON_PRESS;
+        if (kind == 2) {
+            guint b = gdk_button_event_get_button(event);
+            if (b == 1)
+                return FALSE;
+            code = clbb_settings_mousecode(b);
+            if (code) code &= ~0x02000000;
+        }
+        if (editor_visible && kind == 0) return FALSE;
+        GtkWidget *game = game_surface(GTK_WIDGET(h->window));
+        if (!game)
+            return FALSE;
+        double x, y;
+        gdk_event_get_position(event, &x, &y);
+        double ox, oy;
+        gtk_native_get_surface_transform(GTK_NATIVE(h->window), &ox, &oy);
+        graphene_point_t p;
+        if (!gtk_widget_compute_point(GTK_WIDGET(h->window), game,
+                                      &GRAPHENE_POINT_INIT(x - ox, y - oy), &p))
+            return FALSE;
+        h->x = p.x / gtk_widget_get_width(game);
+        h->y = p.y / gtk_widget_get_height(game);
+    } else
+        return FALSE;
+    if(kind!=0)record_host_event(2,kind,code,(down?1:0)|(repeat?2:0)|(panel_visible?4:0));
+    if (!code && kind != 0)
+        return FALSE;
+    gboolean handled = FALSE;
+    if (editor_visible) {
+        int shortcut_code=kind==2?(0x02000000|code):code;
+        gboolean capture=clbb_settings_editor_input(h->settings,shortcut_code,down,repeat);
+        gboolean close=shortcut_code==setting_int(h,"hotkeys.editor") || (kind==1 && code==0x01000000);
+        if (!capture && close && down && !repeat) clbb_settings_hide(h->settings);
+        if (kind==1 && down) g_hash_table_add(h->claimed,GUINT_TO_POINTER(hardware));
+        return capture || close || kind==1;
+    }
+    if (kind == 1 && debug_recording(h) && code == setting_int(h, "debug.mark_shortcut")) {
+        handled = TRUE;
+        if (down && !repeat) h->write(h->runtime, "debug.mark", "manual");
+    }
+    if (panel_visible) {
+        if (kind == 1 && handled && down)
+            g_hash_table_add(h->claimed, GUINT_TO_POINTER(hardware));
+        return handled || claimed;
+    }
+    if (kind != 0 && !handled)
+        handled =
+            shortcut(h, kind == 2 ? (0x02000000 | code) : code, down, repeat);
+    if (!handled) {
+        h->dispatching = TRUE;
+        gint64 input_us=g_get_monotonic_time();
+        handled = h->event(h->runtime, kind, code, down, repeat, h->x, h->y);
+        h->dispatching = FALSE;
+        if(kind!=0)portrait_redraw_after_input(h,input_us);
+    }
+    if (kind == 1 && handled && down)
+        g_hash_table_add(h->claimed, GUINT_TO_POINTER(hardware));
+    return handled || claimed;
+}
+static void draw_agent_pointer(GtkDrawingArea *area, cairo_t *cr, int width,
+                               int height, gpointer data) {
+    (void)width;
+    (void)height;
+    ClbbHost *h = data;
+    GtkWidget *game = game_surface(GTK_WIDGET(h->window));
+    if (h->show_fps && game && !clbb_settings_is_visible(h->settings)) {
+        graphene_point_t origin;
+        if (gtk_widget_compute_point(game,GTK_WIDGET(area),&GRAPHENE_POINT_INIT(0,0),&origin)) {
+            double x=origin.x+12,y=origin.y+12;
+            cairo_save(cr);
+            cairo_set_source_rgba(cr,.035,.025,.035,.94);
+            cairo_rectangle(cr,x,y,122,36);cairo_fill(cr);
+            cairo_set_source_rgb(cr,.93,.25,.40);
+            cairo_rectangle(cr,x,y,3,36);cairo_fill(cr);
+            cairo_select_font_face(cr,"monospace",CAIRO_FONT_SLANT_NORMAL,CAIRO_FONT_WEIGHT_BOLD);
+            cairo_set_font_size(cr,19);cairo_set_source_rgb(cr,1,1,1);
+            cairo_move_to(cr,x+12,y+25);cairo_show_text(cr,h->fps_text);
+            cairo_restore(cr);
+        }
+    }
+    if (h->agent_until <= g_get_monotonic_time()) return;
+    if (!game)
+        return;
+    graphene_point_t p;
+    if (!gtk_widget_compute_point(
+            game, GTK_WIDGET(area),
+            &GRAPHENE_POINT_INIT(h->x * gtk_widget_get_width(game),
+                                 h->y * gtk_widget_get_height(game)),
+            &p))
+        return;
+    cairo_set_source_rgba(cr, 0.06, 0.04, 0.06, .9);
+    cairo_set_line_width(cr, 5);
+    cairo_arc(cr, p.x, p.y, 9, 0, 6.2831853);
+    cairo_stroke(cr);
+    cairo_set_source_rgba(cr, 1., .29, .43, 1.);
+    cairo_set_line_width(cr, 2);
+    cairo_arc(cr, p.x, p.y, 9, 0, 6.2831853);
+    cairo_stroke(cr);
+    cairo_arc(cr, p.x, p.y, 2.5, 0, 6.2831853);
+    cairo_fill(cr);
+    cairo_move_to(cr, p.x + 13, p.y - 10);
+    cairo_set_font_size(cr, 11);
+    cairo_show_text(cr, "CLBB");
+}
+/* Experimental host presentation policy. This uses only public GTK/EGL APIs
+ * on the GTK thread; the guest's synthetic EGL surface is never inspected or
+ * rebound. Environment gating leaves the established presentation path alone. */
+static gboolean host_present_control_enabled(void)
+{
+    static gsize enabled = 0;
+    if (g_once_init_enter(&enabled)) {
+        const char *value = g_getenv("CLBB_HOST_PRESENT_CONTROL");
+        g_once_init_leave(&enabled, value && !strcmp(value, "0") ? 1 : 2);
+    }
+    return enabled == 2;
+}
+static void host_present_after_paint(GdkFrameClock *clock, GtkWindow *window)
+{
+    (void)clock;
+    ClbbHost *h = g_object_get_data(G_OBJECT(window), "clbb-mapper-attached");
+    if (!h || h->closing || !host_present_control_enabled()) return;
+    int interval = clbb_frame_pacing_vsync() ? 1 : 0;
+    gint64 now = g_get_monotonic_time();
+    if (now < h->present_control_at && interval == h->present_requested_interval) return;
+    h->present_control_at = now + 250000;
+    h->present_requested_interval = interval;
+    GskRenderer *renderer = gtk_native_get_renderer(GTK_NATIVE(window));
+    const char *renderer_name = renderer ? G_OBJECT_TYPE_NAME(renderer) : "none";
+    if (!renderer || strstr(renderer_name, "Vulkan") || strstr(renderer_name, "Cairo")) {
+        if (!h->present_skip_logged) {
+            fprintf(stderr, "[CLBB_HOST_PRESENT] skip renderer=%s reason=not-GL\n", renderer_name);
+            h->present_skip_logged = TRUE;
+        }
+        return;
+    }
+    typedef void *(*GetCurrent)(void);
+    typedef void *(*GetSurface)(unsigned int);
+    typedef unsigned int (*SetInterval)(void *, int);
+    static GetCurrent get_display, get_context;
+    static GetSurface get_surface;
+    static SetInterval set_interval;
+    static gboolean resolved;
+    if (!resolved) {
+        get_display = (GetCurrent)dlsym(RTLD_DEFAULT, "eglGetCurrentDisplay");
+        get_context = (GetCurrent)dlsym(RTLD_DEFAULT, "eglGetCurrentContext");
+        get_surface = (GetSurface)dlsym(RTLD_DEFAULT, "eglGetCurrentSurface");
+        set_interval = (SetInterval)dlsym(RTLD_DEFAULT, "eglSwapInterval");
+        resolved = TRUE;
+    }
+    void *display = get_display ? get_display() : NULL;
+    void *context = get_context ? get_context() : NULL;
+    void *surface = get_surface ? get_surface(0x3059 /* EGL_DRAW */) : NULL;
+    GdkGLContext *gdk_context = gdk_gl_context_get_current();
+    GdkSurface *window_surface = gtk_native_get_surface(GTK_NATIVE(window));
+    if (!display || !context || !surface || !set_interval || !gdk_context ||
+        gdk_gl_context_get_surface(gdk_context) != window_surface) {
+        if (!h->present_skip_logged) {
+            fprintf(stderr, "[CLBB_HOST_PRESENT] skip renderer=%s reason=no-current-window-EGL-context\n", renderer_name);
+            h->present_skip_logged = TRUE;
+        }
+        return;
+    }
+    gboolean result = set_interval(display, interval) != 0;
+    /* Refresh at most4Hz so compositor-state changes cannot silently restore
+     * an unwanted interval. Log only a changed surface, setting or outcome. */
+    if (!h->present_logged || display != h->present_logged_display ||
+        context != h->present_logged_context || surface != h->present_logged_surface ||
+        interval != h->present_logged_interval || result != h->present_logged_result) {
+        fprintf(stderr, "[CLBB_HOST_PRESENT] renderer=%s display=%p context=%p surface=%p interval=%d applied=%d\n",
+            renderer_name, display, context, surface, interval, result);
+        h->present_logged_display = display; h->present_logged_context = context;
+        h->present_logged_surface = surface; h->present_logged_interval = interval;
+        h->present_logged_result = result; h->present_logged = TRUE;
+    }
+}
+static void host_present_realized(GtkWidget *widget, gpointer data)
+{
+    (void)data;
+    if (!host_present_control_enabled()) return;
+    GdkFrameClock *clock = gtk_widget_get_frame_clock(widget);
+    if (!clock || g_object_get_data(G_OBJECT(clock), "clbb-host-present-control")) return;
+    g_object_set_data(G_OBJECT(clock), "clbb-host-present-control", widget);
+    /* The default GTK paint handler first makes its actual onscreen renderer
+     * current. We inspect that context only after the frame's paint handlers. */
+    g_signal_connect_object(clock, "after-paint", G_CALLBACK(host_present_after_paint),
+                            G_OBJECT(widget), G_CONNECT_AFTER);
+}
+
+/* Cache only five small GPU crops, never full game frames or CPU pixels.
+ * Preview portraits are already drawn before E. Keep their images independent
+ * of the game's subsequent held-panel animation and camera movement. */
+static void portrait_cache_clear(ClbbHost *h) {
+    for(unsigned i=0;i<5;i++){g_clear_object(&h->portraits[i].image);h->portraits[i].guid=0;h->portraits[i].captures=0;}
+}
+static GdkTexture *portrait_crop(GtkNative *native,SurfaceViewWidget *surface,double x,double y,double w,double h) {
+    if(!surface->texture || w<=0 || h<=0)return NULL;
+    GskRenderer *renderer=gtk_native_get_renderer(native);if(!renderer)return NULL;
+    double tw=gdk_texture_get_width(surface->texture),th=gdk_texture_get_height(surface->texture);
+    GtkSnapshot *crop=gtk_snapshot_new();
+    gtk_snapshot_scale(crop,128.0/(w*tw),128.0/(h*th));
+    gtk_snapshot_translate(crop,&GRAPHENE_POINT_INIT(-x*tw,-y*th));
+    if(surface->needs_flip){gtk_snapshot_translate(crop,&GRAPHENE_POINT_INIT(0,th));gtk_snapshot_scale(crop,1,-1);}
+    gtk_snapshot_append_texture(crop,surface->texture,&GRAPHENE_RECT_INIT(0,0,tw,th));
+    GskRenderNode *node=gtk_snapshot_free_to_node(crop);if(!node)return NULL;
+    GdkTexture *image=gsk_renderer_render_texture(renderer,node,&GRAPHENE_RECT_INIT(0,0,128,128));
+    gsk_render_node_unref(node);return image;
+}
+static void portrait_cache_update(ClbbHost *h,GtkNative *native,SurfaceViewWidget *surface) {
+    char *preview=g_strdup(h->read(h->runtime,"portrait.preview"));
+    char *line=strchr(preview,'\n');
+    if(!line){portrait_cache_clear(h);h->portrait_scope[0]=0;g_free(preview);return;}
+    *line++=0;
+    if(strcmp(preview,h->portrait_scope)){portrait_cache_clear(h);g_strlcpy(h->portrait_scope,preview,sizeof(h->portrait_scope));}
+    struct {guint64 guid;double uv[4];gboolean rendered;} rows[5];unsigned n=0;
+    while(*line && n<5){
+        char *end;guint64 guid=g_ascii_strtoull(line,&end,10);const char *scan=end;gboolean valid=guid!=0&&end!=line;
+        for(unsigned k=0;k<4 && valid;k++){rows[n].uv[k]=g_ascii_strtod(scan,&end);valid=end!=scan&&isfinite(rows[n].uv[k])&&rows[n].uv[k]>=0&&rows[n].uv[k]<=1;scan=end;}
+        int rendered=0;
+        if(valid && sscanf(scan,"%d",&rendered)==1){rows[n].guid=guid;rows[n].rendered=rendered!=0;n++;}
+        line=strchr(line,'\n');if(!line)break;line++;
+    }
+    const guint64 *info=g_object_get_data(G_OBJECT(surface->texture),"clbb-render-frame-info");
+    guint64 frame=info?info[3]:(guint64)(uintptr_t)surface->texture;
+    for(unsigned r=0;r<n;r++){
+        int slot=-1;
+        for(unsigned i=0;i<5;i++)if(h->portraits[i].guid==rows[r].guid){slot=i;break;}
+        if(slot<0)for(unsigned i=0;i<5;i++){
+            gboolean in_use=FALSE;for(unsigned j=0;j<n;j++)if(h->portraits[i].guid==rows[j].guid)in_use=TRUE;
+            if(!in_use){slot=i;g_clear_object(&h->portraits[i].image);h->portraits[i].guid=rows[r].guid;h->portraits[i].captures=0;break;}
+        }
+        if(slot<0 || !rows[r].rendered || (h->portrait_visible && h->portraits[slot].image) || h->portraits[slot].captures>=3 || (h->portraits[slot].captures && h->portraits[slot].frame==frame))continue;
+        double *uv=rows[r].uv;
+        GdkTexture *image=portrait_crop(native,surface,uv[0],uv[1],uv[2],uv[3]);
+        if(image){g_clear_object(&h->portraits[slot].image);h->portraits[slot].image=image;h->portraits[slot].frame=frame;h->portraits[slot].captures++;}
+    }
+    g_free(preview);
+}
