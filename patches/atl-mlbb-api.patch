+/* Fixed-name startup spans only. Default-off: no clocks or stack walks. */
+void clbb_boot_event(const char *name)
+{
+    const char *enabled = getenv("CLBB_STARTUP_TRACE");
+    if (!enabled || strcmp(enabled, "1")) return;
+    int saved_errno = errno;
+    struct timespec mono, cpu;
+    clock_gettime(CLOCK_MONOTONIC, &mono);
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &cpu);
+#ifdef __linux__
+    long tid = syscall(SYS_gettid);
+#else
+    long tid = (long)getpid();
+#endif
+    fprintf(stderr, "[CLBB startup] event=%s mono_ns=%lld cpu_ns=%lld pid=%ld tid=%ld\n",
+            name, (long long)mono.tv_sec * 1000000000 + mono.tv_nsec,
+            (long long)cpu.tv_sec * 1000000000 + cpu.tv_nsec,
+            (long)getpid(), tid);
+    errno = saved_errno;
+}
