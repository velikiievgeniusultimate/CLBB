+gboolean atl_chat_begin_followup(GtkWindow *owner, const ClbbChatTarget *target, gint64 now)
+{
+	ChatBatch *batch = g_object_get_data(G_OBJECT(owner), "atl-chat-batch");
+	if (!batch)
+		return FALSE;
+	if (now - batch->sent_at >= 8000000 ||
+	    (target && (target->owner != batch->target.owner || target->site != batch->target.site ||
+	                (target->site == 2 && !target->editing) ||
+	                (target->channel && target->channel != batch->target.channel)))) {
+		atl_chat_cancel_batch(owner);
+		return FALSE;
+	}
+	if (target && target->ready == 1)
+		batch->saw_pending = TRUE;
+	// The lobby also rejects consecutive sends in adjacent game-clock seconds,
+	// even if the first draft has already cleared.
+	gint64 delay = batch->target.site == 2 ? 2100000 : 500000;
+	if (!target || target->ready != 2 || now - batch->sent_at < delay)
+		return FALSE;
+	// The team tab stays open and clears its input after the send. In battle
+	// the game closes the panel after accepting the text from Android.
+	if ((target->site == 2 && !batch->saw_pending) || (target->site == 1 && target->editing))
+		return FALSE;
+	ClbbChatTarget original = batch->target;
+	ChatDraft *draft = g_object_get_data(G_OBJECT(owner), "atl-chat-draft");
+	if (!same_draft(draft, &original) || !atl_chat_begin(owner, target))
+		return FALSE;
+	InlineChat *chat = inline_chat(owner);
+	chat->followup = TRUE;
+	chat->followup_channel = original.channel;
+	gtk_editable_set_text(GTK_EDITABLE(chat->entry), draft->text);
+	gtk_editable_set_position(GTK_EDITABLE(chat->entry), -1);
+	gtk_editable_set_editable(GTK_EDITABLE(chat->entry), FALSE);
+	chat->send_pending = TRUE;
+	return TRUE;
+}
+
+static gboolean send_when_attached(gpointer data)
+{
+	InlineChat *chat = inline_chat(GTK_WINDOW(data));
+	if (chat && chat->dialog && chat->send_pending) {
+		if (chat->followup && !clbb_chat_parts(gtk_editable_get_text(GTK_EDITABLE(chat->entry)),
+		                                     chat_limits(chat)).first)
+			dismiss_inline(chat);
+		else
+			submit_inline(NULL, chat);
+	}
+	return G_SOURCE_REMOVE;
+}
+
+static gboolean attach_inline_chat(GtkWindow *dialog)
+{
+	if (!g_object_get_data(G_OBJECT(dialog), "atl-unity-dialog"))
+		return FALSE;
+	GtkWindow *owner = gtk_window_get_transient_for(dialog);
+	if (!owner)
+		return FALSE;
+	InlineChat *chat = inline_chat(owner);
+	if (chat && chat->dialog == dialog)
+		return TRUE;
+	if (chat && chat->dialog)
+		return FALSE;
+	TextDialog controls = {0};
+	find_text_controls(gtk_window_get_child(dialog), &controls);
+	if (controls.texts != 1 || controls.buttons != 1)
+		return FALSE;
+	ClbbChatTarget target = {0};
+	if (!query_chat_site(owner, &target, FALSE))
+		return FALSE;
+	if (!chat && !atl_chat_begin(owner, &target))
+		return FALSE;
+	chat = inline_chat(owner);
+	target.limit = MIN(chat->target.limit, target.limit);
+	chat->target = target;
+	chat->dialog = dialog;
+	chat->source_entry = controls.text;
+	update_chat_limit(chat);
+	if (!*gtk_editable_get_text(GTK_EDITABLE(chat->entry))) {
+		ChatDraft *draft = g_object_get_data(G_OBJECT(owner), "atl-chat-draft");
+		gboolean matched = same_draft(draft, &target);
+		const char *text = matched ? draft->text :
+		                   gtk_editable_get_text(GTK_EDITABLE(controls.text));
+		gtk_editable_set_text(GTK_EDITABLE(chat->entry), text);
+		gtk_editable_set_position(GTK_EDITABLE(chat->entry), -1);
+		// Opening the team bar can initially display another tab in UI_Chat.
+		chat->restore_draft_when_ready = !*text && !matched && draft &&
+			draft->target.site == target.site && draft->target.owner == target.owner;
+	}
+	if (chat->send_pending)
+		g_idle_add_full(G_PRIORITY_DEFAULT_IDLE, send_when_attached, g_object_ref(owner), g_object_unref);
+	return TRUE;
+}
