+static void resource_trace_started(WebKitWebView *view, WebKitWebResource *resource, WebKitURIRequest *request, gpointer data)
+{
+	const char *uri = webkit_uri_request_get_uri(request);
+	GUri *parsed = uri ? g_uri_parse(uri, G_URI_FLAGS_PARSE_RELAXED, NULL) : NULL;
+	const char *host = parsed ? g_uri_get_host(parsed) : NULL;
+	gboolean safe = host && *host;
+	for (const char *p = host; safe && *p; ++p)
+		if (!g_ascii_isalnum(*p) && *p != '.' && *p != '-' && *p != ':') safe = FALSE;
+	struct resource_trace *trace = g_new0(struct resource_trace, 1);
+	trace->started = g_get_monotonic_time();
+	trace->host = g_strdup(safe ? host : "local-or-invalid");
+	if (parsed) g_uri_unref(parsed);
+	g_printerr("ATL_WEBVIEW_NETWORK started host=%s method=%s\n", trace->host, request_method_label(request));
+	g_object_set_data_full(G_OBJECT(resource), "atl-resource-trace", trace, resource_trace_free);
+	g_signal_connect(resource, "failed", G_CALLBACK(resource_trace_failed), trace);
+	g_signal_connect(resource, "finished", G_CALLBACK(resource_trace_finished), trace);
+}
