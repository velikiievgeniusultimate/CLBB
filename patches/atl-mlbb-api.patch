+            (long long)cpu.tv_sec * 1000000000 + cpu.tv_nsec,
+            (long)getpid(), tid);
+    errno = saved_errno;
+}
+
+/* Optional observation only: never claim, synthesize or redirect input. */
+static gboolean window_input_trace(GtkEventControllerLegacy *controller, GdkEvent *event, gpointer data)
+{
+	GdkEventType type = gdk_event_get_event_type(event);
+	if (type != GDK_BUTTON_PRESS && type != GDK_BUTTON_RELEASE)
+		return FALSE;
+	double x = 0, y = 0;
+	gdk_event_get_position(event, &x, &y);
+	GtkWidget *target = GTK_WIDGET(data);
+	double off_x = 0, off_y = 0;
+	gtk_native_get_surface_transform(GTK_NATIVE(target), &off_x, &off_y);
+	GtkWidget *picked = gtk_widget_pick(target, x - off_x, y - off_y, GTK_PICK_DEFAULT);
+	fprintf(stderr, "[ATL input] time=%u edge=%s button=%u xy=%.1f,%.1f path=",
+	        gdk_event_get_time(event), type == GDK_BUTTON_PRESS ? "down" : "up",
+	        gdk_button_event_get_button(event), x, y);
+	for (unsigned int depth = 0; picked && depth < 10; ++depth, picked = gtk_widget_get_parent(picked))
+		fprintf(stderr, "%s%s(sensitive=%d,mapped=%d)", depth ? "/" : "",
+		        G_OBJECT_TYPE_NAME(picked), gtk_widget_is_sensitive(picked), gtk_widget_get_mapped(picked));
+	fputc('\n', stderr);
+	return FALSE;
+}
+
+/* Capture both edges before Android's focused view sees this desktop shortcut. */
+static gboolean window_shortcut_event(GtkEventControllerLegacy *controller, GdkEvent *event, gpointer data)
+{
+	GtkWindow *target = GTK_WINDOW(data);
+    if(g_object_get_data(G_OBJECT(target),"clbb-mapper-attached")) return FALSE;
+	GdkEventType type = gdk_event_get_event_type(event);
+	if ((type != GDK_KEY_PRESS && type != GDK_KEY_RELEASE) ||
+	    gdk_key_event_get_keyval(event) != GDK_KEY_F11)
+		return FALSE;
+	if (type == GDK_KEY_RELEASE) {
+		g_object_set_data(G_OBJECT(target), "atl-f11-held", NULL);
+	} else if (!g_object_get_data(G_OBJECT(target), "atl-f11-held")) {
+		g_object_set_data(G_OBJECT(target), "atl-f11-held", GINT_TO_POINTER(1));
+		gboolean fullscreen = !gtk_window_is_fullscreen(target);
+		/* Explicit desktop choice takes priority over later Android requests. */
+		g_object_set_data(G_OBJECT(target), "atl-user-fullscreen-choice", GINT_TO_POINTER(fullscreen ? 2 : 1));
+		if (fullscreen)
+			gtk_window_fullscreen(target);
+		else
+			gtk_window_unfullscreen(target);
+	}
+	return TRUE;
+}
+
+static void window_active_changed(GObject *target, GParamSpec *property, gpointer data)
+{
+	if (!gtk_window_is_active(GTK_WINDOW(target)))
+		g_object_set_data(target, "atl-f11-held", NULL);
+}
