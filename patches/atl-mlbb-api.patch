+	glGetIntegerv(GL_FRAMEBUFFER_BINDING, &draw);
+	if (separate) {
+		glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+		if ((GLuint)draw == previous) glBindFramebuffer(GL_DRAW_FRAMEBUFFER, next);
+		if ((GLuint)read == previous) glBindFramebuffer(GL_READ_FRAMEBUFFER, next);
+	} else if ((GLuint)draw == previous) glBindFramebuffer(GL_FRAMEBUFFER, next);
+}
