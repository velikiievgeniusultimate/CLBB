diff --git a/src/main-executable/restart.c b/src/main-executable/restart.c
new file mode 100644
index 0000000..30afa82
--- /dev/null
+++ b/src/main-executable/restart.c
@@ -0,0 +1,48 @@
+#define _GNU_SOURCE
+#include "restart.h"
+#include <glib.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static char **restart_argv;
+void atl_restart_init(char **argv) { restart_argv = g_strdupv(argv); }
+
+bool atl_exec_restart(void)
+{
+    if (!restart_argv) return false;
+    gint64 now = g_get_monotonic_time() / G_USEC_PER_SEC;
+    const char *old_window = getenv("CLBB_RESTART_WINDOW");
+    gint64 window = old_window ? g_ascii_strtoll(old_window, NULL, 10) : now;
+    const char *old_count = getenv("CLBB_RESTART_COUNT");
+    int count = old_count ? atoi(old_count) : 0;
+    if (now - window > 60 || now < window) { window = now; count = 0; }
+    if (count >= 5) {
+        fprintf(stderr,"[CLBB restart] repeated restart limit reached\n");
+        return false;
+    }
+    char value[64];
+    snprintf(value,sizeof value,"%lld",(long long)window);setenv("CLBB_RESTART_WINDOW",value,1);
+    snprintf(value,sizeof value,"%d",count+1);setenv("CLBB_RESTART_COUNT",value,1);
+    /* Keep stdio, but do not carry display/audio/ART descriptors into the new VM. */
+    DIR *directory = opendir("/proc/self/fd");
+    if (directory) {
+        struct dirent *entry;
+        while ((entry = readdir(directory))) {
+            char *end;long descriptor = strtol(entry->d_name,&end,10);
+            if (*end || descriptor < 3 || descriptor > INT_MAX) continue;
+            int flags = fcntl(descriptor,F_GETFD);
+            if (flags >= 0) fcntl(descriptor,F_SETFD,flags|FD_CLOEXEC);
+        }
+        closedir(directory);
+    }
+    fprintf(stderr,"[CLBB restart] replacing runtime for explicit Android relaunch\n");
+    fflush(NULL);
+    execv("/proc/self/exe",restart_argv);
+    fprintf(stderr,"[CLBB restart] exec failed: %s\n",g_strerror(errno));
+    return false;
+}
