diff --git a/src/api-impl-jni/widgets/webview_diagnostics.c b/src/api-impl-jni/widgets/webview_diagnostics.c
new file mode 100644
index 0000000..7cde14b
--- /dev/null
+++ b/src/api-impl-jni/widgets/webview_diagnostics.c
@@ -0,0 +1,107 @@
+/* Opt-in passive diagnostics: no request hooks or arbitrary page/cookie values. */
+#include "webview_diagnostics.h"
+#include <json-glib/json-glib.h>
+#include <string.h>
+
+static const char script[] =
+"(()=>{'use strict';"
+"const report=(kind,error)=>{try{"
+"const allowed=['Error','TypeError','ReferenceError','SyntaxError','SecurityError','RangeError','QuotaExceededError','InvalidStateError','NetworkError'];"
+"const name=error&&allowed.includes(error.name)?error.name:'Error';"
+"const message=String(error&&error.message||'');"
+"window.webkit.messageHandlers.atlWebDiagnostics.postMessage(JSON.stringify({kind,type:name,"
+"undefined_api:/not defined|is not a function|undefined is not|Can't find variable|is not an object/i.test(message),"
+"storage:/localStorage|sessionStorage|IndexedDB|cookie/i.test(message),"
+"network:/Failed to fetch|Load failed|NetworkError/i.test(message)}));}catch(_){}};"
+"addEventListener('error',e=>report('error',e.error));"
+"addEventListener('unhandledrejection',e=>report('promise',e.reason));"
+"addEventListener('securitypolicyviolation',e=>{try{const allowed=['script-src','connect-src','frame-src'];"
+"const directive=allowed.includes(e.effectiveDirective)?e.effectiveDirective:'other';"
+"window.webkit.messageHandlers.atlWebDiagnostics.postMessage(JSON.stringify({kind:'csp',directive}));}catch(_){}});"
+"})();";
+
+static gboolean flag(JsonObject *object, const char *key)
+{
+    JsonNode *node = json_object_get_member(object, key);
+    return node && JSON_NODE_HOLDS_VALUE(node) && json_node_get_value_type(node) == G_TYPE_BOOLEAN &&
+        json_node_get_boolean(node);
+}
+
+static const char *enum_value(JsonObject *object, const char *key, const char *const *allowed, unsigned count, const char *fallback)
+{
+    JsonNode *node = json_object_get_member(object, key);
+    const char *value = node && JSON_NODE_HOLDS_VALUE(node) && json_node_get_value_type(node) == G_TYPE_STRING
+        ? json_node_get_string(node) : NULL;
+    for (unsigned i = 0; value && i < count; ++i) if (!strcmp(value, allowed[i])) return allowed[i];
+    return fallback;
+}
+
+static void message(WebKitUserContentManager *manager, JSCValue *value, gpointer data)
+{
+    (void)manager; (void)data;
+    if (!jsc_value_is_string(value)) return;
+    char *text = jsc_value_to_string(value);
+    if (!text || strlen(text) > 2048) { g_free(text); return; }
+    JsonParser *parser = json_parser_new();
+    if (json_parser_load_from_data(parser, text, -1, NULL) && JSON_NODE_HOLDS_OBJECT(json_parser_get_root(parser))) {
+        JsonObject *object = json_node_get_object(json_parser_get_root(parser));
+        const char *kinds[] = { "error", "promise", "csp" };
+        const char *kind = enum_value(object, "kind", kinds, G_N_ELEMENTS(kinds), "other");
+        if (!strcmp(kind, "error") || !strcmp(kind, "promise")) {
+            const char *types[] = { "Error", "TypeError", "ReferenceError", "SyntaxError", "SecurityError", "RangeError", "QuotaExceededError", "InvalidStateError", "NetworkError" };
+            const char *type = enum_value(object, "type", types, G_N_ELEMENTS(types), "Error");
+            g_printerr("ATL_WEBVIEW_JS kind=%s type=%s undefined_api=%d storage=%d network=%d\n",
+                kind, type, flag(object, "undefined_api"), flag(object, "storage"), flag(object, "network"));
+        } else if (!strcmp(kind, "csp")) {
+            const char *directives[] = { "script-src", "connect-src", "frame-src" };
+            g_printerr("ATL_WEBVIEW_JS kind=csp directive=%s\n",
+                enum_value(object, "directive", directives, G_N_ELEMENTS(directives), "other"));
+        }
+    }
+    g_object_unref(parser);
+    /* Do not retain page-supplied messages, even though our script only emits metadata. */
+    if (text) { volatile char *clear = text; for (size_t i = 0, n = strlen(text); i < n; ++i) clear[i] = 0; }
+    g_free(text);
+}
+
+void atl_webview_diagnostics_install(WebKitWebView *view)
+{
+    WebKitUserContentManager *manager = webkit_web_view_get_user_content_manager(view);
+    if (g_object_get_data(G_OBJECT(view), "atl-web-diagnostics-script")) return;
+    g_signal_connect(manager, "script-message-received::atlWebDiagnostics", G_CALLBACK(message), NULL);
+    webkit_user_content_manager_register_script_message_handler(manager, "atlWebDiagnostics", NULL);
+    WebKitUserScript *injection = webkit_user_script_new(script, WEBKIT_USER_CONTENT_INJECT_TOP_FRAME,
+        WEBKIT_USER_SCRIPT_INJECT_AT_DOCUMENT_START, NULL, NULL);
+    webkit_user_content_manager_add_script(manager, injection);
+    g_object_set_data_full(G_OBJECT(view), "atl-web-diagnostics-script", injection, (GDestroyNotify)webkit_user_script_unref);
+}
+
+void atl_webview_diagnostics_remove(WebKitWebView *view)
+{
+    WebKitUserContentManager *manager = webkit_web_view_get_user_content_manager(view);
+    WebKitUserScript *injection = g_object_get_data(G_OBJECT(view), "atl-web-diagnostics-script");
+    if (!injection) return;
+    webkit_user_content_manager_remove_script(manager, injection);
+    webkit_user_content_manager_unregister_script_message_handler(manager, "atlWebDiagnostics", NULL);
+    g_signal_handlers_disconnect_by_func(manager, G_CALLBACK(message), NULL);
+    g_object_set_data(G_OBJECT(view), "atl-web-diagnostics-script", NULL);
+}
+
+static void cookies_ready(GObject *object, GAsyncResult *result, gpointer data)
+{
+    char *host = data; GError *error = NULL;
+    GList *cookies = webkit_cookie_manager_get_cookies_finish(WEBKIT_COOKIE_MANAGER(object), result, &error);
+    g_printerr("ATL_WEBVIEW_COOKIE_STATE host=%s count=%u error=%d\n", host,
+        error ? 0 : g_list_length(cookies), error != NULL);
+    g_list_free_full(cookies, (GDestroyNotify)soup_cookie_free);
+    g_clear_error(&error); g_free(host);
+}
+
+void atl_webview_diagnostics_cookie_count(WebKitWebView *view, const char *host)
+{
+    if (g_strcmp0(host, "mtacc.mobilelegends.com") && g_strcmp0(host, "accountmtapi.mobilelegends.com")) return;
+    char *uri = g_strdup_printf("https://%s/", host);
+    webkit_cookie_manager_get_cookies(webkit_network_session_get_cookie_manager(webkit_web_view_get_network_session(view)),
+        uri, NULL, cookies_ready, g_strdup(host));
+    g_free(uri);
+}
