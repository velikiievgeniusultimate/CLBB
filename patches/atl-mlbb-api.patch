+/* Native GTK/X11 adapter only. Control, projection and configuration live in
+ * Rust. */
+#define _GNU_SOURCE
+#include "clbb_mapper.h"
+#include "../../../../mapper/ui/clbb-settings.h"
+#include "../../../../mapper/ui/clbb-viewport.h"
+#include "../api-impl-jni/defines.h"
+#include "../api-impl-jni/util.h"
+#include "../api-impl-jni/widgets/android_view_SurfaceView.h"
+#include <X11/Xlib.h>
+#include <dlfcn.h>
+#include <gdk/x11/gdkx.h>
+#include <limits.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+extern int clbb_view_touch(GtkWidget *, int, int, double, double);
+extern const char *clbb_view_touch_status(void);
+extern int clbb_view_cancel_mouse(GtkWidget *, int);
+typedef float (*ClbbGain)(void);
+static _Atomic(ClbbGain) master_gain;
+typedef void (*ClbbFrameWait)(void);
+typedef unsigned int (*ClbbFrameConfiguration)(void);
+static _Atomic(ClbbFrameWait) frame_wait;
+static _Atomic(ClbbFrameConfiguration) frame_configuration;
+typedef void (*ClbbRenderEvent)(uint64_t, unsigned int, unsigned int, unsigned int, unsigned int);
+static _Atomic(ClbbRenderEvent) render_event;
+int clbb_input_capture_enabled_host(void);
+typedef int (*ClbbDebugEnabled)(void);
+typedef void (*ClbbDebugMotion)(uint64_t,int,int,int,const int*,const float*,int64_t,int64_t,int,int);
+static _Atomic(ClbbDebugEnabled) debug_enabled;
+static _Atomic(ClbbDebugMotion) debug_motion;
+typedef void (*ClbbDebugHostEvent)(int,int64_t,int64_t,int64_t);
+static _Atomic(ClbbDebugHostEvent) debug_host_event;
+typedef void (*ClbbDebugTransport)(int,int,int,const char*,double,double);
+static _Atomic(ClbbDebugTransport) debug_transport;
+static void record_host_event(int kind,int64_t a,int64_t b,int64_t c) {
+    if(!clbb_input_capture_enabled_host())return;
+    ClbbDebugHostEvent fn=atomic_load_explicit(&debug_host_event,memory_order_acquire);
+    if(fn)fn(kind,a,b,c);
+}
+
+int clbb_input_capture_enabled_host(void) {
+    ClbbDebugEnabled fn=atomic_load_explicit(&debug_enabled,memory_order_acquire);
+    return fn ? fn() : 0;
+}
+void clbb_input_motion_host(uint64_t packet,int stage,int action,int count,const int *ids,const float *coords,int64_t event_ms,int64_t down_ms,int handled,int physical) {
+    ClbbDebugMotion fn=atomic_load_explicit(&debug_motion,memory_order_acquire);
+    if(fn)fn(packet,stage,action,count,ids,coords,event_ms,down_ms,handled,physical);
+}
+
+void clbb_render_frame_event_host(uint64_t surface, unsigned int width, unsigned int height, unsigned int serial, unsigned int stage) {
+    ClbbRenderEvent event = atomic_load_explicit(&render_event, memory_order_acquire);
+    if (event) event(surface,width,height,serial,stage);
+}
+void clbb_frame_pacing_wait(void) {
+    ClbbFrameWait wait = atomic_load_explicit(&frame_wait, memory_order_acquire);
+    if (wait) wait();
+}
+int clbb_frame_pacing_vsync(void) {
+    ClbbFrameConfiguration read = atomic_load_explicit(&frame_configuration, memory_order_acquire);
+    return read ? (read() & (1u << 16)) != 0 : 1;
+}
+float clbb_master_gain(void) {
+    ClbbGain gain = atomic_load_explicit(&master_gain, memory_order_relaxed);
+    return gain ? gain() : 1.f;
+}
+typedef struct {
+    GtkWindow *window;
+    ClbbSettings *settings;
+    void *library, *runtime;
+    void *(*create)(int (*)(void *, int, int, double, double), void *);
+    void (*destroy)(void *);
+    void (*poll)(void *, double, double);
+    int (*event)(void *, int, int, int, int, double, double);
+    const char *(*read)(void *, const char *);
+    int (*write)(void *, const char *, const char *);
+    void (*suspend)(void *, int);
+    int (*configure_pacing)(unsigned int, int);
+    GHashTable *keys, *claimed;
+    gboolean dispatching, locked, closing;
+    Window fence, fence_parent;
+    GdkRectangle fence_rect;
+    Display *display;
+    guint timer;
+    double x, y;
+    guint64 ticks;
+    GSocketService *control;
+    char *socket_path;
+    gint64 agent_until;
+    GtkWidget *cursor_layer;
+    GtkWidget *viewport;
+    gboolean raw_tap;
+    double raw_x, raw_y, raw_dx, raw_dy;
+    unsigned raw_steps;
+    guint raw_timer;
+    int windowed_width, windowed_height;
+} ClbbHost;
+static GtkWidget *game_surface(GtkWidget *root) {
+    GtkWidget *best = NULL;
+    int area = 0;
+    if (SURFACE_VIEW_IS_WIDGET(root) && gtk_widget_get_mapped(root)) {
+        best = root;
+        area = gtk_widget_get_width(root) * gtk_widget_get_height(root);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child(root); child;
+         child = gtk_widget_get_next_sibling(child)) {
+        GtkWidget *found = game_surface(child);
+        if (found) {
+            int size =
+                gtk_widget_get_width(found) * gtk_widget_get_height(found);
+            if (size > area) {
+                best = found;
+                area = size;
+            }
+        }
+    }
+    return best;
+}
+static int touch(void *user, int action, int finger, double x, double y) {
+    ClbbHost *h = user;
+    int accepted=clbb_view_touch(game_surface(GTK_WIDGET(h->window)), action, finger,x,y);
+    if(clbb_input_capture_enabled_host()) {
+        ClbbDebugTransport fn=atomic_load_explicit(&debug_transport,memory_order_acquire);
+        if(fn)fn(action,finger,accepted,clbb_view_touch_status(),x,y);
+    }
+    return accepted;
+}
+static const char *read_setting(void *user, const char *key) {
+    ClbbHost *h = user;
+    return h->read(h->runtime, key);
+}
+static void unlock(ClbbHost *h);
+static void apply_resolution(ClbbHost *h) {
+    int width = atoi(h->read(h->runtime, "display.width"));
+    int height = atoi(h->read(h->runtime, "display.height"));
+    if (width < 256 || height < 256 || width > 8192 || height > 8192)
+        return;
+    JNIEnv *env = get_jni_env();
+    jclass display = _CACHED_CLASS(Display);
+    jmethodID setter =
+        (*env)->GetStaticMethodID(env, display, "setWindowSize", "(II)V");
+    if (setter)
+        (*env)->CallStaticVoidMethod(env, display, setter, width, height);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionDescribe(env);
+        (*env)->ExceptionClear(env);
+    }
+    if (h->viewport)
+        clbb_viewport_set_resolution(h->viewport, width, height);
+}
+static void apply_frame_pacing(ClbbHost *h) {
+    unsigned int fps = (unsigned int)atoi(h->read(h->runtime, "display.fps_limit"));
+    const char *sync = h->read(h->runtime, "display.vsync");
+    int vsync = strcmp(sync, "true") == 0 || strcmp(sync, "1") == 0;
+    if (!h->configure_pacing(fps, vsync)) return;
+    JNIEnv *env = get_jni_env();
+    jclass display = _CACHED_CLASS(Display);
+    jmethodID setter = (*env)->GetStaticMethodID(env, display, "setFrameRateLimit", "(I)V");
+    if (setter) (*env)->CallStaticVoidMethod(env, display, setter, (jint)fps);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionDescribe(env);
+        (*env)->ExceptionClear(env);
+    }
+}
+static gboolean write_setting(void *user, const char *key, const char *value) {
+    ClbbHost *h = user;
+    if (h->dispatching)
+        return FALSE;
+    if (!strcmp(key,"updates.open") && !strcmp(value,"1")) {
+        unlock(h);
+        h->suspend(h->runtime,1);
+        clbb_mapper_unlink_control(h->window);
+        static const char marker[]="[CLBB_EXIT] update_requested\n";
+        (void)write(STDERR_FILENO,marker,sizeof(marker)-1);
+        _exit(0);
+    }
+    h->dispatching = TRUE;
+    int result = h->write(h->runtime, key, value);
+    h->dispatching = FALSE;
+    if (result && strcmp(key, "display.resolution") == 0) {
+        unlock(h);
+        apply_resolution(h);
+    }
+    if (result && (strcmp(key, "display.frame_pacing") == 0 ||
+                   strcmp(key, "display.fps_limit") == 0 ||
+                   strcmp(key, "display.vsync") == 0))
+        apply_frame_pacing(h);
+    return result;
+}
+static int setting_int(ClbbHost *h, const char *key) {
+    return atoi(h->read(h->runtime, key));
+}
+static gboolean debug_recording(ClbbHost *h) {
+    const char *v = h->read(h->runtime, "debug.recording");
+    return v && (!strcmp(v,"true") || !strcmp(v,"1"));
+}
+
+/* Physical window coordinates after the logical Android viewport transform. */
+static gboolean fence_geometry(ClbbHost *h, GdkRectangle *rect,
+                                Window *xid, Display **display) {
+    GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(h->window));
+    if (!GDK_IS_X11_SURFACE(surface))
+        return FALSE;
+    if (!clbb_viewport_get_surface_content_rect(h->viewport,rect))
+        return FALSE;
+    if (rect->width < 32 || rect->height < 32)
+        return FALSE;
+    *xid = gdk_x11_surface_get_xid(surface);
+    *display = gdk_x11_display_get_xdisplay(gdk_surface_get_display(surface));
+    return TRUE;
+}
+static void unlock(ClbbHost *h) {
+    gboolean changed = h->locked || h->fence;
+    if(changed)record_host_event(3,0,0,0);
+    if (h->locked) {
+        XUngrabPointer(h->display, CurrentTime);
+        h->locked = FALSE;
+    }
+    if (h->fence) {
+        XDestroyWindow(h->display, h->fence);
+        h->fence = 0;
+    }
+    h->fence_parent = 0;
+    h->fence_rect = (GdkRectangle){0};
+    if (changed)
+        XFlush(h->display);
+}
+static void refresh_confine(ClbbHost *h) {
+    if (!h->locked)
+        return;
+    GdkRectangle rect;
+    Window xid;
+    Display *display;
+    if (!h->fence || !fence_geometry(h, &rect, &xid, &display) ||
+        xid != h->fence_parent || display != h->display) {
+        unlock(h);
+        return;
+    }
+    if (!gdk_rectangle_equal(&rect, &h->fence_rect)) {
+        XMoveResizeWindow(display, h->fence, rect.x, rect.y,
+                           rect.width, rect.height);
+        h->fence_rect = rect;
+        XFlush(display);
+    }
+}
+static void confine(ClbbHost *h) {
+    if (h->locked) {
+        unlock(h);
+        return;
+    }
+    GdkRectangle rect;
+    Window xid;
+    Display *display;
+    if (!fence_geometry(h, &rect, &xid, &display))
+        return;
+    Window root, child;
+    int rx, ry, px, py;
+    unsigned mask;
+    GdkSurface *surface=gtk_native_get_surface(GTK_NATIVE(h->window));
+    int scale=gdk_surface_get_scale_factor(surface);
+    if (!XQueryPointer(display, xid, &root, &child, &rx, &ry, &px, &py, &mask) ||
+        px < 0 || py < 0 || px >= gdk_surface_get_width(surface)*scale ||
+        py >= gdk_surface_get_height(surface)*scale)
+        return;
+    // Explicit F12 in a letterbox/header still activates confinement. X11
+    // brings the pointer into the game rectangle as part of this grab.
+    h->display = display;
+    h->fence_parent = xid;
+    h->fence_rect = rect;
+    XSetWindowAttributes attrs = {.override_redirect = True, .event_mask = 0};
+    h->fence =
+        XCreateWindow(display, xid, rect.x, rect.y, rect.width, rect.height,
+                      0, 0, InputOnly, CopyFromParent,
+                      CWOverrideRedirect | CWEventMask, &attrs);
+    XMapWindow(display, h->fence);
+    int result =
+        XGrabPointer(display, xid, True,
+                     ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
+                     GrabModeAsync, GrabModeAsync, h->fence, None, CurrentTime);
+    if (result == GrabSuccess) {
+        h->locked = TRUE;
+        record_host_event(3,1,0,0);
+    } else {
+        unlock(h);
+    }
+    XFlush(display);
+}
+static void visibility(void *user, gboolean visible) {
+    record_host_event(1,visible,0,0);
+    ClbbHost *h = user;
+    unlock(h);
+    if (!h->dispatching) {
+        h->dispatching = TRUE;
+        h->suspend(h->runtime, visible || !gtk_window_is_active(h->window));
+        h->dispatching = FALSE;
+    }
+}
+static gboolean shortcut(ClbbHost *h, int key, gboolean down, gboolean repeat) {
+    int settings = setting_int(h, "hotkeys.settings"),
+        lock = setting_int(h, "hotkeys.confine"),
+        full = setting_int(h, "hotkeys.fullscreen");
+    if (key != settings && key != lock && key != full)
+        return FALSE;
+    if (down && !repeat) {
+        if (key == settings)
+            clbb_settings_show(h->settings);
+        else if (key == lock)
+            confine(h);
+        else {
+            unlock(h);
+            gboolean full_screen = !gtk_window_is_fullscreen(h->window);
+            g_object_set_data(G_OBJECT(h->window), "atl-user-fullscreen-choice",
+                              GINT_TO_POINTER(full_screen ? 2 : 1));
+            if (full_screen) {
+                h->windowed_width = gtk_widget_get_width(GTK_WIDGET(h->window));
+                h->windowed_height = gtk_widget_get_height(GTK_WIDGET(h->window));
+                gtk_window_fullscreen(h->window);
+            } else {
+                gtk_window_unfullscreen(h->window);
+                if (h->windowed_width > 0 && h->windowed_height > 0)
+                    gtk_window_set_default_size(h->window, h->windowed_width,
+                                                h->windowed_height);
+            }
+        }
+    }
+    return TRUE;
+}
+static gboolean on_event(GtkEventControllerLegacy *controller, GdkEvent *event,
+                         gpointer data) {
+    (void)controller;
+    ClbbHost *h = data;
+    if (h->dispatching || h->closing)
+        return FALSE;
+    GdkEventType type = gdk_event_get_event_type(event);
+    gboolean panel_visible = clbb_settings_is_visible(h->settings);
+    if (panel_visible && (clbb_settings_is_capturing(h->settings) ||
+        (type != GDK_KEY_PRESS && type != GDK_KEY_RELEASE)))
+        return FALSE;
+    if (type == GDK_MOTION_NOTIFY && h->agent_until > g_get_monotonic_time())
+        return FALSE;
+    if (h->raw_tap && (type == GDK_BUTTON_PRESS || type == GDK_KEY_PRESS)) {
+        if (h->raw_timer) g_source_remove(h->raw_timer);
+        h->raw_timer = 0;
+        h->raw_steps = 0;
+        clbb_view_touch(game_surface(GTK_WIDGET(h->window)), 2, -1, h->raw_x,
+                        h->raw_y);
+        h->raw_tap = FALSE;
+    }
+    if (h->agent_until && (type == GDK_BUTTON_PRESS || type == GDK_KEY_PRESS)) {
+        h->agent_until = 0;
+        h->suspend(h->runtime, 1);
+        h->suspend(h->runtime, 0);
+    }
+    int kind = -1, code = 0;
+    gboolean down = FALSE, repeat = FALSE, claimed = FALSE;
+    guint hardware = 0;
+    if (type == GDK_KEY_PRESS || type == GDK_KEY_RELEASE) {
+        kind = 1;
+        down = type == GDK_KEY_PRESS;
+        hardware = gdk_key_event_get_keycode(event);
+        gpointer previous =
+            g_hash_table_lookup(h->keys, GUINT_TO_POINTER(hardware));
+        repeat = down && previous;
+        code = previous ? GPOINTER_TO_INT(previous) : 0;
+        if (!code) {
+            guint value = gdk_key_event_get_keyval(event), latin = 0;
+            int group = 0, level = 0;
+            GdkModifierType consumed = 0;
+            if (gdk_display_translate_key(gdk_event_get_display(event),
+                                          hardware, 0, 0, &latin, &group,
+                                          &level, &consumed) &&
+                latin)
+                value = latin;
+            code = clbb_settings_keycode(value);
+            GdkModifierType mods = gdk_event_get_modifier_state(event);
+            int chord = clbb_settings_chord(code,mods);
+            if (code && debug_recording(h) &&
+                chord == setting_int(h, "debug.mark_shortcut")) code = chord;
+        }
+        claimed = g_hash_table_contains(h->claimed, GUINT_TO_POINTER(hardware));
+        if (down)
+            g_hash_table_insert(h->keys, GUINT_TO_POINTER(hardware),
+                                GINT_TO_POINTER(code));
+        else {
+            g_hash_table_remove(h->keys, GUINT_TO_POINTER(hardware));
+            g_hash_table_remove(h->claimed, GUINT_TO_POINTER(hardware));
+        }
+    } else if (type == GDK_BUTTON_PRESS || type == GDK_BUTTON_RELEASE ||
+               type == GDK_MOTION_NOTIFY) {
+        kind = type == GDK_MOTION_NOTIFY ? 0 : 2;
+        down = type == GDK_BUTTON_PRESS;
+        if (kind == 2) {
+            guint b = gdk_button_event_get_button(event);
+            if (b == 1)
+                return FALSE;
+            code = b == 3 ? 2 : b == 2 ? 4 : (int)b;
+        }
+        GtkWidget *game = game_surface(GTK_WIDGET(h->window));
+        if (!game)
+            return FALSE;
+        double x, y;
+        gdk_event_get_position(event, &x, &y);
+        double ox, oy;
+        gtk_native_get_surface_transform(GTK_NATIVE(h->window), &ox, &oy);
+        graphene_point_t p;
+        if (!gtk_widget_compute_point(GTK_WIDGET(h->window), game,
+                                      &GRAPHENE_POINT_INIT(x - ox, y - oy), &p))
+            return FALSE;
+        h->x = p.x / gtk_widget_get_width(game);
+        h->y = p.y / gtk_widget_get_height(game);
+    } else
+        return FALSE;
+    if(kind!=0)record_host_event(2,kind,code,(down?1:0)|(repeat?2:0)|(panel_visible?4:0));
+    if (!code && kind != 0)
+        return FALSE;
+    gboolean handled = FALSE;
+    if (kind == 1 && debug_recording(h) && code == setting_int(h, "debug.mark_shortcut")) {
+        handled = TRUE;
+        if (down && !repeat) h->write(h->runtime, "debug.mark", "manual");
+    }
+    if (panel_visible) {
+        if (kind == 1 && handled && down)
+            g_hash_table_add(h->claimed, GUINT_TO_POINTER(hardware));
+        return handled || claimed;
+    }
+    if (kind != 0 && !handled)
+        handled =
+            shortcut(h, kind == 2 ? (0x02000000 | code) : code, down, repeat);
+    if (!handled) {
+        h->dispatching = TRUE;
+        handled = h->event(h->runtime, kind, code, down, repeat, h->x, h->y);
+        h->dispatching = FALSE;
+    }
+    if (kind == 1 && handled && down)
+        g_hash_table_add(h->claimed, GUINT_TO_POINTER(hardware));
+    return handled || claimed;
+}
+static void draw_agent_pointer(GtkDrawingArea *area, cairo_t *cr, int width,
+                               int height, gpointer data) {
+    (void)width;
+    (void)height;
+    ClbbHost *h = data;
+    if (h->agent_until <= g_get_monotonic_time())
+        return;
+    GtkWidget *game = game_surface(GTK_WIDGET(h->window));
+    if (!game)
+        return;
+    graphene_point_t p;
+    if (!gtk_widget_compute_point(
+            game, GTK_WIDGET(area),
+            &GRAPHENE_POINT_INIT(h->x * gtk_widget_get_width(game),
+                                 h->y * gtk_widget_get_height(game)),
+            &p))
+        return;
+    cairo_set_source_rgba(cr, 0.06, 0.04, 0.06, .9);
+    cairo_set_line_width(cr, 5);
+    cairo_arc(cr, p.x, p.y, 9, 0, 6.2831853);
+    cairo_stroke(cr);
+    cairo_set_source_rgba(cr, 1., .29, .43, 1.);
+    cairo_set_line_width(cr, 2);
+    cairo_arc(cr, p.x, p.y, 9, 0, 6.2831853);
+    cairo_stroke(cr);
+    cairo_arc(cr, p.x, p.y, 2.5, 0, 6.2831853);
+    cairo_fill(cr);
+    cairo_move_to(cr, p.x + 13, p.y - 10);
+    cairo_set_font_size(cr, 11);
+    cairo_show_text(cr, "CLBB");
+}
+static gboolean tick(gpointer data) {
+    ClbbHost *h = data;
+    if (h->closing)
+        return G_SOURCE_REMOVE;
+    if (h->dispatching)
+        return G_SOURCE_CONTINUE;
+    GtkWidget *surface = game_surface(GTK_WIDGET(h->window));
+    gboolean active = (gtk_window_is_active(h->window) ||
+                       h->agent_until > g_get_monotonic_time()) &&
+                      !clbb_settings_is_visible(h->settings);
+    if (h->agent_until && h->agent_until <= g_get_monotonic_time()) {
+        h->agent_until = 0;
+        gtk_widget_queue_draw(h->cursor_layer);
+    }
+    if (!active)
+        unlock(h);
+    else if (h->locked)
+        refresh_confine(h);
+    h->dispatching = TRUE;
+    h->suspend(h->runtime, !active);
+    h->poll(h->runtime, surface ? gtk_widget_get_width(surface) : 0,
+            surface ? gtk_widget_get_height(surface) : 0);
+    h->dispatching = FALSE;
+    if (++h->ticks % 500 == 0 && clbb_settings_is_visible(h->settings))
+        clbb_settings_refresh(h->settings);
+    return G_SOURCE_CONTINUE;
+}
+static void focus_changed(GObject *object, GParamSpec *spec, gpointer data) {
+    (void)spec;
+    ClbbHost *h = data;
+    record_host_event(0,gtk_window_is_active(GTK_WINDOW(object)),0,0);
+    if (!gtk_window_is_active(GTK_WINDOW(object))) {
+        unlock(h);
+        g_hash_table_remove_all(h->keys);
+        g_hash_table_remove_all(h->claimed);
+        if (!h->dispatching && h->agent_until <= g_get_monotonic_time()) {
+            h->dispatching = TRUE;
+            h->suspend(h->runtime, 1);
+            if (!h->raw_tap) clbb_view_cancel_mouse(game_surface(GTK_WIDGET(h->window)),0);
+            h->dispatching = FALSE;
+        }
+    }
+}
+void clbb_mapper_unlink_control(GtkWindow *window) {
+    ClbbHost *h = g_object_get_data(G_OBJECT(window), "clbb-mapper-attached");
+    if (h && h->socket_path)
+        unlink(h->socket_path);
+}
+
+static gboolean close_request(GtkWindow *window, gpointer data) {
+    ClbbHost *h = data;
+    h->closing = TRUE;
+    unlock(h);
+    if (h->control)
+        g_socket_service_stop(h->control);
+    clbb_mapper_unlink_control(window);
+    if (h->timer)
+        g_source_remove(h->timer);
+    h->timer = 0;
+    h->suspend(h->runtime, 1);
+    clbb_settings_hide(h->settings);
+    return FALSE;
+}
+/* Private, bounded diagnostic channel: the agent drives CLBB's own pointer,
+ * never the desktop cursor or window focus. Any real button/key takes priority.
+ */
+typedef struct {
+    ClbbHost *host;
+    GSocketConnection *connection;
+} ControlRead;
+static gboolean finish_raw_tap(gpointer data) {
+    ClbbHost *h = data;
+    if (h->raw_tap && h->raw_steps && !h->closing) {
+        h->raw_x += h->raw_dx;
+        h->raw_y += h->raw_dy;
+        --h->raw_steps;
+        clbb_view_touch(game_surface(GTK_WIDGET(h->window)), 1, -1,
+                        h->raw_x, h->raw_y);
+        return G_SOURCE_CONTINUE;
+    }
+    if (h->raw_tap) {
+        h->raw_steps = 0;
+        clbb_view_touch(game_surface(GTK_WIDGET(h->window)), 2, -1, h->raw_x,
+                        h->raw_y);
+        h->raw_tap = FALSE;
+    }
+    h->raw_timer = 0;
+    return G_SOURCE_REMOVE;
+}
+static void control_read(GObject *object, GAsyncResult *result, gpointer data) {
+    ControlRead *c = data;
+    ClbbHost *h = c->host;
+    GError *error = NULL;
+    GBytes *bytes = g_input_stream_read_bytes_finish(G_INPUT_STREAM(object),
+                                                     result, &error);
+    char *reply = NULL;
+    if (bytes && !h->closing) {
+        gsize length = 0;
+        const char *raw = g_bytes_get_data(bytes, &length);
+        char *cmd = g_strndup(raw, length);
+        char **args = g_strsplit_set(g_strstrip(cmd), " \t\r\n", 0);
+        guint count = g_strv_length(args);
+        if (count == 1 && strcmp(args[0], "close") == 0) {
+            /* Explicit owned diagnostic stop, same successful exit as the cross. */
+            clbb_mapper_unlink_control(h->window);
+            static const char marker[]="[CLBB_EXIT] desktop_close\n";
+            (void)write(STDERR_FILENO,marker,sizeof(marker)-1);
+            _exit(0);
+        } else if (count == 2 && strcmp(args[0], "read") == 0 &&
+            strcmp(args[1], "diagnostics.frame_pacing") == 0) {
+            ClbbFrameConfiguration read = atomic_load_explicit(
+                &frame_configuration, memory_order_acquire);
+            unsigned int config = read ? read() : (60u | (1u << 16));
+            reply = g_strdup_printf("{\"limit\":%u,\"vsync\":%s}",
+                config & 0xffffu, (config & (1u << 16)) ? "true" : "false");
+        } else if (count == 2 && strcmp(args[0], "read") == 0 &&
+            strcmp(args[1], "diagnostics.delivery") == 0) {
+            reply = g_strdup_printf("{\"last_touch_status\":\"%s\",\"raw_gesture_active\":%s}",
+                clbb_view_touch_status(),h->raw_tap ? "true":"false");
+        } else if (count == 2 && strcmp(args[0], "read") == 0 &&
+            strcmp(args[1], "diagnostics.viewport") == 0) {
+            graphene_rect_t rect;
+            clbb_viewport_get_content_rect(h->viewport, &rect);
+            GtkWidget *game = game_surface(GTK_WIDGET(h->window));
+            reply = g_strdup_printf("{\"window\":[%d,%d],\"logical\":[%d,%d],\"content\":[%.3f,%.3f,%.3f,%.3f],\"fullscreen\":%d}",
+                gtk_widget_get_width(GTK_WIDGET(h->window)), gtk_widget_get_height(GTK_WIDGET(h->window)),
+                game ? gtk_widget_get_width(game) : 0, game ? gtk_widget_get_height(game) : 0,
+                rect.origin.x, rect.origin.y, rect.size.width, rect.size.height,
+                gtk_window_is_fullscreen(h->window));
+        } else if (count == 2 && strcmp(args[0], "read") == 0 &&
+                   strcmp(args[1], "diagnostics.cursor_fence") == 0) {
+            GdkRectangle rect; Window xid; Display *display;
+            gboolean valid = fence_geometry(h, &rect, &xid, &display);
+            reply = valid ? g_strdup_printf("{\"rect\":[%d,%d,%d,%d],\"locked\":%s,\"scale\":%d}",
+                rect.x,rect.y,rect.width,rect.height,h->locked ? "true":"false",
+                gdk_surface_get_scale_factor(gtk_native_get_surface(GTK_NATIVE(h->window))))
+                : g_strdup("{\"rect\":null,\"locked\":false}");
+        } else if (count == 2 && strcmp(args[0], "fullscreen") == 0 &&
+                   (strcmp(args[1], "1") == 0 || strcmp(args[1], "0") == 0)) {
+            gboolean desired = strcmp(args[1], "1") == 0;
+            if (gtk_window_is_fullscreen(h->window) != desired)
+                shortcut(h, setting_int(h, "hotkeys.fullscreen"), TRUE, FALSE);
+            reply = g_strdup("OK");
+        } else if (count && strcmp(args[0], "read") == 0 && count == 2)
+            reply = g_strdup(h->read(h->runtime, args[1]));
+        else if (count == 5 && strcmp(args[0], "tap-window") == 0) {
+            /* Same surface transform as desktop events, without a desktop seat.
+             * Geometry is checked on the GTK thread immediately before delivery. */
+            double x = g_ascii_strtod(args[1], NULL),
+                   y = g_ascii_strtod(args[2], NULL);
+            GdkSurface *native = gtk_native_get_surface(GTK_NATIVE(h->window));
+            GtkWidget *game = game_surface(GTK_WIDGET(h->window));
+            graphene_point_t point;
+            double ox = 0, oy = 0;
+            if (native && game && !h->raw_tap &&
+                gdk_surface_get_scale_factor(native) == 1 &&
+                gdk_surface_get_width(native) == atoi(args[3]) &&
+                gdk_surface_get_height(native) == atoi(args[4]) &&
+                x >= 0 && y >= 0 && x < atoi(args[3]) && y < atoi(args[4])) {
+                gtk_native_get_surface_transform(GTK_NATIVE(h->window), &ox, &oy);
+                if (gtk_widget_compute_point(GTK_WIDGET(h->window), game,
+                    &GRAPHENE_POINT_INIT(x - ox, y - oy), &point) &&
+                    point.x >= 0 && point.y >= 0 &&
+                    point.x < gtk_widget_get_width(game) &&
+                    point.y < gtk_widget_get_height(game)) {
+                    h->raw_x = point.x / gtk_widget_get_width(game);
+                    h->raw_y = point.y / gtk_widget_get_height(game);
+                    h->raw_steps = 0;
+                    h->raw_tap = clbb_view_touch(game, 0, -1, h->raw_x, h->raw_y);
+                    if (h->raw_tap) h->raw_timer = g_timeout_add(160, finish_raw_tap, h);
+                }
+            }
+            reply = g_strdup(h->raw_tap ? "OK tap" : "REJECTED tap");
+        }
+        else if (count == 5 && strcmp(args[0], "swipe") == 0) {
+            double x = g_ascii_strtod(args[1], NULL), y = g_ascii_strtod(args[2], NULL),
+                   tx = g_ascii_strtod(args[3], NULL), ty = g_ascii_strtod(args[4], NULL);
+            if (x >= 0 && x <= 1 && y >= 0 && y <= 1 &&
+                tx >= 0 && tx <= 1 && ty >= 0 && ty <= 1 && !h->raw_tap) {
+                h->raw_x = x; h->raw_y = y;
+                h->raw_steps = 20;
+                h->raw_dx = (tx - x) / h->raw_steps;
+                h->raw_dy = (ty - y) / h->raw_steps;
+                h->raw_tap = clbb_view_touch(game_surface(GTK_WIDGET(h->window)),
+                                            0, -1, x, y);
+                if (h->raw_tap) h->raw_timer = g_timeout_add(16, finish_raw_tap, h);
+            }
+            reply = g_strdup(h->raw_tap ? "OK swipe" : "REJECTED swipe");
+        }
+        else if (count == 3 && strcmp(args[0], "tap") == 0) {
+            double x = g_ascii_strtod(args[1], NULL),
+                   y = g_ascii_strtod(args[2], NULL);
+            if (x >= 0 && x <= 1 && y >= 0 && y <= 1 && !h->raw_tap) {
+                h->raw_steps = 0;
+                h->raw_tap = clbb_view_touch(
+                    game_surface(GTK_WIDGET(h->window)), 0, -1, x, y);
+                if (h->raw_tap) {
+                    h->raw_x = x;
+                    h->raw_y = y;
+                    h->raw_timer = g_timeout_add(160, finish_raw_tap, h);
+                }
+            }
+            reply = g_strdup(h->raw_tap ? "OK tap" : "REJECTED tap");
+        } else if (count == 3 && strcmp(args[0], "write") == 0)
+            reply = g_strdup(write_setting(h, args[1], args[2]) ? "OK"
+                                                                : "REJECTED");
+        else if (count == 1 && strcmp(args[0], "cancel-idle-mouse") == 0) {
+            reply=g_strdup(!h->raw_tap && clbb_view_cancel_mouse(game_surface(GTK_WIDGET(h->window)),1)
+                ? "OK idle mouse released" : "REJECTED mouse cancel");
+        }
+        else if (count == 1 && strcmp(args[0], "begin") == 0) {
+            h->agent_until = g_get_monotonic_time() + 2000000;
+            h->suspend(h->runtime, 1);
+            h->suspend(h->runtime, 0);
+            reply = g_strdup("OK independent pointer");
+        } else if (count == 1 && strcmp(args[0], "end") == 0) {
+            h->agent_until = 0;
+            h->suspend(h->runtime, 1);
+            gtk_widget_queue_draw(h->cursor_layer);
+            reply = g_strdup("OK released");
+        } else if (count == 3 && (strcmp(args[0], "pointer") == 0 ||
+                                  strcmp(args[0], "key") == 0 ||
+                                  strcmp(args[0], "mouse") == 0)) {
+            if (h->agent_until <= g_get_monotonic_time()) {
+                reply = g_strdup("REJECTED agent preempted or expired");
+                goto reply_control;
+            }
+            h->agent_until = g_get_monotonic_time() + 2000000;
+            h->suspend(h->runtime, 0);
+            h->dispatching = TRUE;
+            int handled = 0;
+            if (strcmp(args[0], "pointer") == 0) {
+                h->x = g_ascii_strtod(args[1], NULL);
+                h->y = g_ascii_strtod(args[2], NULL);
+                handled = h->event(h->runtime, 0, 0, 0, 0, h->x, h->y);
+            } else
+                handled =
+                    h->event(h->runtime, strcmp(args[0], "key") == 0 ? 1 : 2,
+                             atoi(args[1]), atoi(args[2]), 0, h->x, h->y);
+            h->dispatching = FALSE;
+            gtk_widget_queue_draw(h->cursor_layer);
+            reply = g_strdup_printf("OK handled=%d", handled);
+        } else
+            reply = g_strdup("ERROR command");
+    reply_control:
+        g_strfreev(args);
+        g_free(cmd);
+    }
+    if (reply) {
+        char *line = g_strconcat(reply, "\n", NULL);
+        g_output_stream_write_all(
+            g_io_stream_get_output_stream(G_IO_STREAM(c->connection)), line,
+            strlen(line), NULL, NULL, NULL);
+        g_free(line);
+        g_free(reply);
+    }
+    if (bytes)
+        g_bytes_unref(bytes);
+    g_clear_error(&error);
+    g_io_stream_close(G_IO_STREAM(c->connection), NULL, NULL);
+    g_object_unref(c->connection);
+    g_free(c);
+}
+static gboolean control_incoming(GSocketService *service,
+                                 GSocketConnection *connection, GObject *source,
+                                 gpointer data) {
+    (void)service;
+    (void)source;
+    ControlRead *c = g_new0(ControlRead, 1);
+    c->host = data;
+    c->connection = g_object_ref(connection);
+    g_input_stream_read_bytes_async(
+        g_io_stream_get_input_stream(G_IO_STREAM(connection)), 1024,
+        G_PRIORITY_DEFAULT, NULL, control_read, c);
+    return TRUE;
+}
+static void control_start(ClbbHost *h) {
+    char *dir = g_build_filename(g_get_user_runtime_dir(), "clbb", NULL);
+    if (g_mkdir_with_parents(dir, 0700)) {
+        g_free(dir);
+        return;
+    }
+    h->socket_path = g_strdup_printf("%s/mapper-%d.sock", dir, getpid());
+    g_free(dir);
+    unlink(h->socket_path);
+    h->control = g_socket_service_new();
+    GSocketAddress *address = g_unix_socket_address_new(h->socket_path);
+    GError *error = NULL;
+    if (!g_socket_listener_add_address(
+            G_SOCKET_LISTENER(h->control), address, G_SOCKET_TYPE_STREAM,
+            G_SOCKET_PROTOCOL_DEFAULT, NULL, NULL, &error)) {
+        fprintf(stderr, "[CLBB mapper] control: %s\n", error->message);
+        g_clear_error(&error);
+        g_clear_object(&h->control);
+    } else {
+        g_signal_connect(h->control, "incoming", G_CALLBACK(control_incoming),
+                         h);
+        g_socket_service_start(h->control);
+        fprintf(stderr, "[CLBB mapper] private pointer: %s\n", h->socket_path);
+    }
+    g_object_unref(address);
+}
+static void *mapper_library(void) {
+    static void *library = NULL;
+    if (library)
+        return library;
+    char path[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+    if (n < 0)
+        return NULL;
+    path[n] = 0;
+    char *dir = g_path_get_dirname(path);
+    char *file = g_build_filename(dir, "..", "lib", "libclbb_mapper.so", NULL);
+    g_free(dir);
+    library = dlopen(file, RTLD_NOW | RTLD_GLOBAL);
+    g_free(file);
+    return library;
+}
+void clbb_mapper_boot_resolution(int *width, int *height) {
+    void *library = mapper_library();
+    if (!library)
+        return;
+    void (*resolution)(int *, int *) =
+        dlsym(library, "clbb_mapper_config_resolution");
+    if (resolution)
+        resolution(width, height);
+    atomic_store_explicit(&master_gain,
+                          (ClbbGain)dlsym(library, "clbb_audio_gain"),
+                          memory_order_relaxed);
+    atomic_store_explicit(&render_event,
+                         (ClbbRenderEvent)dlsym(library,"clbb_render_frame_event"), memory_order_release);
+    atomic_store_explicit(&frame_wait,
+                         (ClbbFrameWait)dlsym(library, "clbb_frame_pacer_wait"), memory_order_release);
+    atomic_store_explicit(&frame_configuration,
+                         (ClbbFrameConfiguration)dlsym(library, "clbb_frame_pacer_configuration"), memory_order_release);
+}
+void clbb_mapper_attach(GtkWindow *window) {
+    ClbbHost *h = g_new0(ClbbHost, 1);
+    h->window = window;
+    h->x = h->y = .5;
+    h->library = mapper_library();
+    if (!h->library) {
+        fprintf(stderr, "[CLBB mapper] unavailable: %s\n", dlerror());
+        g_free(h);
+        return;
+    }
+#define LOAD(field, name)                                                      \
+    do {                                                                       \
+        *(void **)(&h->field) = dlsym(h->library, name);                       \
+        if (!h->field) {                                                       \
+            fprintf(stderr, "[CLBB mapper] missing %s\n", name);               \
+            g_free(h);                                                         \
+            return;                                                            \
+        }                                                                      \
+    } while (0)
+    LOAD(create, "clbb_mapper_create");
+    LOAD(destroy, "clbb_mapper_destroy");
+    LOAD(poll, "clbb_mapper_poll");
+    LOAD(event, "clbb_mapper_event");
+    LOAD(read, "clbb_mapper_read");
+    LOAD(write, "clbb_mapper_write");
+    LOAD(suspend, "clbb_mapper_suspend");
+    LOAD(configure_pacing, "clbb_frame_pacer_configure");
+#undef LOAD
+    h->runtime = h->create(touch, h);
+    atomic_store_explicit(&debug_transport,(ClbbDebugTransport)dlsym(h->library,"clbb_debug_transport_status"),memory_order_release);
+    atomic_store_explicit(&debug_host_event,(ClbbDebugHostEvent)dlsym(h->library,"clbb_debug_host_event"),memory_order_release);
+    atomic_store_explicit(&debug_enabled,(ClbbDebugEnabled)dlsym(h->library,"clbb_debug_recording"),memory_order_release);
+    atomic_store_explicit(&debug_motion,(ClbbDebugMotion)dlsym(h->library,"clbb_debug_motion"),memory_order_release);
+    gtk_widget_add_css_class(GTK_WIDGET(window), "clbb-game");
+    gtk_window_set_title(window, "CLBB · Mobile Legends");
+    GtkCssProvider *frame_style = gtk_css_provider_new();
+    gtk_css_provider_load_from_string(
+        frame_style,
+        "window.clbb-game { background:#101014; } window.clbb-game headerbar { "
+        "background:#18131a; color:#f2edf0; border-bottom:1px solid #49313e; } "
+        "window.clbb-game headerbar button {color:#f2edf0;}");
+    gtk_style_context_add_provider_for_display(
+        gtk_widget_get_display(GTK_WIDGET(window)),
+        GTK_STYLE_PROVIDER(frame_style),
+        GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+    g_object_unref(frame_style);
+    GtkWidget *content = gtk_window_get_child(window);
+    g_object_ref(content);
+    gtk_window_set_child(window, NULL);
+    GtkWidget *overlay = gtk_overlay_new();
+    int logical_width = setting_int(h, "display.width"),
+        logical_height = setting_int(h, "display.height");
+    h->viewport = clbb_viewport_new(content, logical_width, logical_height);
+    gtk_overlay_set_child(GTK_OVERLAY(overlay), h->viewport);
+    apply_resolution(h);
+    apply_frame_pacing(h);
+    g_object_unref(content);
+    gtk_window_set_child(window, overlay);
+    h->cursor_layer = gtk_drawing_area_new();
+    gtk_widget_set_can_target(h->cursor_layer, FALSE);
+    gtk_widget_set_hexpand(h->cursor_layer, TRUE);
+    gtk_widget_set_vexpand(h->cursor_layer, TRUE);
+    gtk_drawing_area_set_draw_func(GTK_DRAWING_AREA(h->cursor_layer),
+                                   draw_agent_pointer, h, NULL);
+    gtk_overlay_add_overlay(GTK_OVERLAY(overlay), h->cursor_layer);
+    control_start(h);
+    atomic_store_explicit(&master_gain,
+                          (ClbbGain)dlsym(h->library, "clbb_audio_gain"),
+                          memory_order_relaxed);
+    h->keys = g_hash_table_new(g_direct_hash, g_direct_equal);
+    h->claimed = g_hash_table_new(g_direct_hash, g_direct_equal);
+    ClbbSettingsCallbacks cb = {read_setting, write_setting, visibility, h};
+    h->settings = clbb_settings_create(GTK_OVERLAY(overlay), &cb);
+    GtkEventController *controller = gtk_event_controller_legacy_new();
+    gtk_event_controller_set_propagation_phase(controller, GTK_PHASE_CAPTURE);
+    g_signal_connect(controller, "event", G_CALLBACK(on_event), h);
+    gtk_widget_add_controller(GTK_WIDGET(window), controller);
+    g_signal_connect(window, "notify::is-active", G_CALLBACK(focus_changed), h);
+    g_signal_connect(window, "close-request", G_CALLBACK(close_request), h);
+    g_object_set_data(G_OBJECT(window), "clbb-mapper-attached", h);
+    h->timer = g_timeout_add_full(G_PRIORITY_HIGH, 1, tick, h, NULL);
+    fprintf(stderr,
+            "[CLBB mapper] Rust core attached; physical LMB preserved\n");
+}
