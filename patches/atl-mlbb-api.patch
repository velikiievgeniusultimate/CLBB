+JNIEXPORT void JNICALL Java_android_webkit_WebView_native_1setJavascriptBridge(JNIEnv *env, jobject this, jlong widget, jstring bootstrap)
+{
+	WebKitWebView *view = get_webview(widget);
+	if (!view || !bootstrap)
+		return;
+	WebKitUserContentManager *manager = webkit_web_view_get_user_content_manager(view);
+	WebKitUserScript *previous = g_object_get_data(G_OBJECT(view), "atl-javascript-bridge");
+	if (previous)
+		webkit_user_content_manager_remove_script(manager, previous);
+	gchar *source = java_string_to_utf8(env, bootstrap);
+	if (!source)
+		return;
+	WebKitUserScript *script = webkit_user_script_new(source, WEBKIT_USER_CONTENT_INJECT_TOP_FRAME,
+	                                                WEBKIT_USER_SCRIPT_INJECT_AT_DOCUMENT_START, NULL, NULL);
+	webkit_user_content_manager_add_script(manager, script);
+	g_object_set_data_full(G_OBJECT(view), "atl-javascript-bridge", script, (GDestroyNotify)webkit_user_script_unref);
+	webkit_web_view_evaluate_javascript(view, source, -1, NULL, NULL, NULL, NULL, NULL);
+	g_free(source);
+}
+
+static void javascript_evaluated(GObject *object, GAsyncResult *result, gpointer data)
+{
+	JNIEnv *env = get_jni_env();
+	jobject callback = data;
+	GError *error = NULL;
+	JSCValue *value = webkit_web_view_evaluate_javascript_finish(WEBKIT_WEB_VIEW(object), result, &error);
+	gchar *json = value ? jsc_value_to_json(value, 0) : NULL;
+	if (callback) {
+		jclass type = (*env)->GetObjectClass(env, callback);
+		jmethodID receive = (*env)->GetMethodID(env, type, "onReceiveValue", "(Ljava/lang/Object;)V");
+		jstring response = java_string_from_utf8(env, json ? json : "null");
+		if (receive && response)
+			(*env)->CallVoidMethod(env, callback, receive, response);
+		(*env)->DeleteLocalRef(env, response);
+		(*env)->DeleteLocalRef(env, type);
+		(*env)->DeleteGlobalRef(env, callback);
+	}
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionClear(env);
+	g_free(json);
+	g_clear_object(&value);
+	g_clear_error(&error);
+}
+
+JNIEXPORT void JNICALL Java_android_webkit_WebView_native_1evaluateJavascript(JNIEnv *env, jobject this, jlong widget, jstring script, jobject callback)
+{
+	WebKitWebView *view = get_webview(widget);
+	if (!view || !script)
+		return;
+	gchar *source = java_string_to_utf8(env, script);
+	if (!source)
+		return;
+	jobject retained = callback ? (*env)->NewGlobalRef(env, callback) : NULL;
+	webkit_web_view_evaluate_javascript(view, source, -1, NULL, NULL, NULL, javascript_evaluated, retained);
+	g_free(source);
+}
