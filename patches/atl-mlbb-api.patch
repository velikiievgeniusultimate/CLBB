+/* Number of components returned by the GLES2 boolean-state queries. */
+static int boolean_state_count(GLenum name)
+{
+	switch (name) {
+	case GL_COLOR_WRITEMASK: case GL_SCISSOR_BOX: case GL_VIEWPORT: case GL_BLEND_COLOR:
+		return 4;
+	case GL_ALIASED_LINE_WIDTH_RANGE: case GL_ALIASED_POINT_SIZE_RANGE: case GL_DEPTH_RANGE:
+		return 2;
+	case GL_COMPRESSED_TEXTURE_FORMATS: {
+		GLint count = 0; glGetIntegerv(GL_NUM_COMPRESSED_TEXTURE_FORMATS, &count); return count;
+	}
+	case GL_SHADER_BINARY_FORMATS: {
+		GLint count = 0; glGetIntegerv(GL_NUM_SHADER_BINARY_FORMATS, &count); return count;
+	}
+	default: return 1;
+	}
+}
+
+JNIEXPORT void JNICALL Java_android_opengl_GLES20_glGetBooleanv__I_3ZI(JNIEnv *env, jclass type, jint name, jbooleanArray array, jint offset)
+{
+	int count = boolean_state_count(name);
+	if (!array || offset < 0 || count < 0 || offset > (*env)->GetArrayLength(env, array) - count) {
+		(*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/IllegalArgumentException"), "Boolean state output is too small");
+		return;
+	}
+	jboolean *values = (*env)->GetBooleanArrayElements(env, array, NULL);
+	if (!values) return;
+	glGetBooleanv(name, (GLboolean *)(values + offset));
+	(*env)->ReleaseBooleanArrayElements(env, array, values, 0);
+}
+
+JNIEXPORT void JNICALL Java_android_opengl_GLES20_glGetBooleanv__ILjava_nio_IntBuffer_2(JNIEnv *env, jclass type, jint name, jobject buffer)
+{
+	int count = boolean_state_count(name);
+	if (!buffer || count < 0 || get_nio_buffer_size(env, buffer) < count) {
+		(*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/IllegalArgumentException"), "Boolean state buffer is too small");
+		return;
+	}
+	GLboolean *state = calloc(count > 0 ? count : 1, sizeof(GLboolean));
+	if (!state) { (*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/OutOfMemoryError"), "Boolean state allocation failed"); return; }
+	glGetBooleanv(name, state);
+	jarray reference; jbyte *array;
+	GLint *values = get_nio_buffer(env, buffer, &reference, &array);
+	for (int i = 0; i < count; ++i) values[i] = state[i] ? 1 : 0;
+	release_nio_buffer(env, reference, array);
+	free(state);
+}
