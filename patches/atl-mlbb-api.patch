+static jstring java_string_from_utf8(JNIEnv *env, const gchar *text)
+{
+	glong length = 0;
+	gunichar2 *utf16 = g_utf8_to_utf16(text ? text : "", -1, NULL, &length, NULL);
+	if (!utf16) return NULL;
+	jstring result = (*env)->NewString(env, utf16, length);
+	g_free(utf16);
+	return result;
+}
+
+static gchar *java_string_to_utf8(JNIEnv *env, jstring text)
+{
+	if (!text) return NULL;
+	const jchar *utf16 = (*env)->GetStringChars(env, text, NULL);
+	if (!utf16) return NULL;
+	gchar *result = g_utf16_to_utf8(utf16, (*env)->GetStringLength(env, text), NULL, NULL, NULL);
+	(*env)->ReleaseStringChars(env, text, utf16);
+	return result;
+}
