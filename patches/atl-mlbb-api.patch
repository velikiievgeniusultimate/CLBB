+/* Private, bounded diagnostic channel: the agent drives CLBB's own pointer,
+ * never the desktop cursor or window focus. Any real button/key takes priority.
+ */
+typedef struct {
+    ClbbHost *host;
+    GSocketConnection *connection;
+} ControlRead;
+static gboolean raw_pointer_arguments(const char *u, const char *v,
+                                      double *x, double *y) {
+    char *end = NULL;
+    errno = 0;
+    double parsed_x = g_ascii_strtod(u, &end);
+    if (errno || end == u || *end || !isfinite(parsed_x) ||
+        parsed_x < 0 || parsed_x > 1)
+        return FALSE;
+    errno = 0;
+    double parsed_y = g_ascii_strtod(v, &end);
+    if (errno || end == v || *end || !isfinite(parsed_y) ||
+        parsed_y < 0 || parsed_y > 1)
+        return FALSE;
+    *x = parsed_x;
+    *y = parsed_y;
+    return TRUE;
+}
+static gboolean raw_hold_arguments(const char *u, const char *v, const char *ms,
+                                   double *x, double *y, guint *duration) {
+    double parsed_x, parsed_y;
+    if (!raw_pointer_arguments(u, v, &parsed_x, &parsed_y))
+        return FALSE;
+    char *end = NULL;
+    errno = 0;
+    guint64 parsed_ms = g_ascii_strtoull(ms, &end, 10);
+    if (errno || end == ms || *end || ms[0] == '-' || ms[0] == '+' ||
+        parsed_ms < 16 || parsed_ms > 5000)
+        return FALSE;
+    *x = parsed_x;
+    *y = parsed_y;
+    *duration = (guint)parsed_ms;
+    return TRUE;
+}
+static gboolean finish_raw_tap(gpointer data) {
+    ClbbHost *h = data;
+    if (h->raw_tap && h->raw_steps && !h->closing) {
+        h->raw_x += h->raw_dx;
+        h->raw_y += h->raw_dy;
+        --h->raw_steps;
+        clbb_view_touch(game_surface(GTK_WIDGET(h->window)), 1, -1,
+                        h->raw_x, h->raw_y);
+        return G_SOURCE_CONTINUE;
+    }
+    if (h->raw_tap) {
+        h->raw_steps = 0;
+        clbb_view_touch(game_surface(GTK_WIDGET(h->window)), 2, -1, h->raw_x,
+                        h->raw_y);
+        h->raw_tap = FALSE;
+    }
+    h->raw_timer = 0;
+    return G_SOURCE_REMOVE;
+}
+static gboolean tap_game_control(void *data, double x, double y) {
+    ClbbHost *h = data;
+    if (h->closing || h->raw_tap || h->raw_timer || clbb_settings_is_visible(h->settings))
+        return FALSE;
+    GtkWidget *surface = game_surface(GTK_WIDGET(h->window));
+    if (!surface || !clbb_view_touch(surface, 0, -1, x, y))
+        return FALSE;
+    h->raw_tap = TRUE;
+    h->raw_x = x;
+    h->raw_y = y;
+    h->raw_steps = 0;
+    h->raw_timer = g_timeout_add(80, finish_raw_tap, h);
+    return TRUE;
+}
