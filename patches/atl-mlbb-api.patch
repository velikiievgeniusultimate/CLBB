+	chat->card = g_object_ref_sink(gtk_box_new(GTK_ORIENTATION_VERTICAL, 5));
+	GtkWidget *row = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 8);
+	gtk_widget_add_css_class(chat->card, "clbb-chat-entry");
