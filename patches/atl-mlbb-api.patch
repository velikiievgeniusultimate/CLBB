+static const char *request_method_label(WebKitURIRequest *request)
+{
+	const char *method = webkit_uri_request_get_http_method(request);
+	static const char *const known[] = { "GET", "HEAD", "POST", "OPTIONS", "PUT", "PATCH", "DELETE" };
+	for (size_t i = 0; i < G_N_ELEMENTS(known); ++i)
+		if (!g_strcmp0(method, known[i])) return known[i];
+	return "OTHER";
+}
