--- /dev/null
+++ b/src/api-impl-jni/graphics/atl_surface_texture.c
@@ -0,0 +1,214 @@
+/* FFmpeg frame -> bounded latest-frame queue -> EGLImage external texture.
+ * GL work runs only in updateTexImage on the caller's current GL context.
+ */
+#include "atl_surface_texture.h"
+#include <epoxy/gl.h>
+#include <epoxy/egl.h>
+#include <stdint.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/mathematics.h>
+#include <string.h>
+
+struct AtlTextureConsumer {
+    gint references;
+    gboolean trace;
+    guint queued, latched;
+    GMutex lock;
+    gboolean closed;
+    unsigned texture;
+    guint8 *pixels;
+    int width, height;
+    gint64 pending_timestamp, timestamp;
+};
+
+AtlTextureConsumer *atl_texture_consumer_new(unsigned texture) {
+    AtlTextureConsumer *c = g_new0(AtlTextureConsumer, 1);
+    c->references = 1;
+    c->texture = texture;
+    c->trace = g_getenv("ATL_BOOT_TRACE") != NULL;
+    if (c->trace) g_printerr("[ATL video] create consumer=%p texture=%u\n", c, texture);
+    g_mutex_init(&c->lock);
+    return c;
+}
+AtlTextureConsumer *atl_texture_consumer_ref(AtlTextureConsumer *c) {
+    if (c) g_atomic_int_inc(&c->references);
+    return c;
+}
+void atl_texture_consumer_unref(AtlTextureConsumer *c) {
+    if (c && g_atomic_int_dec_and_test(&c->references)) {
+        g_free(c->pixels);
+        g_mutex_clear(&c->lock);
+        g_free(c);
+    }
+}
+void atl_texture_consumer_close(AtlTextureConsumer *c) {
+    g_mutex_lock(&c->lock);
+    c->closed = TRUE;
+    g_clear_pointer(&c->pixels, g_free);
+    g_mutex_unlock(&c->lock);
+}
+void atl_texture_consumer_set_texture(AtlTextureConsumer *c, unsigned texture) {
+    g_mutex_lock(&c->lock);
+    c->texture = texture;
+    g_mutex_unlock(&c->lock);
+}
+gint64 atl_texture_consumer_timestamp(AtlTextureConsumer *c) {
+    g_mutex_lock(&c->lock);
+    gint64 timestamp = c->timestamp;
+    g_mutex_unlock(&c->lock);
+    return timestamp;
+}
+
+gboolean atl_texture_consumer_queue(AtlTextureConsumer *c, AVFrame *frame,
+                                    struct SwsContext **conversion) {
+    if (!c || frame->width <= 0 || frame->height <= 0 || frame->width > 8192 ||
+        frame->height > 8192 || (guint64)frame->width * frame->height > 16777216)
+        return FALSE;
+    AVFrame *software = NULL;
+    if (frame->hw_frames_ctx) {
+        software = av_frame_alloc();
+        if (!software || av_hwframe_transfer_data(software, frame, 0) < 0) {
+            av_frame_free(&software);
+            return FALSE;
+        }
+        software->pts = frame->pts;
+        frame = software;
+    }
+    int stride = frame->width * 4;
+    guint8 *pixels = g_try_malloc_n(frame->height, stride);
+    *conversion = sws_getCachedContext(*conversion, frame->width, frame->height, frame->format,
+                                      frame->width, frame->height, AV_PIX_FMT_RGBA,
+                                      SWS_BILINEAR, NULL, NULL, NULL);
+    if (!pixels || !*conversion) {
+        g_free(pixels);
+        av_frame_free(&software);
+        return FALSE;
+    }
+    int rows = sws_scale(*conversion, (const guint8 *const *)frame->data, frame->linesize,
+                         0, frame->height, (guint8 *[4]){pixels}, (int[4]){stride});
+    g_mutex_lock(&c->lock);
+    gboolean accepted = !c->closed && rows == frame->height;
+    if (accepted) {
+        g_free(c->pixels); // Queue is bounded to the latest frame; never grows behind playback.
+        c->pixels = pixels;
+        c->width = frame->width;
+        c->height = frame->height;
+        c->pending_timestamp = frame->pts == AV_NOPTS_VALUE ? 0 : av_rescale(frame->pts, 1000, 1);
+        if (c->trace && ++c->queued <= 3)
+            g_printerr("[ATL video] queue consumer=%p frame=%u size=%dx%d pts=%lld\n", c, c->queued, c->width, c->height, (long long)c->pending_timestamp);
+    }
+    g_mutex_unlock(&c->lock);
+    if (!accepted) g_free(pixels);
+    av_frame_free(&software);
+    return accepted;
+}
+
+static gboolean texture_error(GError **error, const char *message) {
+    g_set_error_literal(error, g_quark_from_static_string("atl-surface-texture"), 1, message);
+    return FALSE;
+}
+
+gboolean atl_texture_consumer_latch(AtlTextureConsumer *c, GError **error) {
+    EGLDisplay display = eglGetCurrentDisplay();
+    EGLContext context = eglGetCurrentContext();
+    if (display == EGL_NO_DISPLAY || context == EGL_NO_CONTEXT)
+        return texture_error(error, "SurfaceTexture.updateTexImage requires a current EGL context");
+    if (!epoxy_has_egl_extension(display, "EGL_KHR_gl_texture_2D_image") ||
+        !epoxy_has_gl_extension("GL_OES_EGL_image_external"))
+        return texture_error(error, "SurfaceTexture requires EGLImage external-texture support");
+    g_mutex_lock(&c->lock);
+    if (c->closed || !c->texture) {
+        g_mutex_unlock(&c->lock);
+        return texture_error(error, "SurfaceTexture is released or detached");
+    }
+    if (!c->pixels) {
+        g_mutex_unlock(&c->lock);
+        return TRUE;
+    }
+    guint8 *pixels = c->pixels;
+    c->pixels = NULL;
+    int width = c->width, height = c->height;
+    unsigned external = c->texture;
+    gint64 timestamp = c->pending_timestamp;
+    g_mutex_unlock(&c->lock);
+
+    GLint texture_2d, texture_external, alignment, unpack_buffer = 0;
+    GLint row_length = 0, skip_rows = 0, skip_pixels = 0;
+    gboolean extended_unpack = epoxy_gl_version() >= 30;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture_2d);
+    glGetIntegerv(GL_TEXTURE_BINDING_EXTERNAL_OES, &texture_external);
+    glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+    if (extended_unpack) {
+        glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+        glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+        glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skip_rows);
+        glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skip_pixels);
+        glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+        glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+    }
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    GLuint staging = 0;
+    glGenTextures(1, &staging);
+    glBindTexture(GL_TEXTURE_2D, staging);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    g_free(pixels);
+    EGLint attributes[] = {EGL_GL_TEXTURE_LEVEL_KHR, 0, EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    EGLImage image = eglCreateImageKHR(display, context, EGL_GL_TEXTURE_2D_KHR,
+                                       (EGLClientBuffer)(uintptr_t)staging, attributes);
+    if (image != EGL_NO_IMAGE) {
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, external);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, image);
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, texture_external);
+        eglDestroyImageKHR(display, image); // Texture sibling retains its storage.
+    }
+    glBindTexture(GL_TEXTURE_2D, texture_2d);
+    glDeleteTextures(1, &staging);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+    if (extended_unpack) {
+        glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buffer);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+        glPixelStorei(GL_UNPACK_SKIP_ROWS, skip_rows);
+        glPixelStorei(GL_UNPACK_SKIP_PIXELS, skip_pixels);
+    }
+    if (image == EGL_NO_IMAGE)
+        return texture_error(error, "Unable to create video EGLImage");
+    g_mutex_lock(&c->lock);
+    c->timestamp = timestamp;
+    if (c->trace && ++c->latched <= 3)
+        g_printerr("[ATL video] latch consumer=%p frame=%u texture=%u pts=%lld\n", c, c->latched, external, (long long)timestamp);
+    g_mutex_unlock(&c->lock);
+    return TRUE;
+}
+
+#define CONSUMER(value) ((AtlTextureConsumer *)(intptr_t)(value))
+JNIEXPORT jlong JNICALL Java_android_graphics_SurfaceTexture_nativeCreate(JNIEnv *env, jclass type, jint texture) {
+    return (jlong)(intptr_t)atl_texture_consumer_new(texture);
+}
+JNIEXPORT jlong JNICALL Java_android_graphics_SurfaceTexture_nativeAcquire(JNIEnv *env, jclass type, jlong handle) {
+    return (jlong)(intptr_t)atl_texture_consumer_ref(CONSUMER(handle));
+}
+JNIEXPORT void JNICALL Java_android_graphics_SurfaceTexture_nativeRelease(JNIEnv *env, jclass type, jlong handle) {
+    atl_texture_consumer_close(CONSUMER(handle));
+    atl_texture_consumer_unref(CONSUMER(handle));
+}
+JNIEXPORT void JNICALL Java_android_graphics_SurfaceTexture_nativeUpdate(JNIEnv *env, jclass type, jlong handle) {
+    GError *error = NULL;
+    if (!atl_texture_consumer_latch(CONSUMER(handle), &error)) {
+        jclass exception = (*env)->FindClass(env, "java/lang/IllegalStateException");
+        (*env)->ThrowNew(env, exception, error->message);
+        (*env)->DeleteLocalRef(env, exception);
+        g_error_free(error);
+    }
+}
+JNIEXPORT jlong JNICALL Java_android_graphics_SurfaceTexture_nativeTimestamp(JNIEnv *env, jclass type, jlong handle) {
+    return atl_texture_consumer_timestamp(CONSUMER(handle));
+}
+JNIEXPORT void JNICALL Java_android_graphics_SurfaceTexture_nativeSetTexture(JNIEnv *env, jclass type, jlong handle, jint texture) {
+    atl_texture_consumer_set_texture(CONSUMER(handle), texture);
+}
