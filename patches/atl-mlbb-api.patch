+/* Opt-in transport metadata only: never log URLs, payloads, headers or error text. */
+struct resource_trace {
+	gint64 started;
+	gchar *host;
+};
+
+static void resource_trace_free(gpointer data)
+{
+	struct resource_trace *trace = data;
+	g_free(trace->host);
+	g_free(trace);
+}
+
+static void resource_trace_failed(WebKitWebResource *resource, GError *error, gpointer data)
+{
+	struct resource_trace *trace = data;
+	g_printerr("ATL_WEBVIEW_NETWORK failed host=%s domain=%s code=%d elapsed_ms=%" G_GINT64_FORMAT "\n",
+	           trace->host, error ? g_quark_to_string(error->domain) : "none", error ? error->code : 0,
+	           (g_get_monotonic_time() - trace->started) / 1000);
+}
+
+static void resource_trace_error_data(GObject *object, GAsyncResult *result, gpointer data)
+{
+	gchar *host = data;
+	GError *error = NULL;
+	gsize length = 0;
+	guchar *body = webkit_web_resource_get_data_finish(WEBKIT_WEB_RESOURCE(object), result, &length, &error);
+	if (body && length <= 65536) {
+		JsonParser *parser = json_parser_new();
+		if (json_parser_load_from_data(parser, (const gchar *)body, length, NULL)) {
+			g_printerr("ATL_WEBVIEW_NETWORK error_body host=%s type=json\n", host);
+			JsonNode *root = json_parser_get_root(parser);
+			if (JSON_NODE_HOLDS_OBJECT(root)) {
+				JsonObject *json = json_node_get_object(root);
+				const char *keys[] = { "code", "ret", "retcode", "status", "error_code" };
+				for (unsigned i = 0; i < G_N_ELEMENTS(keys); ++i) {
+					JsonNode *node = json_object_get_member(json, keys[i]);
+					if (node && JSON_NODE_HOLDS_VALUE(node) && json_node_get_value_type(node) == G_TYPE_INT64) {
+						gint64 code = json_node_get_int(node);
+						if (code >= -999999 && code <= 999999)
+							g_printerr("ATL_WEBVIEW_NETWORK error_code host=%s field=%s value=%" G_GINT64_FORMAT "\n", host, keys[i], code);
+					}
+				}
+			}
+		} else {
+			gboolean method_page = g_strstr_len((const char *)body, length, "405 Not Allowed") ||
+			                       g_strstr_len((const char *)body, length, "Method Not Allowed");
+			g_printerr("ATL_WEBVIEW_NETWORK error_body host=%s type=non-json method_page=%d\n", host, method_page);
+			gchar *lower = g_ascii_strdown((const gchar *)body, length);
+			const char *markers[] = { "acw_sc__v2", "acw_sc__v3", "arg1", "captcha", "challenge", "aliyun", "cloudflare", "cf-chl", "document.cookie", "location.reload", "location.href", "document.location", "_waf", "waf", "geetest", "hcaptcha", "turnstile", "netease", "verify", "verification", "edgeone", "tencent", "turing", "hwwaf", "akamai", "incapsula", "datadome", "bytedance", "secsdk" };
+			g_printerr("ATL_WEBVIEW_NETWORK html_shape host=%s bytes=%" G_GSIZE_FORMAT " script=%d form=%d\n",
+			           host, length, strstr(lower, "<script") != NULL, strstr(lower, "<form") != NULL);
+			for (unsigned i = 0; i < G_N_ELEMENTS(markers); ++i)
+				if (strstr(lower, markers[i]))
+					g_printerr("ATL_WEBVIEW_NETWORK html_marker host=%s marker=%s\n", host, markers[i]);
+			g_free(lower);
+		}
+		g_object_unref(parser);
+	}
+	/* Never print body, parser errors or arbitrary response strings. */
+	if (body) {
+		volatile guchar *clear = body;
+		for (gsize i = 0; i < length; ++i) clear[i] = 0;
+	}
+	g_free(body);
+	g_clear_error(&error);
+	g_free(host);
+}
+
+static void resource_trace_finished(WebKitWebResource *resource, gpointer data)
+{
+	struct resource_trace *trace = data;
+	WebKitURIResponse *response = webkit_web_resource_get_response(resource);
+	g_printerr("ATL_WEBVIEW_NETWORK finished host=%s status=%u elapsed_ms=%" G_GINT64_FORMAT "\n",
+	           trace->host, response ? webkit_uri_response_get_status_code(response) : 0,
+	           (g_get_monotonic_time() - trace->started) / 1000);
+	if (response && webkit_uri_response_get_status_code(response) >= 400) {
+		const char *mime = webkit_uri_response_get_mime_type(response);
+		const char *type = mime && strstr(mime, "json") ? "json" : mime && strstr(mime, "html") ? "html" : "other";
+		SoupMessageHeaders *headers = webkit_uri_response_get_http_headers(response);
+		const char *server = headers ? soup_message_headers_get_one(headers, "Server") : NULL;
+		const char *family = server && !g_ascii_strcasecmp(server, "APISIX") ? "apisix" :
+		                     server && g_str_has_prefix(server, "nginx") ? "nginx" : server ? "other" : "absent";
+		const char *allow = headers ? soup_message_headers_get_one(headers, "Allow") : NULL;
+		g_printerr("ATL_WEBVIEW_NETWORK error_meta host=%s mime=%s server=%s allow_post=%d\n",
+		           trace->host, type, family, allow && strstr(allow, "POST") ? 1 : 0);
+		/* Failed responses only; no successful session/token body is inspected. */
+		webkit_web_resource_get_data(resource, NULL, resource_trace_error_data, g_strdup(trace->host));
+	}
