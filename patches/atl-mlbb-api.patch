+		glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+		glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+		glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+	}
+	fprintf(stderr, "[ATL EGL pixels] frame=%u fbo-status=0x%x rgba-grid=", frame, status);
+	for (int y = 0; y < 3; ++y) {
+		for (int x = 0; x < 3; ++x) {
+			unsigned char rgba[4] = {0};
+			if (status == GL_FRAMEBUFFER_COMPLETE)
+				glReadPixels(x * (surface->width - 1) / 2, y * (surface->height - 1) / 2, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
