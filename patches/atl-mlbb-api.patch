+static void javascript_message(WebKitUserContentManager *manager, JSCValue *value, WrapperWidget *wrapper)
+{
+	if (!jsc_value_is_string(value))
+		return;
+	JNIEnv *env = get_jni_env();
+	if ((*env)->IsSameObject(env, wrapper->jobj, NULL))
+		return;
+	gchar *message = jsc_value_to_string(value);
+	/* Bridge payloads can contain account data. Never print them. */
+	if (message && strlen(message) <= 1024 * 1024) {
+		jstring payload = java_string_from_utf8(env, message);
+		if (payload) J__WebView__internalJavascriptMessage(env, wrapper->jobj, payload);
+		(*env)->DeleteLocalRef(env, payload);
+	}
+	g_free(message);
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionClear(env);
+		g_warning("WebView JavaScript interface callback failed");
+	}
+}
