+/* The desktop entry edits a local draft. The original Unity EditText and OK
+ * button still own the Android edit session and the actual chat submission. */
+typedef struct {
+	GtkWindow *owner, *dialog;
+	GtkOverlay *overlay;
+	GtkWidget *card, *entry, *count, *hint, *send, *source_entry;
+	GWeakRef previous_focus;
+	gulong position_handler;
+	ClbbChatTarget target;
+	int followup_channel;
+	int observed_limit;
+	gint64 observed_limit_since;
+	gboolean send_pending, finishing, followup, followup_cancelled;
+	gboolean restore_draft_when_ready;
+} InlineChat;
+
+typedef struct {
+	ClbbChatTarget target;
+	char *text;
+} ChatDraft;
+
+typedef struct {
+	ClbbChatTarget target;
+	gint64 sent_at;
+	gboolean saw_pending;
+} ChatBatch;
+
+static InlineChat *inline_chat(GtkWindow *owner)
+{
+	return owner ? g_object_get_data(G_OBJECT(owner), "atl-chat-editor") : NULL;
+}
+
+gboolean atl_chat_active(GtkWindow *owner)
+{
+	return inline_chat(owner) != NULL;
+}
+
+gboolean atl_chat_waiting(GtkWindow *owner)
+{
+	InlineChat *chat = inline_chat(owner);
+	return chat && !chat->dialog;
+}
+
+void atl_chat_abort_pending(GtkWindow *owner)
+{
+	if (atl_chat_waiting(owner))
+		g_object_set_data(G_OBJECT(owner), "atl-chat-editor", NULL);
+}
+
+static void free_draft(gpointer data)
+{
+	ChatDraft *draft = data;
+	g_free(draft->text);
+	g_free(draft);
+}
+
+static gboolean same_draft(const ChatDraft *draft, const ClbbChatTarget *target)
+{
+	return draft && draft->target.owner == target->owner && draft->target.site == target->site &&
+	       draft->target.channel == target->channel;
+}
+
+static void save_draft(GtkWindow *owner, const ClbbChatTarget *target, char *text)
+{
+	ChatDraft *draft = g_new(ChatDraft, 1);
+	*draft = (ChatDraft){*target, text};
+	g_object_set_data_full(G_OBJECT(owner), "atl-chat-draft", draft, free_draft);
+}
+
+gboolean atl_chat_batch_pending(GtkWindow *owner)
+{
+	return g_object_get_data(G_OBJECT(owner), "atl-chat-batch") != NULL;
+}
+
+void atl_chat_cancel_batch(GtkWindow *owner)
+{
+	g_object_set_data(G_OBJECT(owner), "atl-chat-batch", NULL);
+	InlineChat *chat = inline_chat(owner);
+	if (chat && chat->followup)
+		chat->followup_cancelled = TRUE;
+}
+
+static void free_inline_chat(gpointer data)
+{
+	InlineChat *chat = data;
+	g_signal_handler_disconnect(chat->overlay, chat->position_handler);
+	if (gtk_widget_get_parent(chat->card) == GTK_WIDGET(chat->overlay))
+		gtk_overlay_remove_overlay(chat->overlay, chat->card);
+	GtkWidget *previous = g_weak_ref_get(&chat->previous_focus);
+	if (previous && gtk_widget_get_mapped(previous))
+		gtk_widget_grab_focus(previous);
+	g_clear_object(&previous);
+	g_weak_ref_clear(&chat->previous_focus);
+	g_object_unref(chat->card);
+	g_object_unref(chat->overlay);
+	g_free(chat);
+}
+
+static gboolean position_inline_chat(GtkOverlay *overlay, GtkWidget *child, GdkRectangle *out, InlineChat *chat)
+{
+	if (child != chat->card)
+		return FALSE;
+	gboolean (*content_rect)(GtkWidget *, graphene_rect_t *) =
+		dlsym(RTLD_DEFAULT, "clbb_viewport_get_content_rect");
+	graphene_rect_t area;
+	if (!content_rect || !content_rect(gtk_overlay_get_child(overlay), &area))
+		return FALSE;
+	int natural_height = 0;
+	gtk_widget_measure(child, GTK_ORIENTATION_VERTICAL, -1, NULL, &natural_height, NULL, NULL);
+	int horizontal_margin = MIN(16, (int)area.size.width / 20);
+	out->width = MIN(505, (int)area.size.width - 2 * horizontal_margin);
+	out->height = natural_height;
+	out->x = area.origin.x + horizontal_margin;
+	if (chat->target.site == 1)
+		out->x += (int)area.size.width - out->width - 2 * horizontal_margin;
+	out->y = area.origin.y + (int)(area.size.height * (chat->target.site == 1 ? .69 : 1.))
+	         - out->height - 12;
+	return out->width > 0 && out->height > 0;
+}
+
+static gboolean query_chat_site(GtkWindow *owner, ClbbChatTarget *target, gboolean live)
+{
+	gboolean (*chat_site)(GtkWindow *, ClbbChatTarget *, gboolean) =
+		dlsym(RTLD_DEFAULT, "clbb_chat_site");
+	return chat_site && chat_site(owner, target, live);
+}
+
+static ClbbTextLimits chat_limits(InlineChat *chat)
+{
+	int native = chat->source_entry ?
+		clbb_text_limits(GTK_EDITABLE(chat->source_entry)).utf16 : -1;
+	return (ClbbTextLimits){native, chat->target.limit};
+}
+
+static void update_chat_count(GtkEditable *editable, InlineChat *chat)
+{
+	const char *text = gtk_editable_get_text(editable);
+	ClbbTextLimits limits = chat_limits(chat);
+	ClbbChatParts parts = clbb_chat_parts(text, limits);
+	gsize length = strlen(text);
+	gboolean invalid = !parts.first && clbb_text_fit(text, length, limits) != length;
+	char count[48];
+	if (parts.second)
+		g_snprintf(count, sizeof(count), "%" G_GSIZE_FORMAT " + %" G_GSIZE_FORMAT " / %d",
+		           parts.first_bytes, parts.second_bytes, limits.bytes);
+	else
+		g_snprintf(count, sizeof(count), "%" G_GSIZE_FORMAT "/%d",
+		           invalid ? length : parts.first_bytes, limits.bytes);
+	gtk_label_set_text(GTK_LABEL(chat->count), count);
+	gtk_label_set_text(GTK_LABEL(chat->hint), invalid
+		? "Нужно уложиться в два сообщения целыми словами." : "");
+	gtk_widget_set_visible(chat->hint, invalid);
+	gtk_widget_set_sensitive(chat->send, parts.first != NULL);
+}
+
+static void chat_entry_changed(GtkEditable *editable, InlineChat *chat)
+{
+	chat->restore_draft_when_ready = FALSE;
+	update_chat_count(editable, chat);
+}
+
+static void update_chat_limit(InlineChat *chat)
+{
+	update_chat_count(GTK_EDITABLE(chat->entry), chat);
+}
+
+void atl_chat_sync_limit(GtkWindow *owner, const ClbbChatTarget *target)
+{
+	InlineChat *chat = inline_chat(owner);
+	if (!chat || chat->finishing || chat->target.owner != target->owner ||
+	    chat->target.site != target->site)
+		return;
+	if (chat->restore_draft_when_ready) {
+		ChatDraft *draft = g_object_get_data(G_OBJECT(owner), "atl-chat-draft");
+		if (same_draft(draft, target)) {
+			chat->restore_draft_when_ready = FALSE;
+			gtk_editable_set_text(GTK_EDITABLE(chat->entry), draft->text);
+			gtk_editable_set_position(GTK_EDITABLE(chat->entry), -1);
+		}
+	}
+	gint64 now = g_get_monotonic_time();
+	if (chat->observed_limit != target->limit) {
+		chat->observed_limit = target->limit;
+		chat->observed_limit_since = now;
+	}
+	// During initialization UI_Chat can briefly report the cap of another tab.
+	// Apply tighter limits immediately and wait for a sustained higher limit.
+	if (target->limit < chat->target.limit ||
+	    (target->limit > chat->target.limit && now - chat->observed_limit_since >= 180000)) {
+		chat->target.limit = target->limit;
+		update_chat_limit(chat);
+	}
+}
+
+void atl_chat_source_limit_changed(GtkWidget *text)
+{
+	GtkRoot *root = gtk_widget_get_root(text);
+	if (!GTK_IS_WINDOW(root))
+		return;
+	InlineChat *chat = inline_chat(gtk_window_get_transient_for(GTK_WINDOW(root)));
+	if (chat && chat->source_entry == text)
+		update_chat_limit(chat);
+}
+
+static void refresh_chat_channel(InlineChat *chat)
+{
+	ClbbChatTarget live;
+	// The ranked room can finish selecting its Team tab after the editor
+	// opens. Use its actual channel before indexing or discarding a draft.
+	if (query_chat_site(chat->owner, &live, TRUE) &&
+	    live.site == chat->target.site && live.owner == chat->target.owner) {
+		chat->target.channel = live.channel;
+		atl_chat_sync_limit(chat->owner, &live);
+	}
+}
+
+static void dismiss_inline(InlineChat *chat)
+{
+	chat->finishing = TRUE;
+	JNIEnv *env = get_jni_env();
+	jobject peer = g_object_get_data(G_OBJECT(chat->dialog), "atl-dialog-peer");
+	jclass type = (*env)->GetObjectClass(env, peer);
+	jmethodID cancel = (*env)->GetMethodID(env, type, "cancel", "()V");
+	if (cancel)
+		(*env)->CallVoidMethod(env, peer, cancel);
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionDescribe(env);
+	(*env)->DeleteLocalRef(env, type);
+}
+
+static void submit_inline(GtkWidget *widget, InlineChat *chat)
+{
+	if (chat->finishing)
+		return;
+	refresh_chat_channel(chat);
+	ClbbChatParts parts = clbb_chat_parts(gtk_editable_get_text(GTK_EDITABLE(chat->entry)),
+	                                    chat_limits(chat));
+	if (!parts.first)
+		return;
+	if (!chat->dialog) {
+		chat->send_pending = TRUE;
+		return;
+	}
+	TextDialog controls = {0};
+	find_text_controls(gtk_window_get_child(chat->dialog), &controls);
+	if (controls.texts != 1 || controls.buttons != 1 || !gtk_widget_is_sensitive(controls.confirm))
+		return;
+	if (chat->followup || parts.second) {
+		ClbbChatTarget live;
+		gboolean same_target = gtk_window_is_active(chat->owner) &&
+			query_chat_site(chat->owner, &live, TRUE) && live.site == chat->target.site &&
+			live.owner == chat->target.owner && live.channel == chat->target.channel &&
+			live.ready != 0;
+		if (chat->followup && (!same_target || live.ready != 2 || chat->followup_cancelled ||
+		                      live.channel != chat->followup_channel ||
+		                      parts.second || parts.first_bytes > (gsize)live.limit)) {
+			dismiss_inline(chat);
+			return;
+		}
+		if (!same_target || parts.first_bytes > (gsize)live.limit ||
+		    parts.second_bytes > (gsize)live.limit) {
+			gtk_label_set_text(GTK_LABEL(chat->hint), "Дождитесь готовности игрового чата.");
+			gtk_widget_set_visible(chat->hint, TRUE);
+			return;
+		}
+	}
+	g_autofree char *message = g_strndup(parts.first, parts.first_bytes);
+	g_autoptr(GtkWidget) confirm = g_object_ref(controls.confirm);
+	g_autoptr(GtkWidget) source = g_object_ref(controls.text);
+	gtk_editable_set_text(GTK_EDITABLE(source), message);
+	if (g_strcmp0(gtk_editable_get_text(GTK_EDITABLE(source)), message) != 0)
+		return;
+	chat->finishing = TRUE;
+	gtk_widget_set_sensitive(chat->card, FALSE);
+	if (parts.second) {
+		save_draft(chat->owner, &chat->target, g_strndup(parts.second, parts.second_bytes));
+		ChatBatch *batch = g_new(ChatBatch, 1);
+		*batch = (ChatBatch){.target = chat->target, .sent_at = g_get_monotonic_time()};
+		g_object_set_data_full(G_OBJECT(chat->owner), "atl-chat-batch", batch, g_free);
+	} else if (same_draft(g_object_get_data(G_OBJECT(chat->owner), "atl-chat-draft"), &chat->target)) {
+		g_object_set_data(G_OBJECT(chat->owner), "atl-chat-draft", NULL);
+	}
+	g_signal_emit_by_name(confirm, "clicked");
+}
+
+static void cancel_inline(GtkWidget *widget, InlineChat *chat)
+{
+	if (chat->finishing)
+		return;
+	if (!chat->followup) {
+		refresh_chat_channel(chat);
+		if (!chat->restore_draft_when_ready)
+			save_draft(chat->owner, &chat->target,
+			           g_strdup(gtk_editable_get_text(GTK_EDITABLE(chat->entry))));
+	}
+	if (!chat->dialog) {
+		atl_chat_abort_pending(chat->owner);
+		return;
+	}
+	dismiss_inline(chat);
+}
