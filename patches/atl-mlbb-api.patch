index 0000000..cab307d
--- /dev/null
+++ b/src/api-impl/android/net/http/SslCertificate.java
@@ -0,0 +1,79 @@
+package android.net.http;
+
+import java.security.cert.X509Certificate;
+import java.text.ParseException;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Certificate metadata only; no certificate validation or trust overrides. */
+public class SslCertificate {
+	private final DName issuedTo;
+	private final DName issuedBy;
+	private final Date validNotBefore;
+	private final Date validNotAfter;
+	private X509Certificate certificate;
+
+	public SslCertificate(X509Certificate certificate) {
+		this(certificate.getSubjectX500Principal().getName(), certificate.getIssuerX500Principal().getName(),
+		     certificate.getNotBefore(), certificate.getNotAfter());
+		this.certificate = certificate;
+	}
+
+	public SslCertificate(String issuedTo, String issuedBy, Date validNotBefore, Date validNotAfter) {
+		this.issuedTo = new DName(issuedTo);
+		this.issuedBy = new DName(issuedBy);
+		this.validNotBefore = copy(validNotBefore);
+		this.validNotAfter = copy(validNotAfter);
+	}
+
+	public SslCertificate(String issuedTo, String issuedBy, String validNotBefore, String validNotAfter) {
+		this(issuedTo, issuedBy, parse(validNotBefore), parse(validNotAfter));
+	}
+
+	private static Date copy(Date date) { return date == null ? null : new Date(date.getTime()); }
+
+	private static SimpleDateFormat dateFormat() {
+		SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd HH:mm:ssZ", Locale.US);
+		format.setLenient(false);
+		return format;
+	}
+
+	private static Date parse(String value) {
+		if (value == null || value.isEmpty())
+			return null;
+		try {
+			return dateFormat().parse(value);
+		} catch (ParseException error) {
+			return null;
+		}
+	}
+
+	public DName getIssuedTo() { return issuedTo; }
+	public DName getIssuedBy() { return issuedBy; }
+	public Date getValidNotBeforeDate() { return copy(validNotBefore); }
+	public Date getValidNotAfterDate() { return copy(validNotAfter); }
+	public String getValidNotBefore() { return validNotBefore == null ? "" : dateFormat().format(validNotBefore); }
+	public String getValidNotAfter() { return validNotAfter == null ? "" : dateFormat().format(validNotAfter); }
+	public X509Certificate getX509Certificate() { return certificate; }
+
+	@Override
+	public String toString() { return "Issued to: " + issuedTo.getDName() + "; Issued by: " + issuedBy.getDName(); }
+
+	public class DName {
+		private final String name;
+
+		public DName(String name) { this.name = name == null ? "" : name; }
+		public String getDName() { return name; }
+		public String getCName() { return component("CN"); }
+		public String getOName() { return component("O"); }
+		public String getUName() { return component("OU"); }
+
+		private String component(String key) {
+			Matcher matcher = Pattern.compile("(?:^|,)\\s*" + key + "=((?:\\\\.|[^,])*)", Pattern.CASE_INSENSITIVE).matcher(name);
+			return matcher.find() ? matcher.group(1).replaceAll("\\\\(.)", "$1") : "";
+		}
+	}
+}
diff --git a/src/api-impl/android/net/http/SslError.java b/src/api-impl/android/net/http/SslError.java
new file mode 100644
index 0000000..b317b47
--- /dev/null
+++ b/src/api-impl/android/net/http/SslError.java
@@ -0,0 +1,61 @@
+package android.net.http;
+
+import java.security.cert.X509Certificate;
+
+/** Description of certificate validation errors; performs no trust decisions. */
+public class SslError {
+	public static final int SSL_NOTYETVALID = 0;
+	public static final int SSL_EXPIRED = 1;
+	public static final int SSL_IDMISMATCH = 2;
+	public static final int SSL_UNTRUSTED = 3;
+	public static final int SSL_DATE_INVALID = 4;
+	public static final int SSL_INVALID = 5;
+	public static final int SSL_MAX_ERROR = 6;
+	private int errors;
+	private final SslCertificate certificate;
+	private final String url;
+
+	public SslError(int error, SslCertificate certificate) {
+		this(error, certificate, "");
+	}
+
+	public SslError(int error, SslCertificate certificate, String url) {
+		this.certificate = certificate;
+		this.url = url == null ? "" : url;
+		addError(error);
+	}
+
+	public SslError(int error, X509Certificate certificate) {
+		this(error, certificate, "");
+	}
+
+	public SslError(int error, X509Certificate certificate, String url) {
+		this(error, certificate == null ? null : new SslCertificate(certificate), url);
+	}
+
+	public boolean addError(int error) {
+		if (error < 0 || error >= SSL_MAX_ERROR)
+			return false;
+		errors |= 1 << error;
+		return true;
+	}
+
+	public boolean hasError(int error) {
+		return error >= 0 && error < SSL_MAX_ERROR && (errors & (1 << error)) != 0;
+	}
+
+	public int getPrimaryError() {
+		for (int error = SSL_MAX_ERROR - 1; error >= 0; --error)
+			if (hasError(error))
+				return error;
+		return -1;
+	}
+
+	public SslCertificate getCertificate() { return certificate; }
+	public String getUrl() { return url; }
+
+	@Override
+	public String toString() {
+		return "primary error: " + getPrimaryError() + " certificate: " + certificate + " on URL: " + url;
+	}
+}
