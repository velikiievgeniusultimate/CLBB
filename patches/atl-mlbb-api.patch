+static void rotate_default_framebuffer(GLuint previous, GLuint next)
+{
+	const char *version = (const char *)glGetString(GL_VERSION);
+	gboolean separate = version && (strstr(version, "OpenGL ES 3.") ||
+	                    (!strstr(version, "OpenGL ES") && version[0] >= '3'));
