+static void clbb_login_sent(WebKitWebResource *resource, WebKitURIRequest *request,
+                            WebKitURIResponse *redirect, gpointer unused)
+{
+	(void)unused;
+	g_object_set_data(G_OBJECT(resource), "clbb-login-last-method", (gpointer)request_method_label(request));
+	if (redirect)
+		g_object_set_data(G_OBJECT(resource), "clbb-login-last-redirect",
+		                  GUINT_TO_POINTER(webkit_uri_response_get_status_code(redirect)));
+}
+
+static void clbb_login_response(WebKitWebResource *resource, WebKitWebView *view)
+{
+	WebKitURIResponse *response = webkit_web_resource_get_response(resource);
+	if (!response || webkit_uri_response_get_status_code(response) != 405 ||
+	    !clbb_login_uri(webkit_uri_response_get_uri(response), FALSE) ||
+	    g_object_get_data(G_OBJECT(resource), "clbb-login-document") != webkit_web_view_get_main_resource(view) ||
+	    !clbb_login_uri(webkit_web_view_get_uri(view), TRUE)) return;
+	/* Fixed categories only. No account data, URLs or header values enter this log. */
+	GObject *item = G_OBJECT(resource);
+	const char *initial = g_object_get_data(item, "clbb-login-initial-method");
+	const char *last = g_object_get_data(item, "clbb-login-last-method");
+	SoupMessageHeaders *headers = webkit_uri_response_get_http_headers(response);
+	const char *allow = !headers || !soup_message_headers_get_list(headers, "Allow") ? "not-visible" :
+	                    soup_message_headers_header_contains(headers, "Allow", "POST") ? "includes-post" : "other";
+	const char *mime = webkit_uri_response_get_mime_type(response);
+	g_printerr("CLBB_LOGIN_HTTP status=405 initial=%s final=%s last_redirect=%u allow=%s format=%s\n",
+	           initial, last ? last : "unobserved",
+	           GPOINTER_TO_UINT(g_object_get_data(item, "clbb-login-last-redirect")), allow,
+	           !g_strcmp0(mime, "text/html") ? "html" : !g_strcmp0(mime, "application/json") ? "json" : "other");
+	webkit_web_view_evaluate_javascript(view, "window.dispatchEvent(new Event('clbb-login-unavailable'))",
+	                                    -1, NULL, NULL, NULL, NULL, NULL);
+}
+
+static void clbb_login_resource(WebKitWebView *view, WebKitWebResource *resource,
+                                  WebKitURIRequest *request, gpointer unused)
+{
+	(void)unused;
+	if (!clbb_login_uri(webkit_uri_request_get_uri(request), FALSE) ||
+	    !clbb_login_uri(webkit_web_view_get_uri(view), TRUE)) return;
+	WebKitWebResource *page = webkit_web_view_get_main_resource(view);
+	if (!page || page == resource) return;
+	g_object_set_data_full(G_OBJECT(resource), "clbb-login-document", g_object_ref(page), g_object_unref);
+	g_object_set_data(G_OBJECT(resource), "clbb-login-initial-method", (gpointer)request_method_label(request));
+	g_signal_connect(resource, "sent-request", G_CALLBACK(clbb_login_sent), NULL);
+	g_signal_connect_object(resource, "finished", G_CALLBACK(clbb_login_response), view, 0);
+}
