+
+static gboolean cookie_policy_result(JNIEnv *env, gboolean success, GError *error)
+{
+	if (!success) {
+		jclass type = (*env)->FindClass(env, "java/lang/UnsupportedOperationException");
+		if (type) (*env)->ThrowNew(env, type, "GTK backend cannot simultaneously apply different cookie policies to WebViews sharing a network session");
+		(*env)->DeleteLocalRef(env, type);
+	}
+	g_clear_error(&error);
