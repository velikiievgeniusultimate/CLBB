+static GtkWidget *find_game_surface(GtkWidget *root) {
+    if (!gtk_widget_get_mapped(root)) return NULL;
+    GtkWidget *best = NULL;
+    int area = 0;
+    if (SURFACE_VIEW_IS_WIDGET(root)) {
+        best = root;
+        area = gtk_widget_get_width(root) * gtk_widget_get_height(root);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child(root); child;
+         child = gtk_widget_get_next_sibling(child)) {
+        GtkWidget *found = find_game_surface(child);
+        if (found) {
+            int size =
+                gtk_widget_get_width(found) * gtk_widget_get_height(found);
+            if (size > area) {
+                best = found;
+                area = size;
+            }
+        }
+    }
+    return best;
+}
+static GtkWidget *game_surface(GtkWidget *root) {
