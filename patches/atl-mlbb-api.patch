+/* Dialog decor uses Android logical coordinates just like the main activity.
+ * Reuse the launcher's viewport so large logical displays fit the desktop. */
+static void set_dialog_content(JNIEnv *env, GtkWindow *dialog, GtkWidget *content)
+{
+	GtkWidget *old = gtk_window_get_child(dialog);
+	if (content == old || (old && gtk_widget_get_parent(content) == old))
+		return;
+	GtkWidget *(*viewport_new)(GtkWidget *, int, int) =
+		dlsym(RTLD_DEFAULT, "clbb_viewport_new");
+	jclass display = (*env)->FindClass(env, "android/view/Display");
+	if (!display) return;
+	jfieldID width_field = (*env)->GetStaticFieldID(env, display, "window_width", "I");
+	jfieldID height_field = (*env)->GetStaticFieldID(env, display, "window_height", "I");
+	if (!width_field || !height_field) {
+		(*env)->DeleteLocalRef(env, display);
+		return;
+	}
+	int width = (*env)->GetStaticIntField(env, display, width_field);
+	int height = (*env)->GetStaticIntField(env, display, height_field);
+	(*env)->DeleteLocalRef(env, display);
+	if (viewport_new && width > 0 && width <= 16384 && height > 0 && height <= 16384)
+		content = viewport_new(content, width, height);
+	gtk_window_set_child(dialog, content);
+}
