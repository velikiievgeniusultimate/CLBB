new file mode 100644
index 0000000..34e5aaa
--- /dev/null
+++ b/src/api-impl/android/webkit/SslErrorHandler.java
@@ -0,0 +1,31 @@
+package android.webkit;
+
+import android.os.Handler;
+import android.os.Looper;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** SSL error callback handle. TLS exceptions are not supported by this runtime. */
+public class SslErrorHandler extends Handler {
+	private final Runnable cancelAction;
+	private final AtomicBoolean resolved = new AtomicBoolean();
+
+	public SslErrorHandler() {
+		this(null);
+	}
+
+	/** Runtime hook for cancelling the underlying failed request. */
+	public SslErrorHandler(Runnable cancelAction) {
+		super(Looper.getMainLooper());
+		this.cancelAction = cancelAction;
+	}
+
+	/** Fail closed: this implementation never authorizes an invalid certificate. */
+	public void proceed() {
+		cancel();
+	}
+
+	public void cancel() {
+		if (resolved.compareAndSet(false, true) && cancelAction != null)
+			cancelAction.run();
+	}
+}
diff --git a/src/api-impl/android/widget/VideoView.java b/src/api-impl/android/widget/VideoView.java
new file mode 100644
index 0000000..36e61bd
--- /dev/null
