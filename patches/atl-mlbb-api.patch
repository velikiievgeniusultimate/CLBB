+/* Status-only feedback for official login forms, tied to the originating document. */
+static gboolean clbb_login_uri(const char *text, gboolean login_form)
+{
+	if (!text) return FALSE;
+	GUri *uri = g_uri_parse(text, G_URI_FLAGS_NONE, NULL);
+	if (!uri) return FALSE;
+	const char *path = g_uri_get_path(uri);
+	const char *host = login_form ? "mtacc.mobilelegends.com" : "accountmtapi.mobilelegends.com";
+	gboolean matches = !g_strcmp0(g_uri_get_scheme(uri), "https") &&
+	                   !g_strcmp0(g_uri_get_host(uri), host) && !g_uri_get_userinfo(uri) &&
+	                   (g_uri_get_port(uri) == -1 || g_uri_get_port(uri) == 443) &&
+	                   (login_form ? (!g_strcmp0(path, "/v3.0/inapp/login-new") ||
+	                                 !g_strcmp0(path, "/v3.0/inapp/login") ||
+	                                 !g_strcmp0(path, "/v3.0/inapp/loginbyemail")) : !g_strcmp0(path, "/"));
+	g_uri_unref(uri);
+	return matches;
+}
