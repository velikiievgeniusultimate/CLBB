+static gboolean inline_escape(GtkEventControllerKey *controller, guint keyval, guint code,
+	                           GdkModifierType modifiers, InlineChat *chat)
+{
+	if (keyval != GDK_KEY_Escape)
+		return FALSE;
+	cancel_inline(NULL, chat);
+	return TRUE;
+}
