+JNIEXPORT jstring JNICALL Java_android_opengl_GLES20_glGetProgramInfoLog(JNIEnv *env, jclass this, jint program)
+{
+	GLint size = 0;
+	glGetProgramiv((GLuint)program, GL_INFO_LOG_LENGTH, &size);
+	if (size <= 0)
