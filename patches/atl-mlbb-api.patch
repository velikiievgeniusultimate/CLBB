+/* Unity opens an Android EditText and one confirmation button for its soft
+ * keyboard. The button completes the game's edit session and sends chat. */
+typedef struct {
+	GtkWidget *text, *confirm;
+	unsigned texts, buttons;
+} TextDialog;
+
+static void find_text_controls(GtkWidget *widget, TextDialog *result)
+{
+	if (!widget || !gtk_widget_get_visible(widget))
+		return;
+	if (GTK_IS_TEXT(widget)) {
+		result->text = widget;
+		result->texts++;
+	} else if (GTK_IS_BUTTON(widget)) {
+		result->confirm = widget;
+		result->buttons++;
+	} else {
+		for (GtkWidget *child = gtk_widget_get_first_child(widget); child;
+		     child = gtk_widget_get_next_sibling(child))
+			find_text_controls(child, result);
+	}
+}
+
+static void text_dialog_unmap(GtkWidget *dialog, gpointer unused)
+{
+	GtkWindow *owner = gtk_window_get_transient_for(GTK_WINDOW(dialog));
+	if (owner && g_object_get_data(G_OBJECT(owner), "atl-text-dialog") == dialog)
+		g_object_set_data(G_OBJECT(owner), "atl-text-dialog", NULL);
+}
+
+static gboolean is_unity_dialog(JNIEnv *env, jobject dialog)
+{
+	jclass type = (*env)->GetObjectClass(env, dialog);
+	jstring name = J__Class__getName(env, type);
+	const char *utf8 = name ? (*env)->GetStringUTFChars(env, name, NULL) : NULL;
+	gboolean unity = utf8 && g_str_has_prefix(utf8, "com.unity3d.player.");
+	if (utf8)
+		(*env)->ReleaseStringUTFChars(env, name, utf8);
+	(*env)->DeleteLocalRef(env, name);
+	(*env)->DeleteLocalRef(env, type);
+	return unity;
+}
+
+static GtkWidget *text_dialog_prepare(GtkWindow *dialog)
+{
+	if (!g_object_get_data(G_OBJECT(dialog), "atl-unity-dialog"))
+		return NULL;
+	GtkWidget *content = gtk_window_get_child(dialog);
+	GtkWindow *owner = gtk_window_get_transient_for(dialog);
+	if (!content || !owner)
+		return NULL;
+	TextDialog controls = {0};
+	find_text_controls(content, &controls);
+	if (controls.texts != 1 || controls.buttons != 1)
+		return NULL;
+	gtk_window_set_modal(dialog, TRUE);
+	g_object_set_data(G_OBJECT(owner), "atl-text-dialog", dialog);
+	g_object_set_data_full(G_OBJECT(dialog), "atl-editor-last-submit", g_new0(gint64, 1), g_free);
+	return controls.text;
+}
+
+gboolean atl_text_input_active(GtkWindow *owner)
+{
+	GtkWidget *dialog = g_object_get_data(G_OBJECT(owner), "atl-text-dialog");
+	if (atl_chat_active(owner) || (dialog && gtk_widget_get_mapped(dialog)))
+		return TRUE;
+	GtkWidget *focus = gtk_window_get_focus(owner);
+	return GTK_IS_EDITABLE(focus) && gtk_widget_get_mapped(focus) &&
+	       gtk_editable_get_editable(GTK_EDITABLE(focus));
+}
+
+gboolean atl_text_dialog_submit(GtkWidget *text)
+{
+	GtkRoot *root = gtk_widget_get_root(text);
+	if (!GTK_IS_WINDOW(root) || !g_object_get_data(G_OBJECT(root), "atl-unity-dialog"))
+		return FALSE;
+	GtkWindow *dialog = GTK_WINDOW(root);
+	GtkWindow *owner = gtk_window_get_transient_for(dialog);
+	if (!owner || g_object_get_data(G_OBJECT(owner), "atl-text-dialog") != dialog)
+		return FALSE;
+	gint64 *last_submit = g_object_get_data(G_OBJECT(dialog), "atl-editor-last-submit");
+	gint64 now = g_get_monotonic_time();
