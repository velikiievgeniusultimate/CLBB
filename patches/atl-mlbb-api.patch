diff --git a/src/api-impl-jni/widgets/webview_cookie_policy.c b/src/api-impl-jni/widgets/webview_cookie_policy.c
new file mode 100644
index 0000000..4089c5b
--- /dev/null
+++ b/src/api-impl-jni/widgets/webview_cookie_policy.c
@@ -0,0 +1,82 @@
+/* GTK adapter. Android's flag is per view; WebKit's cookie policy is per session.
+ * Honour the app's setting and reject unsupported simultaneous mixed policies
+ * rather than silently changing the policy of another active view. */
+#include "webview_cookie_policy.h"
+
+typedef struct {
+    WebKitNetworkSession *session;
+    gboolean third_party;
+    gboolean active;
+} CookiePolicy;
+
+static GList *policies;
+
+static void policy_free(gpointer data)
+{
+    CookiePolicy *policy = data;
+    policies = g_list_remove(policies, policy);
+    g_object_unref(policy->session);
+    g_free(policy);
+}
+
+static CookiePolicy *policy_for(WebKitWebView *view)
+{
+    CookiePolicy *policy = g_object_get_data(G_OBJECT(view), "atl-cookie-policy");
+    if (!policy) {
+        policy = g_new0(CookiePolicy, 1);
+        policy->session = g_object_ref(webkit_web_view_get_network_session(view));
+        policies = g_list_prepend(policies, policy);
+        g_object_set_data_full(G_OBJECT(view), "atl-cookie-policy", policy, policy_free);
+    }
+    return policy;
+}
+
+static gboolean compatible(CookiePolicy *policy, gboolean accept, GError **error)
+{
+    for (GList *item = policies; item; item = item->next) {
+        CookiePolicy *other = item->data;
+        if (other != policy && other->session == policy->session && other->active &&
+            other->third_party != accept) {
+            g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                "GTK WebViews sharing a network session cannot use simultaneous different third-party cookie policies");
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static void apply(CookiePolicy *policy)
+{
+    webkit_cookie_manager_set_accept_policy(webkit_network_session_get_cookie_manager(policy->session),
+        policy->third_party ? WEBKIT_COOKIE_POLICY_ACCEPT_ALWAYS : WEBKIT_COOKIE_POLICY_ACCEPT_NO_THIRD_PARTY);
+}
+
+gboolean atl_webview_cookie_policy_get(WebKitWebView *view)
+{
+    return policy_for(view)->third_party;
+}
+
+gboolean atl_webview_cookie_policy_set(WebKitWebView *view, gboolean accept, GError **error)
+{
+    CookiePolicy *policy = policy_for(view);
+    accept = !!accept;
+    if (policy->active && !compatible(policy, accept, error)) return FALSE;
+    policy->third_party = accept;
+    if (policy->active) apply(policy);
+    return TRUE;
+}
+
+gboolean atl_webview_cookie_policy_activate(WebKitWebView *view, GError **error)
+{
+    CookiePolicy *policy = policy_for(view);
+    if (!compatible(policy, policy->third_party, error)) return FALSE;
+    apply(policy);
+    policy->active = TRUE;
+    return TRUE;
+}
+
+void atl_webview_cookie_policy_release(WebKitWebView *view)
+{
+    CookiePolicy *policy = g_object_get_data(G_OBJECT(view), "atl-cookie-policy");
+    if (policy) policy->active = FALSE;
+}
