index 0000000..d1f507f
--- /dev/null
+++ b/src/api-impl/android/media/audiofx/AutomaticGainControl.java
@@ -0,0 +1,8 @@
+package android.media.audiofx;
+
+/** No Android hardware preprocessing effect is exposed by this host backend. */
+public final class AutomaticGainControl extends AudioEffect {
+ private AutomaticGainControl() {}
+ public static boolean isAvailable() { return false; }
+ public static AutomaticGainControl create(int audioSession) { return null; }
+}
diff --git a/src/api-impl/android/net/http/SslCertificate.java b/src/api-impl/android/net/http/SslCertificate.java
