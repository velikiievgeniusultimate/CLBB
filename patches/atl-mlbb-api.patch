diff --git a/src/web-process-extension/atl-android-request.c b/src/web-process-extension/atl-android-request.c
new file mode 100644
index 0000000..9891582
--- /dev/null
+++ b/src/web-process-extension/atl-android-request.c
@@ -0,0 +1,62 @@
+/* Android WebView's default request identity. No application-specific policy. */
+#include <webkit/webkit-web-process-extension.h>
+
+static gboolean valid_package_name(const char *name)
+{
+    gboolean first = TRUE;
+    if (!name || !*name) return FALSE;
+    for (const unsigned char *p = (const unsigned char *)name; *p; ++p) {
+        if (*p == '.') {
+            if (first) return FALSE;
+            first = TRUE;
+        } else {
+            if (!(g_ascii_isalpha(*p) || *p == '_' || (!first && g_ascii_isdigit(*p))))
+                return FALSE;
+            first = FALSE;
+        }
+    }
+    return !first;
+}
+
+static gboolean add_request_identity(WebKitWebPage *page, WebKitURIRequest *request,
+                                     WebKitURIResponse *redirect_response, gpointer data)
+{
+    (void)page;
+    (void)redirect_response;
+    char *scheme = g_uri_parse_scheme(webkit_uri_request_get_uri(request));
+    gboolean http = scheme && (!g_ascii_strcasecmp(scheme, "http") ||
+                               !g_ascii_strcasecmp(scheme, "https"));
+    g_free(scheme);
+    if (!http) return FALSE;
+
+    SoupMessageHeaders *headers = webkit_uri_request_get_http_headers(request);
+    /* Header names are case insensitive; preserve even an explicitly empty value. */
+    if (headers && !soup_message_headers_get_one(headers, "X-Requested-With"))
+        soup_message_headers_replace(headers, "X-Requested-With", data);
+    return FALSE;
+}
+
+static void free_package_name(gpointer data, GClosure *closure)
+{
+    (void)closure;
+    g_free(data);
+}
+
+static void page_created(WebKitWebProcessExtension *extension, WebKitWebPage *page,
+                         gpointer data)
+{
+    (void)extension;
+    g_signal_connect_data(page, "send-request", G_CALLBACK(add_request_identity),
+                          g_strdup(data), free_package_name, 0);
+}
+
+G_MODULE_EXPORT void webkit_web_process_extension_initialize_with_user_data(
+    WebKitWebProcessExtension *extension, const GVariant *user_data)
+{
+    if (!user_data || !g_variant_is_of_type((GVariant *)user_data, G_VARIANT_TYPE_STRING))
+        return;
+    const char *package = g_variant_get_string((GVariant *)user_data, NULL);
+    if (!valid_package_name(package)) return;
+    g_signal_connect_data(extension, "page-created", G_CALLBACK(page_created),
+                          g_strdup(package), free_package_name, 0);
+}
