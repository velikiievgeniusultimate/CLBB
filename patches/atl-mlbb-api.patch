+	WebKitUserContentManager *manager = webkit_web_view_get_user_content_manager(view);
+	webkit_user_content_manager_unregister_script_message_handler(manager, "atlJavascript", NULL);
+	WebKitUserScript *script = g_object_get_data(G_OBJECT(view), "atl-javascript-bridge");
+	if (script) webkit_user_content_manager_remove_script(manager, script);
+	g_object_set_data(G_OBJECT(view), "atl-javascript-bridge", NULL);
+}
