diff --git a/libnb-qemu/ClbbStartupTrace.h b/libnb-qemu/ClbbStartupTrace.h
new file mode 100644
index 0000000..ccb1d09
--- /dev/null
+++ b/libnb-qemu/ClbbStartupTrace.h
@@ -0,0 +1,82 @@
+/* CLBB startup diagnostics. Fixed event names and numeric library identities;
+ * never log paths, JNI arguments, Java objects or environment values. */
+#ifndef CLBB_STARTUP_TRACE_H_
+#define CLBB_STARTUP_TRACE_H_
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <unistd.h>
+#ifdef __linux__
+#include <sys/syscall.h>
+#endif
+
+inline bool clbb_startup_trace_enabled()
+{
+    const int saved_errno = errno;
+    static const bool enabled = [] {
+        const char *value = std::getenv("CLBB_STARTUP_TRACE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    errno = saved_errno;
+    return enabled;
+}
+
+inline uint64_t clbb_startup_library_id(const char *path)
+{
+    if (!clbb_startup_trace_enabled() || !path) return 0;
+    // A numeric FNV-1a label of the basename, not of an account/user directory.
+    // Used only to pair loader/JNI spans; it is not a security/checksum guard.
+    const char *base = std::strrchr(path, '/');
+    base = base ? base + 1 : path;
+    uint64_t id = UINT64_C(14695981039346656037);
+    for (const unsigned char *at = reinterpret_cast<const unsigned char *>(base); *at; ++at) {
+        id ^= *at;
+        id *= UINT64_C(1099511628211);
+    }
+    return id;
+}
+
+inline void clbb_startup_native_event(const char *event, uint64_t library_id)
+{
+    const int saved_errno = errno;
+    if (!clbb_startup_trace_enabled()) return;
+    struct timespec mono = {}, cpu = {};
+    clock_gettime(CLOCK_MONOTONIC, &mono);
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &cpu);
+#ifdef __linux__
+    long tid = syscall(SYS_gettid);
+#else
+    long tid = static_cast<long>(getpid());
+#endif
+    std::fprintf(stderr,
+                 "[CLBB startup] event=%s mono_ns=%lld cpu_ns=%lld pid=%ld tid=%ld library_id=%016llx\n",
+                 event, static_cast<long long>(mono.tv_sec) * 1000000000 + mono.tv_nsec,
+                 static_cast<long long>(cpu.tv_sec) * 1000000000 + cpu.tv_nsec,
+                 static_cast<long>(getpid()), tid, static_cast<unsigned long long>(library_id));
+    errno = saved_errno;
+}
+
+class ClbbStartupSpan {
+public:
+    ClbbStartupSpan(const char *begin, const char *end, uint64_t library_id = 0)
+        : end_(end), library_id_(library_id), active_(clbb_startup_trace_enabled())
+    {
+        if (active_) clbb_startup_native_event(begin, library_id_);
+    }
+    ~ClbbStartupSpan()
+    {
+        if (active_) clbb_startup_native_event(end_, library_id_);
+    }
+    ClbbStartupSpan(const ClbbStartupSpan&) = delete;
+    ClbbStartupSpan& operator=(const ClbbStartupSpan&) = delete;
+private:
+    const char *end_;
+    uint64_t library_id_;
+    bool active_;
+};
+
+#endif
