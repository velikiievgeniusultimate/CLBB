 LDFLAGS := -Wl,--eh-frame-hdr -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now # seems that ndk passes these, so might as well do the same
@@ -18,40 +23,71 @@ INCLUDES := -I$(shell clang -print-resource-dir)/include/ \
