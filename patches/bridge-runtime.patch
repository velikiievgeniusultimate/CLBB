+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#include "GuestCpu.h"
+#include <cstdlib>
+
+namespace {
+void require_ok(int32_t status) { if (status != 0) std::abort(); }
+}
+thread_local GuestCpu GuestCpu::local_cpu_;
+
+GuestCpu* GuestCpu::get()
+{
+    if (!local_cpu_.cpu_) {
+        require_ok(clbb_execution_acquire_v1(local_cpu_.backend_,
+                                            &local_cpu_.cpu_, &local_cpu_.owned_));
+    }
+    return &local_cpu_;
+}
+GuestCpu::GuestCpu()
+    : cpu_(nullptr), owned_(0), backend_(clbb_default_execution_backend_v1())
+{
+}
+GuestCpu::~GuestCpu()
+{
+    if (cpu_) require_ok(clbb_execution_release_v1(backend_, cpu_, owned_));
+}
+intptr_t GuestCpu::call(intptr_t addr, intptr_t a1, intptr_t a2, intptr_t a3,
+    intptr_t a4, intptr_t a5, intptr_t a6, intptr_t a7, intptr_t a8,
+    char *stack, int stack_size) const
+{
+    const ClbbExecutionCallV1 request = {addr, {a1,a2,a3,a4,a5,a6,a7,a8},
+        reinterpret_cast<uint8_t *>(stack), stack_size};
+    intptr_t result;
+    require_ok(clbb_execution_call_word_v1(backend_, cpu_, &request, &result));
+    return result;
+}
+uint64_t GuestCpu::call64(intptr_t addr, intptr_t a1, intptr_t a2, intptr_t a3,
+    intptr_t a4, intptr_t a5, intptr_t a6, intptr_t a7, intptr_t a8,
+    char *stack, int stack_size) const
+{
+    const ClbbExecutionCallV1 request = {addr, {a1,a2,a3,a4,a5,a6,a7,a8},
+        reinterpret_cast<uint8_t *>(stack), stack_size};
+    uint64_t result;
+    require_ok(clbb_execution_call_u64_v1(backend_, cpu_, &request, &result));
+    return result;
+}
diff --git a/libnb-qemu/QemuExecutionBackend.cpp b/libnb-qemu/QemuExecutionBackend.cpp
new file mode 100644
index 0000000..a70ec21
--- /dev/null
+++ b/libnb-qemu/QemuExecutionBackend.cpp
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * QEMU adapter retains the nb-qemu ABI and its ownership rules.
+ */
+#include "ExecutionBackend.h"
+#include "QemuAndroid.h"
+
+static void *acquire(uint32_t *owned)
+{
+    void *cpu = qemu_android_get_cpu();
+    *owned = cpu ? 0u : 1u;
+    return cpu ? cpu : qemu_android_new_cpu();
+}
+static intptr_t call_word(void *cpu, const ClbbExecutionCallV1 *c)
+{
+    return qemu_android_call9(cpu, c->address, c->args[0], c->args[1],
+        c->args[2], c->args[3], c->args[4], c->args[5], c->args[6], c->args[7],
+        reinterpret_cast<char *>(c->stack), c->stack_size);
+}
+static uint64_t call_u64(void *cpu, const ClbbExecutionCallV1 *c)
+{
+    return qemu_android_call9_ll(cpu, c->address, c->args[0], c->args[1],
+        c->args[2], c->args[3], c->args[4], c->args[5], c->args[6], c->args[7],
+        reinterpret_cast<char *>(c->stack), c->stack_size);
+}
+const ClbbExecutionBackendV1 *clbb_default_execution_backend_v1()
+{
+    static const ClbbExecutionBackendV1 backend = {
+        CLBB_EXECUTION_ABI_V1, sizeof(ClbbExecutionBackendV1),
+        qemu_android_initialize, qemu_android_lookup_symbol,
+        acquire, qemu_android_delete_cpu, call_word, call_u64,
+    };
+    return &backend;
+}
diff --git a/libnb-qemu/ClbbDnsWire.h b/libnb-qemu/ClbbDnsWire.h
new file mode 100644
index 0000000..f6e0733
--- /dev/null
+++ b/libnb-qemu/ClbbDnsWire.h
@@ -0,0 +1,56 @@
+#ifndef CLBB_DNS_H
+#define CLBB_DNS_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* v1 payload integers are little endian. No native pointers occur in payloads.
+ * Public C function arguments are HOST pointers, not unchecked guest pointers. */
+#define CLBB_DNS_VERSION 1u
+#define CLBB_DNS_MAX_RECORDS 64u
+#define CLBB_DNS_CANON_CAPACITY 1024u
+enum {
+    CLBB_DNS_PASSIVE = 1, CLBB_DNS_CANONNAME = 2,
+    CLBB_DNS_NUMERICHOST = 4, CLBB_DNS_NUMERICSERV = 8,
+    CLBB_DNS_ADDRCONFIG = 16, CLBB_DNS_V4MAPPED = 32, CLBB_DNS_ALL = 64
+};
+/* These are guest bionic EAI values; do not use host EAI constants. */
+enum {
+    CLBB_DNS_OK = 0, CLBB_DNS_ADDRFAMILY = 1, CLBB_DNS_AGAIN = 2, CLBB_DNS_BADFLAGS = 3,
+    CLBB_DNS_FAIL = 4, CLBB_DNS_FAMILY = 5, CLBB_DNS_MEMORY = 6,
+    CLBB_DNS_NODATA = 7, CLBB_DNS_NONAME = 8, CLBB_DNS_SERVICE = 9,
+    CLBB_DNS_SOCKTYPE = 10, CLBB_DNS_SYSTEM = 11, CLBB_DNS_BADHINTS = 12,
+    CLBB_DNS_PROTOCOL = 13, CLBB_DNS_OVERFLOW = 14
+};
+typedef struct {
+    uint32_t version, flags;
+    uint32_t family;   /* 0 unspecified, 4 IPv4, 6 IPv6 */
+    uint32_t socktype; /* 0 unspecified, 1 stream, 2 datagram */
+    uint32_t protocol; /* 0 unspecified, 6 TCP, 17 UDP */
+} clbb_dns_hints_v1;
+typedef struct {
+    uint32_t family, socktype, protocol;
+    uint16_t port; /* host order */
+    uint16_t reserved;
+    uint32_t scope_id, flowinfo;
+    uint8_t address[16]; /* network-order bytes; first 4 for IPv4 */
+} clbb_dns_record_v1;
+typedef struct {
+    uint32_t version, count, canonical_len;
+    int32_t system_errno; /* Linux/Android errno, only on EAI_SYSTEM */
+    uint8_t canonical[CLBB_DNS_CANON_CAPACITY]; /* NUL terminated */
+    clbb_dns_record_v1 records[CLBB_DNS_MAX_RECORDS];
+} clbb_dns_response_v1;
+
+/* node/service are nullable NUL-terminated strings. hints is required.
+ * response is required and reset on failure; count=0, canonical_len=0.
+ * Buffers must be aligned, non-overlapping and valid for the whole call.
+ * Success never silently truncates. No memory ownership passes to the caller.
+ * Blocking call; host OS timeout/cancellation policies apply. */
+int32_t clbb_dns_resolve_v1(const char *node, const char *service,
+    const clbb_dns_hints_v1 *hints, clbb_dns_response_v1 *response);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libnb-qemu/DnsBridge.cpp b/libnb-qemu/DnsBridge.cpp
new file mode 100644
index 0000000..1f0fa5d
--- /dev/null
+++ b/libnb-qemu/DnsBridge.cpp
@@ -0,0 +1,59 @@
+#include "DnsBridge.h"
+#include "QemuAndroid.h"
+#include "ClbbDnsWire.h"
+#include <algorithm>
+#include <cstring>
+#include <string>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+int read_string(intptr_t address, size_t limit, std::string &result) {
+    if (!address) return 0;
+    for (size_t used = 0; used <= limit;) {
+        char chunk[64];
+        // Stay in one guest page; a valid terminator can precede an unmapped page.
+        size_t length = std::min(sizeof chunk, size_t(4096 - ((address + used) & 4095)));
+        length = std::min(length, limit + 1 - used);
+        if (!length || qemu_android_read_guest(chunk, address + used, length))
+            return CLBB_DNS_SYSTEM;
+        size_t chars = strnlen(chunk, length);
+        result.append(chunk, chars);
+        if (chars < length) return 0;
+        used += length;
+    }
+    return CLBB_DNS_OVERFLOW;
+}
+}
+namespace DnsBridge {
+void handle(void *cpu_env) {
+    intptr_t node_address = qemu_android_call_arg(cpu_env, 0);
+    intptr_t service_address = qemu_android_call_arg(cpu_env, 1);
+    intptr_t hints_address = qemu_android_call_arg(cpu_env, 2);
+    intptr_t response_address = qemu_android_call_arg(cpu_env, 3);
+    clbb_dns_hints_v1 hints{};
+    clbb_dns_response_v1 response{};
+    response.version = CLBB_DNS_VERSION;
+    std::string node, service;
+    int status = CLBB_DNS_BADHINTS;
+    if (hints_address && response_address) {
+        if (qemu_android_read_guest(&hints, hints_address, sizeof hints)) {
+            response.system_errno = EFAULT;
+            status = CLBB_DNS_SYSTEM;
+        } else {
+            status = read_string(node_address, 1024, node);
+            if (!status) status = read_string(service_address, 256, service);
+            if (status == CLBB_DNS_SYSTEM) response.system_errno = EFAULT;
+            if (!status) status = clbb_dns_resolve_v1(
+                node_address ? node.c_str() : nullptr,
+                service_address ? service.c_str() : nullptr, &hints, &response);
+        }
+    }
+    if (qemu_android_write_guest(response_address, &response, sizeof response))
+        status = CLBB_DNS_SYSTEM;
+    if (getenv("NB_QEMU_TRACE_DNS"))
+        fprintf(stderr, "[CLBB DNS] node=%s service=%s status=%d records=%u errno=%d\n", node_address ? node.c_str() : "(null)", service_address ? service.c_str() : "(null)", status, response.count, response.system_errno);
+    qemu_android_call_result(cpu_env, status);
+}
+}
