+.PHONY: guest-force-flags
+$(GUEST_FLAGS_STAMP): guest-force-flags | $(BUILDDIR)
+	@printf '%s\n' 'CC=clang' 'CROSSFLAGS=$(CROSSFLAGS)' 'CFLAGS=$(CFLAGS)' 'LDFLAGS=$(LDFLAGS)' 'LDFLAGS_MAIN=$(LDFLAGS_MAIN)' 'LDLIBS=$(LDLIBS)' 'INCLUDES=$(INCLUDES)' 'DEPENDENCIES=MM-MP-v1' > "$@.tmp"
+	@cmp -s "$@.tmp" "$@" && rm -f "$@.tmp" || mv -f "$@.tmp" "$@"
+
+GUEST_LIBS := $(addprefix $(BUILDDIR)/,libnb-qemu-guest.so libandroid.so libEGL.so libGLESv1_CM.so libGLESv2.so liblog.so libOpenSLES.so libstdc++.so)
