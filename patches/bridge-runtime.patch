-$(BUILDDIR)/libOpenSLES.so: $(BUILDDIR)/libOpenSLES.c $(CURRDIR)/libOpenSLES.iid.c $(CURRDIR)/libOpenSLES.itf.c
-	clang $(CROSSFLAGS) $(LDFLAGS) $(CFLAGS) $(LDLIBS) $(INCLUDES) -o $@ $^
+$(BUILDDIR)/libOpenSLES.so: $(BUILDDIR)/libOpenSLES.c $(CURRDIR)/libOpenSLES.iid.c $(CURRDIR)/libOpenSLES.itf.c $(GUEST_FLAGS_STAMP)
+	$(call guest-dependencies,)
+	clang $(CROSSFLAGS) $(LDFLAGS) $(CFLAGS) $(LDLIBS) $(INCLUDES) -o $@ $(filter %.c,$^)
+	mv -f "$@.d.tmp" "$@.d"
 
-.PHONY: $(BUILDDIR)
+# Equivalent to libstdc++_standalone/Makefile, with the same dependency/flag contract.
+$(BUILDDIR)/libstdc++.so: $(CURRDIR)/libstdc++_standalone/new.cpp $(CURRDIR)/libstdc++_standalone/__cxa_pure_virtual.cpp $(CURRDIR)/libstdc++_standalone/__cxa_guard.cpp $(GUEST_FLAGS_STAMP)
