@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef CLBB_GUEST_CORE_H
+#define CLBB_GUEST_CORE_H
+#include "ExecutionBackend.h"
+#include <cstdlib>
+namespace GuestCore {
+inline bool initialize(const char *process, const char *temp) {
+    int32_t result;
+    if (clbb_execution_initialize_v1(clbb_default_execution_backend_v1(), process, temp, &result) != 0) std::abort();
+    return result == 0;
+}
+inline intptr_t lookup_symbol(const char *name) {
+    intptr_t result;
+    if (clbb_execution_lookup_v1(clbb_default_execution_backend_v1(), name, &result) != 0) std::abort();
+    return result;
+}
+}
+#endif
