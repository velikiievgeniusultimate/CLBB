-$(BUILDDIR)/liblog.so: $(CURRDIR)/liblog.c
-	clang $(CROSSFLAGS) $(LDFLAGS) $(CFLAGS) $(LDLIBS) $(INCLUDES) -o $@ $^
+$(BUILDDIR)/liblog.so: $(CURRDIR)/liblog.c $(GUEST_FLAGS_STAMP)
+	$(call guest-dependencies,)
