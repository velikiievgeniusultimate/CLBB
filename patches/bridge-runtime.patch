diff --git a/libnb-qemu/libGLESv2.itf.c b/libnb-qemu/libGLESv2.itf.c
new file mode 100644
index 0000000..87bd488
--- /dev/null
+++ b/libnb-qemu/libGLESv2.itf.c
@@ -0,0 +1,114 @@
+#include <EGL/egl.h>
+#include <GLES3/gl32.h>
+#include <glib.h>
+#include <string.h>
+#include "GLES_bio.h"
+
+/* Mesa's list describes the host driver. Suppress known extension families
+ * whose required entry points the ARM bridge lacks. Keep indexed and legacy
+ * queries consistent. Strings live for the lifetime of the host context/thread. */
+struct nb_extensions {
+    EGLContext context;
+    GPtrArray *names;
+    GString *joined;
+};
+static void free_extensions(void *data) {
+    struct nb_extensions *extensions = data;
+    g_ptr_array_unref(extensions->names);
+    g_string_free(extensions->joined, TRUE);
+    g_free(extensions);
+}
+static GPrivate extension_cache = G_PRIVATE_INIT(free_extensions);
+static gboolean supported_extension(const char *name) {
+    static const char *unsupported[] = {
+        "GL_ANDROID_extension_pack_es31a", "GL_KHR_debug", "GL_EXT_debug_label", "GL_EXT_debug_marker",
+        "GL_OES_texture_view", "GL_EXT_texture_view",
+        "GL_OVR_multiview", "GL_OVR_multiview2",
+        "GL_OVR_multiview_multisampled_render_to_texture", NULL
+    };
+    for (int i = 0; unsupported[i]; ++i)
+        if (!strcmp(name, unsupported[i])) return FALSE;
+    return TRUE;
+}
+static struct nb_extensions *get_extensions(void) {
+    EGLContext context = eglGetCurrentContext();
+    if (context == EGL_NO_CONTEXT) return NULL;
+    struct nb_extensions *cached = g_private_get(&extension_cache);
+    if (cached && cached->context == context) return cached;
+    struct nb_extensions *result = g_new0(struct nb_extensions, 1);
+    result->context = context;
+    result->names = g_ptr_array_new_with_free_func(g_free);
+    result->joined = g_string_new(NULL);
+    const char *raw = (const char *)glGetString(GL_EXTENSIONS);
+    gchar **names = g_strsplit(raw ? raw : "", " ", -1);
+    for (int i = 0; names[i]; ++i) {
+        if (!*names[i] || !supported_extension(names[i])) continue;
+        g_ptr_array_add(result->names, g_strdup(names[i]));
+        if (result->joined->len) g_string_append_c(result->joined, ' ');
+        g_string_append(result->joined, names[i]);
+    }
+    g_strfreev(names);
+    g_private_replace(&extension_cache, result);
+    return result;
+}
+const GLubyte *nb_glGetString(GLenum name) {
+    if (name != GL_EXTENSIONS) return glGetString(name);
+    struct nb_extensions *extensions = get_extensions();
+    return extensions ? (const GLubyte *)extensions->joined->str : glGetString(name);
+}
+const GLubyte *nb_glGetStringi(GLenum name, GLuint index) {
+    if (name != GL_EXTENSIONS) return glGetStringi(name, index);
+    struct nb_extensions *extensions = get_extensions();
+    if (!extensions || index >= extensions->names->len) return NULL;
+    return g_ptr_array_index(extensions->names, index);
+}
+void nb_glGetIntegerv(GLenum name, GLint *value) {
+    if (name == GL_NUM_EXTENSIONS) {
+        struct nb_extensions *extensions = get_extensions();
+        if (extensions) { *value = extensions->names->len; return; }
+    }
+    bionic_glGetIntegerv(name, value);
+}
+
+/* ATL's logical default framebuffer is a rotating texture-backed FBO. Its
+ * public GL_BACK/COLOR/DEPTH/STENCIL enums must name the physical attachments
+ * only while that FBO is actually bound. User FBOs and real EGL surfaces keep
+ * the driver's validation and enum semantics. */
+static gboolean is_private_default(GLenum target) {
+    GLenum binding = target == GL_READ_FRAMEBUFFER ? GL_READ_FRAMEBUFFER_BINDING : GL_DRAW_FRAMEBUFFER_BINDING;
+    GLint physical = 0, logical = 0;
+    glGetIntegerv(binding, &physical);
+    bionic_glGetIntegerv(binding, &logical);
+    return physical != 0 && logical == 0;
+}
+void nb_glReadBuffer(GLenum src) {
+    if (src == GL_BACK && is_private_default(GL_READ_FRAMEBUFFER)) src = GL_COLOR_ATTACHMENT0;
+    glReadBuffer(src);
+}
+void nb_glDrawBuffers(GLsizei n, const GLenum *bufs) {
+    if (n == 1 && bufs && bufs[0] == GL_BACK && is_private_default(GL_DRAW_FRAMEBUFFER)) {
+        const GLenum color = GL_COLOR_ATTACHMENT0;
+        glDrawBuffers(1, &color);
+    } else glDrawBuffers(n, bufs);
+}
+static const GLenum *translate_default_attachments(GLenum target, GLsizei count, const GLenum *attachments, GLenum translated[3]) {
+    if ((target != GL_FRAMEBUFFER && target != GL_DRAW_FRAMEBUFFER && target != GL_READ_FRAMEBUFFER) ||
+        count <= 0 || count > 3 || !attachments || !is_private_default(target)) return attachments;
+    for (GLsizei i = 0; i < count; ++i) {
+        switch (attachments[i]) {
+            case GL_COLOR: translated[i] = GL_COLOR_ATTACHMENT0; break;
+            case GL_DEPTH: translated[i] = GL_DEPTH_ATTACHMENT; break;
+            case GL_STENCIL: translated[i] = GL_STENCIL_ATTACHMENT; break;
+            default: translated[i] = attachments[i]; break;
+        }
+    }
+    return translated;
+}
+void nb_glInvalidateFramebuffer(GLenum target, GLsizei count, const GLenum *attachments) {
+    GLenum translated[3];
+    glInvalidateFramebuffer(target, count, translate_default_attachments(target, count, attachments, translated));
+}
+void nb_glInvalidateSubFramebuffer(GLenum target, GLsizei count, const GLenum *attachments, GLint x, GLint y, GLsizei width, GLsizei height) {
+    GLenum translated[3];
+    glInvalidateSubFramebuffer(target, count, translate_default_attachments(target, count, attachments, translated), x, y, width, height);
+}
