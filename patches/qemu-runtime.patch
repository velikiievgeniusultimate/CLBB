+#if defined(TARGET_AARCH64) && !defined(TARGET_ABI32)
+static abi_long clbb_syscall_copy_to_guest(abi_ulong target_addr,
+                                        const void *source, size_t length)
+{
+    abi_ulong last, page, last_page;
+    struct iovec local, remote;
+    ssize_t copied;
+
+    if (length == 0) {
+        return 0;
+    }
+    last = target_addr + length - 1;
+    if (length > SSIZE_MAX || last < target_addr ||
+        !guest_addr_valid(target_addr) || !guest_addr_valid(last)) {
+        return -TARGET_EFAULT;
+    }
+
+    /* Preserve tracked self-modifying-code semantics before the kernel copy.
+     * Missing/reserved descriptors are not proof that Android host mappings
+     * are inaccessible. Check each page independently: an unknown first page
+     * must not hide a tracked SMC page later in a crossing output buffer.
+     * stat only writes, so PAGE_READ must not reject a valid write-only page.
+     */
+    mmap_lock();
+    page = target_addr & TARGET_PAGE_MASK;
+    last_page = last & TARGET_PAGE_MASK;
+    for (;;) {
+        int flags = page_get_flags(page);
+
+        if ((flags & (PAGE_VALID | PAGE_WRITE_ORG)) ==
+            (PAGE_VALID | PAGE_WRITE_ORG) &&
+            page_check_range(page, 1, PAGE_WRITE) != 0) {
+            mmap_unlock();
+            return -TARGET_EFAULT;
+        }
+        if (page == last_page) {
+            break;
+        }
+        page += TARGET_PAGE_SIZE;
+    }
+
+    local.iov_base = (void *)source;
+    local.iov_len = length;
+    remote.iov_base = g2h(target_addr);
+    remote.iov_len = length;
+    copied = syscall(__NR_process_vm_writev, getpid(), &local, 1UL,
+                     &remote, 1UL, 0UL);
+    mmap_unlock();
+
+    /* A partial copy has the same EFAULT result as the kernel stat syscall;
+     * bytes copied before a boundary fault have unspecified output contents.
+     * Never fall back to memcpy if the kernel denies the safe copy.
+     */
+    return copied == (ssize_t)length ? 0 : -TARGET_EFAULT;
+}
+#endif
