+/* Optional translated-code cache budget, not guest/application data preload.
+ * Zero preserves QEMU's own default/allocation policy. Keep parsing bounded
+ * before multiplying, so arbitrarily long environment values cannot overflow.
+ */
+static unsigned long clbb_tcg_cache_bytes(void)
+{
+    const int saved_errno = errno;
+    const char *value = getenv("CLBB_TCG_CACHE_MIB");
+    unsigned long mib = 0;
+    unsigned long result = 0;
+
+    if (value && *value) {
+        const unsigned char *at = (const unsigned char *)value;
+        for (; *at; ++at) {
+            if (*at < '0' || *at > '9' || mib > 1024 / 10 ||
+                (mib == 1024 / 10 && (unsigned)(*at - '0') > 1024 % 10)) {
+                goto done;
+            }
+            mib = mib * 10 + (*at - '0');
+        }
+        if (mib >= 32 && mib <= 1024) {
+            result = mib * MiB;
+        }
+    }
+done:
+    errno = saved_errno;
+    return result;
+}
