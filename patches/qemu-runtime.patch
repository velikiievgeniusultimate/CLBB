diff --git a/linux-user/clone-signal-mask.h b/linux-user/clone-signal-mask.h
new file mode 100644
index 0000000..1e23b99
--- /dev/null
+++ b/linux-user/clone-signal-mask.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef CLBB_CLONE_SIGNAL_MASK_H
+#define CLBB_CLONE_SIGNAL_MASK_H
+
+#include <signal.h>
+
+/* A host signal handler can temporarily block every signal while the guest
+ * mask remains unchanged. A new guest thread inherits the latter, never that
+ * transient host mask. Match process_pending_signals()'s exception policy. */
+static inline void clbb_clone_signal_mask(const sigset_t *guest, sigset_t *host)
+{
+    *host = *guest;
+    sigdelset(host, SIGSEGV);
+    sigdelset(host, SIGBUS);
+}
+
+#endif
